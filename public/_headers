# Tell search engines NOT to index pages.dev URLs (only apex/www should be indexed)
# Production pages.dev hostname
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Preview deploy pages.dev hostnames (e.g. <hash>.azturfsuppliers-com.pages.dev)
https://*.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Cloudflare Pages cache headers

# HTML pages — always revalidate so updates go live immediately
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Rules below also match /* above, and Cloudflare joins duplicate headers with
# a comma ("max-age=0, must-revalidate, …, max-age=31536000"). "! Cache-Control"
# detaches the inherited value so each path sends exactly one.

# Astro build output — content-hashed filenames, safe to cache forever
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Media files (incl. PDFs and generated /media/opt/ copies) — cache for 30
# days so image swaps propagate within a month
/media/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000
