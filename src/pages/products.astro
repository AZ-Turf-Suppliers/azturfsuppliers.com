---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import { renderInline } from '../utils/inline-markdown';
import page from '../data/pages/products.json';

const btnClass = (style: string) => {
  if (style === 'primary') return 'btn btn-primary';
  if (style === 'dark') return 'btn btn-dark';
  return 'btn btn-outline';
};
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
>
<style is:global>
.page-hero::before { background-image: url("/media/turf-natural-stone-hero-5.jpg") !important; }
.products-grid-section { padding: 88px 0; background: var(--white); }
.products-categories { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 48px; }
.product-cat-card {
  background: var(--gray-100); border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg); overflow: hidden;
  display: flex; flex-direction: column;
  transition: transform 0.3s, box-shadow 0.3s;
  text-decoration: none; color: inherit;
}
.product-cat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); background: var(--white); }
.product-cat-img { aspect-ratio: 16/9; background: var(--gray-200); overflow: hidden; }
.product-cat-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.product-cat-card:hover .product-cat-img img { transform: scale(1.04); }
.product-cat-body { padding: 28px 28px 24px; display: flex; flex-direction: column; flex: 1; gap: 10px; }
.product-cat-eyebrow {
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--green-700);
}
.product-cat-body h3 { font-size: 1.3rem; margin: 0; letter-spacing: 0.01em; }
.product-cat-body p {
  font-size: 0.9rem; color: var(--gray-600); line-height: 1.65;
  font-weight: 400; text-transform: none; letter-spacing: 0; margin: 0;
}
.product-cat-link {
  margin-top: auto; padding-top: 8px;
  font-size: 0.78rem; font-weight: 700; color: var(--green-700);
  text-transform: uppercase; letter-spacing: 0.08em;
}
.product-cat-card:hover .product-cat-link { text-decoration: underline; }
@media (max-width: 768px) {
  .products-categories { grid-template-columns: 1fr; gap: 20px; }
  .products-grid-section { padding: 30px 0; }
  .product-cat-body { padding: 24px 22px 20px; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{page.hero.eyebrow}</div>
      <h1 set:html={renderInline(page.hero.heading)} />
      <p>{page.hero.body}</p>
      <div class="page-hero-btns">
        <a href={page.hero.ctaPrimary.link} class="btn btn-primary">{page.hero.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
        <a href={page.hero.ctaSecondary.link} class="btn btn-outline">{page.hero.ctaSecondary.text}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PRODUCT CATEGORIES ═══ -->
<section class="products-grid-section">
  <div class="container">
    <div class="section-header centered" data-reveal>
      <div class="section-label centered">{page.categories.label}</div>
      <h2 set:html={renderInline(page.categories.heading)} />
      <p set:html={renderInline(page.categories.body)} />
    </div>
    <div class="products-categories">
      {page.categories.items.map((cat) => (
        <a href={cat.link} class="product-cat-card" data-reveal>
          <div class="product-cat-img">
            <Pic name={cat.image} alt={cat.imageAlt} />
          </div>
          <div class="product-cat-body">
            <span class="product-cat-eyebrow">{cat.eyebrow}</span>
            <h3 set:html={renderInline(cat.heading)} />
            <p set:html={renderInline(cat.body)} />
            <span class="product-cat-link">{cat.linkText}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">{page.cta.label}</div>
    <h2 set:html={renderInline(page.cta.heading)} />
    <p set:html={renderInline(page.cta.body)} />
    <div class="cta-btns">
      {page.cta.buttons.map((btn) => (
        <a href={btn.link} class={btnClass(btn.style)}>
          {btn.text}
          {btn.style === 'primary' && (
            <Icon name="phone" size={16} />
          )}
        </a>
      ))}
    </div>
  </div>
</section>
</Layout>
