---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Products | AZ Turf Suppliers — Queen Creek, AZ"
  description="Browse the full AZ Turf Suppliers catalog: artificial turf, pavers, natural stone, landscape lighting, and turf installation accessories. Stocked at our Queen Creek showroom."
>
<style is:global>
.products-grid-section {
  padding: 88px 0;
  background: var(--white);
}
.products-categories {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-top: 48px;
}
.product-cat-card {
  background: var(--gray-100);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.3s, box-shadow 0.3s;
  text-decoration: none;
  color: inherit;
}
.product-cat-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  background: var(--white);
}
.product-cat-img {
  aspect-ratio: 16/9;
  background: var(--gray-200);
  overflow: hidden;
}
.product-cat-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}
.product-cat-card:hover .product-cat-img img {
  transform: scale(1.04);
}
.product-cat-body {
  padding: 28px 28px 24px;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 10px;
}
.product-cat-eyebrow {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--green-700);
}
.product-cat-body h3 {
  font-size: 1.3rem;
  margin: 0;
  letter-spacing: 0.01em;
}
.product-cat-body p {
  font-size: 0.9rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  margin: 0;
}
.product-cat-link {
  margin-top: auto;
  padding-top: 8px;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--green-700);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.product-cat-card:hover .product-cat-link { text-decoration: underline; }

@media (max-width: 768px) {
  .products-categories { grid-template-columns: 1fr; gap: 20px; }
  .products-grid-section { padding: 56px 0; }
  .product-cat-body { padding: 24px 22px 20px; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Our Catalog</div>
      <h1>Everything You Need <em>In One Place</em></h1>
      <p>Artificial turf, pavers, natural stone, landscape lighting, and installation accessories — all stocked at our Queen Creek showroom for same-day pickup or next-day delivery.</p>
      <div class="page-hero-btns">
        <a href="/contact" class="btn btn-primary">Get a Quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="tel:4807393854" class="btn btn-outline">Call 480-739-3854</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PRODUCT CATEGORIES ═══ -->
<section class="products-grid-section">
  <div class="container">
    <div class="section-header centered" data-reveal>
      <div class="section-label centered">What We Carry</div>
      <h2>Browse by Category</h2>
      <p>Click into any category for full product details, specs, and pricing.</p>
    </div>
    <div class="products-categories">

      <a href="/artificial-turf" class="product-cat-card" data-reveal>
        <div class="product-cat-img">
          <img src="/media/natural-series-turf.png" alt="Artificial Turf">
        </div>
        <div class="product-cat-body">
          <span class="product-cat-eyebrow">Artificial Turf</span>
          <h3>Premium Synthetic Grass</h3>
          <p>Eight blends from low-traffic landscape accents to high-performance putting greens. UV-stable, pet-friendly, lead-free, and built for Arizona heat.</p>
          <span class="product-cat-link">View Turf Options →</span>
        </div>
      </a>

      <a href="/pavers" class="product-cat-card" data-reveal>
        <div class="product-cat-img">
          <img src="/media/stone.jpg" alt="Pavers">
        </div>
        <div class="product-cat-body">
          <span class="product-cat-eyebrow">Pavers</span>
          <h3>Concrete &amp; Travertine Pavers</h3>
          <p>Patios, driveways, pool decks, and walkways. Wide selection of finishes and colors stocked for same-day pickup.</p>
          <span class="product-cat-link">View Pavers →</span>
        </div>
      </a>

      <a href="/natural-stone" class="product-cat-card" data-reveal>
        <div class="product-cat-img">
          <img src="/media/Tuscany Ivory.png" alt="Natural Stone">
        </div>
        <div class="product-cat-body">
          <span class="product-cat-eyebrow">Natural Stone</span>
          <h3>Travertine, Limestone &amp; Marble</h3>
          <p>Multiple finishes for upscale pool decks, patios, and feature walls. See and feel the material in person at our showroom.</p>
          <span class="product-cat-link">View Natural Stone →</span>
        </div>
      </a>

      <a href="/landscape-lighting" class="product-cat-card" data-reveal>
        <div class="product-cat-img">
          <img src="/media/LT2401A.png" alt="Landscape Lighting">
        </div>
        <div class="product-cat-body">
          <span class="product-cat-eyebrow">Landscape Lighting</span>
          <h3>Professional Lumenex Systems</h3>
          <p>Low-voltage path lights, spotlights, hardscape lights, transformers, and accessories — built to last in Arizona's UV and heat.</p>
          <span class="product-cat-link">View Lighting →</span>
        </div>
      </a>

      <a href="/accessories" class="product-cat-card" data-reveal>
        <div class="product-cat-img">
          <img src="/media/9409B.jpg" alt="Installation Accessories">
        </div>
        <div class="product-cat-body">
          <span class="product-cat-eyebrow">Accessories</span>
          <h3>Installation Supplies</h3>
          <p>Nails, seam tape, infill, base aggregate, edging, and the consumables you need to finish the job right.</p>
          <span class="product-cat-link">View Accessories →</span>
        </div>
      </a>

    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">Visit Us</div>
    <h2>Not Sure Where to Start?</h2>
    <p>Stop by our Queen Creek showroom and our team will help you pick the right materials for your project, your budget, and your timeline.</p>
    <div class="cta-btns">
      <a href="tel:4807393854" class="btn btn-primary">Call 480-739-3854 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91A16 16 0 0 0 14 15.82l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></a>
      <a href="/contact" class="btn btn-outline">Send Us a Message</a>
    </div>
  </div>
</section>
</Layout>
