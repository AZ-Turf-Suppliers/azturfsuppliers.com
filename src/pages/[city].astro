---
import Layout from '../layouts/Layout.astro';
import { renderInline } from '../utils/inline-markdown';

// Dynamic route: one rendered page per JSON file in src/data/locations/.
// Filename = URL slug. To add a new city, the CMS creates a new JSON file
// here through the "Location Pages" collection — no .astro edits needed.
const cityModules = import.meta.glob('../data/locations/*.json', { eager: true });

export async function getStaticPaths() {
  const modules = import.meta.glob('../data/locations/*.json', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace(/\.json$/, '');
    return { params: { city: slug }, props: { page: (mod as any).default ?? mod } };
  });
}

interface Props { page: any; }
const { page } = Astro.props;
const { city } = Astro.params;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Areas Served', url: '/locations' },
  { name: page.name, url: `/${city}` },
];

const btnClass = (style: string) => {
  if (style === 'primary') return 'btn btn-primary';
  if (style === 'dark') return 'btn btn-dark';
  return 'btn btn-outline';
};
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  ogImage={page.meta.ogImage}
  breadcrumbs={breadcrumbs}
>
<style is:global set:html={`.page-hero::before { background-image: url("${page.heroImage}") !important; }`} />
<style is:global>
.city-hero-eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green-700); margin-bottom: 12px; }
.city-products { padding: 88px 0; background: var(--white); }
.city-products-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 48px; }
.city-product-card { background: var(--gray-100); border-radius: var(--radius-lg); padding: 28px 24px; border: 1px solid var(--gray-200); transition: all 0.3s; }
.city-product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); background: var(--white); }
.city-product-card h3 { font-size: 1rem; margin-bottom: 8px; letter-spacing: 0.02em; }
.city-product-card p { font-size: 0.85rem; color: var(--gray-600); line-height: 1.6; font-weight: 400; text-transform: none; letter-spacing: 0; margin-bottom: 16px; }
.city-product-card a { font-size: 0.8rem; font-weight: 700; color: var(--green-700); text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none; }
.city-product-card a:hover { text-decoration: underline; }
.city-why { padding: 88px 0; background: var(--dark); }
.city-why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; }
.city-why-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); padding: 32px 28px; }
.city-why-card h3 { font-size: 1rem; color: var(--white); margin-bottom: 10px; letter-spacing: 0.02em; }
.city-why-card p { font-size: 0.85rem; color: rgba(255,255,255,0.6); line-height: 1.65; font-weight: 400; text-transform: none; letter-spacing: 0; }
.city-cta { padding: 88px 0; background: var(--gray-100); text-align: center; }
.city-cta h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); margin-bottom: 16px; }
.city-cta p { font-size: 0.95rem; color: var(--gray-600); max-width: 560px; margin: 0 auto 32px; line-height: 1.75; font-weight: 400; text-transform: none; letter-spacing: 0; }
.city-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.city-nearby { padding: 56px 0; background: var(--white); }
.city-nearby p { font-size: 0.85rem; color: var(--gray-500); text-align: center; }
.city-nearby a { color: var(--green-700); text-decoration: none; font-weight: 600; }
.city-nearby a:hover { text-decoration: underline; }
@media (max-width: 768px) {
  .city-products-grid { grid-template-columns: 1fr 1fr; }
  .city-why-grid { grid-template-columns: 1fr; }
  .city-products, .city-why, .city-cta { padding: 30px 0; }
}
@media (max-width: 480px) {
  .city-products-grid { grid-template-columns: 1fr; }
}
</style>

<!-- ═══ HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{page.hero.eyebrow}</div>
      <h1 set:html={renderInline(page.hero.heading)} />
      <p>{page.hero.body}</p>
      <div class="page-hero-btns">
        <a href={page.hero.ctaPrimary.link} class="btn btn-primary">{page.hero.ctaPrimary.text} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href={page.hero.ctaSecondary.link} class="btn btn-outline">{page.hero.ctaSecondary.text}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    {page.statBar.map((item: any) => (
      <div class="stat-item">
        <div class="stat-num">{item.value}</div>
        <div class="stat-label">{item.label}</div>
      </div>
    ))}
  </div>
</div>

<!-- ═══ PRODUCTS ═══ -->
<section class="city-products">
  <div class="container">
    <div class="section-header" data-reveal>
      <div class="section-label">{page.products.label}</div>
      <h2 set:html={renderInline(page.products.heading)} />
      <p set:html={renderInline(page.products.body)} />
    </div>
    <div class="city-products-grid">
      {page.products.cards.map((card: any) => (
        <div class="city-product-card" data-reveal>
          <h3>{card.heading}</h3>
          <p set:html={renderInline(card.body)} />
          <a href={card.link}>{card.linkText}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ WHY ═══ -->
<section class="city-why">
  <div class="container">
    <div class="section-header centered" data-reveal>
      <div class="section-label inverted centered">{page.why.label}</div>
      <h2 style="color:var(--white);" set:html={renderInline(page.why.heading)} />
    </div>
    <div class="city-why-grid">
      {page.why.cards.map((card: any) => (
        <div class="city-why-card" data-reveal>
          <h3>{card.heading}</h3>
          <p set:html={renderInline(card.body)} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="city-cta">
  <div class="container" data-reveal>
    <div class="section-label centered">{page.cta.label}</div>
    <h2 set:html={renderInline(page.cta.heading)} />
    <p set:html={renderInline(page.cta.body)} />
    <div class="city-cta-btns">
      {page.cta.buttons.map((btn: any) => (
        <a
          href={btn.link}
          class={btnClass(btn.style)}
          target={btn.newTab ? '_blank' : undefined}
          rel={btn.newTab ? 'noopener' : undefined}
        >
          {btn.text}
          {btn.style === 'primary' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══ NEARBY ═══ -->
<section class="city-nearby">
  <div class="container">
    <p>
      {page.nearby.prefix}{' '}
      {page.nearby.links.map((link: any, i: number) => (
        <>
          {i > 0 && ' · '}
          <a href={link.link}>{link.name}</a>
        </>
      ))}
    </p>
  </div>
</section>

</Layout>
