---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Resources | AZ Turf Suppliers — Queen Creek, AZ"
  description="Tools and reference pages for AZ Turf Suppliers customers: turf calculator, installation blog, warranty information, and our lead-free guarantee."
>
<style is:global>
.page-hero::before { background-image: url("/media/turf-hero-8.jpg") !important; }
.resources-section {
  padding: 88px 0;
  background: var(--white);
}
.resources-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  margin-top: 48px;
}
.resource-card {
  background: var(--gray-100);
  border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg);
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: transform 0.3s, box-shadow 0.3s, background 0.3s;
  text-decoration: none;
  color: inherit;
}
.resource-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  background: var(--white);
}
.resource-card-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-100);
}
.resource-card-icon svg { width: 26px; height: 26px; color: var(--green-700); }
.resource-card h3 {
  font-size: 1.15rem;
  margin: 4px 0 0;
  letter-spacing: 0.02em;
}
.resource-card p {
  font-size: 0.9rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  flex: 1;
}
.resource-card-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--green-700);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 4px;
  transition: gap 0.2s;
}
.resource-card:hover .resource-card-link { gap: 10px; }
.resource-card-link svg { width: 14px; height: 14px; }

@media (max-width: 768px) {
  .resources-grid { grid-template-columns: 1fr; gap: 16px; }
  .resource-card { padding: 24px 20px; }
  .resources-section { padding: 30px 0; }
}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Tools &amp; References</div>
      <h1>Resources for Your <em>Project</em></h1>
      <p>Plan, install, and protect your investment with AZ Turf Suppliers' free tools, installation guides, warranty docs, and lead-free guarantee.</p>
      <div class="page-hero-btns">
        <a href="/turf-calculator" class="btn btn-primary">Try The Calculator <Icon name="arrow-right" size={16} /></a>
        <a href="/contact" class="btn btn-outline">Ask A Question</a>
      </div>
    </div>
  </div>
</section>

<section class="resources-section">
  <div class="container">
    <div class="section-header centered">
      <div class="section-label centered">All Resources</div>
      <h2>Everything You Need In One Place</h2>
      <p>From estimating square footage to understanding what's covered under warranty.</p>
    </div>
    <div class="resources-grid">
      <a href="/turf-calculator" class="resource-card" data-reveal>
        <div class="resource-card-icon">
          <Icon name="calculator" size={16} />
        </div>
        <h3>Turf Calculator</h3>
        <p>Estimate square footage, infill, and accessories needed for your install — accurate to within 5%.</p>
        <span class="resource-card-link">Open Calculator <Icon name="arrow-right" size={16} /></span>
      </a>
      <a href="/blog" class="resource-card" data-reveal>
        <div class="resource-card-icon">
          <Icon name="document" size={16} />
        </div>
        <h3>Installation Blog</h3>
        <p>Step-by-step guides written for Arizona heat — base prep, drainage, infill rates, seam techniques, and common DIY mistakes.</p>
        <span class="resource-card-link">Read Articles <Icon name="arrow-right" size={16} /></span>
      </a>
      <a href="/warranty" class="resource-card" data-reveal>
        <div class="resource-card-icon">
          <Icon name="shield" size={16} />
        </div>
        <h3>15-Year Warranty</h3>
        <p>What's covered, how claims work, and an example certificate — every roll we sell carries a manufacturer warranty.</p>
        <span class="resource-card-link">View Warranty <Icon name="arrow-right" size={16} /></span>
      </a>
      <a href="/lead-free" class="resource-card" data-reveal>
        <div class="resource-card-icon">
          <Icon name="heart" size={16} />
        </div>
        <h3>Lead-Free Guarantee</h3>
        <p>Every blend we stock is independently tested and certified lead-free — safe for kids and pets.</p>
        <span class="resource-card-link">See Certification <Icon name="arrow-right" size={16} /></span>
      </a>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered orange">Need Help?</div>
    <h2>Talk to a Real Person</h2>
    <p>Have a question we didn't answer? Call or text us — same-day response, no hold music.</p>
    <div class="cta-btns">
      <a href="tel:4807931800" class="btn btn-primary">Call or Text (480) 793-1800 <Icon name="phone" size={16} /></a>
      <a href="/contact" class="btn btn-outline">Contact Us</a>
    </div>
  </div>
</section>

</Layout>
