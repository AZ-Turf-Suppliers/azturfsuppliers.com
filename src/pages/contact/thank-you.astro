---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout title="Thank You | AZ Turf Suppliers — Queen Creek, AZ" description="Thank you for contacting AZ Turf Suppliers. We'll be in touch same day." noindex>
<style is:global>
.thank-you-section {
  padding: 100px 0 120px;
  background: var(--gray-100);
  min-height: 60vh;
  display: flex;
  align-items: center;
}
.thank-you-card {
  max-width: 600px;
  margin: 0 auto;
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(0,0,0,0.04);
  text-align: center;
}
.thank-you-card-header {
  background: var(--green-700);
  padding: 48px 40px 36px;
}
.thank-you-icon {
  width: 72px;
  height: 72px;
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}
.thank-you-icon svg {
  width: 38px;
  height: 38px;
  color: var(--white);
  stroke-width: 2.5;
}
.thank-you-card-header h1 {
  font-size: clamp(1.6rem, 3vw, 2.1rem);
  color: var(--white);
  margin-bottom: 10px;
}
.thank-you-card-header p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.75);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.6;
  max-width: 420px;
  margin: 0 auto;
}
.thank-you-card-body {
  padding: 40px 40px 44px;
}
.what-next {
  margin-bottom: 36px;
}
.what-next-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gray-400);
  margin-bottom: 20px;
}
.what-next-steps {
  display: flex;
  flex-direction: column;
  gap: 16px;
  text-align: left;
}
.next-step {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 20px;
  background: var(--gray-100);
  border-radius: var(--radius);
}
.next-step-icon {
  width: 38px;
  height: 38px;
  background: var(--white);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-sm);
}
.next-step-icon svg {
  width: 20px;
  height: 20px;
  color: var(--green-700);
}
.next-step-text h4 {
  font-size: 0.85rem;
  color: var(--dark);
  margin-bottom: 2px;
  letter-spacing: 0.02em;
}
.next-step-text p {
  font-size: 0.78rem;
  color: var(--gray-600);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.45;
}
.thank-you-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}
.thank-you-actions .btn {
  flex: 1;
  min-width: 160px;
  justify-content: center;
}
@media (max-width: 600px) {
  .thank-you-card-header { padding: 36px 24px 28px; }
  .thank-you-card-body { padding: 28px 24px 32px; }
  .thank-you-actions .btn { flex: 1 1 100%; }
}
</style>

<section class="thank-you-section">
  <div class="container">
    <div class="thank-you-card">
      <div class="thank-you-card-header">
        <div class="thank-you-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h1>Message Received!</h1>
        <p>Thanks for reaching out. We read every message and respond same day — usually within a few hours.</p>
      </div>
      <div class="thank-you-card-body">
        <div class="what-next">
          <div class="what-next-label">What Happens Next</div>
          <div class="what-next-steps">
            <div class="next-step">
              <div class="next-step-icon">
                <Icon name="phone" size={16} />
              </div>
              <div class="next-step-text">
                <h4>We'll Call or Text You</h4>
                <p>Our team will reach out same day to discuss your project and answer any questions.</p>
              </div>
            </div>
            <div class="next-step">
              <div class="next-step-icon">
                <Icon name="document" size={16} />
              </div>
              <div class="next-step-text">
                <h4>Get a Custom Quote</h4>
                <p>We'll put together pricing based on your square footage, product selection, and delivery needs.</p>
              </div>
            </div>
            <div class="next-step">
              <div class="next-step-icon">
                <Icon name="truck" size={16} />
              </div>
              <div class="next-step-text">
                <h4>Next-Day Delivery Available</h4>
                <p>Once you're ready, we can have your order delivered to your home or job site next day.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="thank-you-actions">
          <a href="tel:4807931800" class="btn btn-primary">
            Call Us Now
            <Icon name="phone" size={16} />
          </a>
          <a href="/products/" class="btn btn-outline">Browse Products</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Conversion signals. Both forms redirect here on success — the contact
  // page plainly, the homepage form with ?f=home.
  //
  // The published GTM container fires its GA4 event and Google Ads
  // conversion on one trigger: GTM's own form-submit signal on a page whose
  // URL contains /contact. The contact page meets that by accident when the
  // button is clicked. The homepage form never could — its URL is / — so
  // its leads have never counted. This page's URL meets the condition, so
  // for a homepage-origin arrival we replay the form-submit signal here, once,
  // after the server has actually accepted the lead. Nothing in the container
  // had to change. (Contact-page arrivals are NOT replayed: GTM's native
  // listener already fired for them on the click.)
  //
  // We also push generate_lead — a cleaner signal carrying the form name,
  // originating page and first-touch attribution — for anything wired to it.
  (function () {
    var fromHome = new URLSearchParams(window.location.search).get('f') === 'home';
    var MAX_AGE_MS = 90 * 24 * 60 * 60 * 1000;
    var attribution = {};
    try {
      var stored = JSON.parse(localStorage.getItem('az_attribution') || 'null');
      // Skip a record that has aged out of the first-touch window, so GA4 never
      // gets credited with a click older than the window we attribute on.
      if (stored && stored.capturedAt && (Date.now() - stored.capturedAt) >= MAX_AGE_MS) stored = null;
      if (stored) {
        if (stored.utmcsr)   attribution.utmcsr   = stored.utmcsr;
        if (stored.utmcmd)   attribution.utmcmd   = stored.utmcmd;
        if (stored.utmccn)   attribution.utmccn   = stored.utmccn;
        if (stored.utmctr)   attribution.utmctr   = stored.utmctr;
        if (stored.utmgclid) attribution.utmgclid = stored.utmgclid;
      }
    } catch (e) {}

    window.dataLayer = window.dataLayer || [];

    if (fromHome) {
      // Same shape GTM's listener pushes. A detached form stands in for the
      // one that was submitted, so Form ID / Form Element variables resolve.
      var form = document.createElement('form');
      form.id = 'home-contact-form';
      window.dataLayer.push({
        event: 'gtm.formSubmit',
        'gtm.element': form,
        'gtm.elementId': 'home-contact-form',
        'gtm.elementClasses': '',
        'gtm.elementTarget': '',
        'gtm.elementUrl': '',
      });
      // Fire once per submission: drop ?f=home so a reload or bookmark of
      // this page doesn't count the same lead again.
      try { history.replaceState(null, '', window.location.pathname); } catch (e) {}
    }

    window.dataLayer.push(Object.assign({
      event: 'generate_lead',
      form_name: fromHome ? 'home_form' : 'contact_form',
      page_path: fromHome ? '/' : '/contact/',
    }, attribution));
  })();
</script>
</Layout>
