---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import overridesData from '../data/gallery.json';

const VALID_CATS = new Set(['turf', 'putting', 'stone', 'pavers']);

const CATEGORY_LABELS: Record<string, string> = {
  turf: 'Artificial Turf',
  putting: 'Putting Green',
  stone: 'Natural Stone',
  pavers: 'Pavers',
};

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

interface Override { title?: string; location?: string; }
const overrides = overridesData.overrides as Record<string, Override>;

interface GalleryItem {
  src: ImageMetadata;
  filename: string;
  title: string;
  location: string;
  categories: string[];
}

const items: GalleryItem[] = Object.entries(imageModules)
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!;
    const [prefix] = filename.split('--');
    const categories = prefix.split('-').filter(p => VALID_CATS.has(p));
    const ov = overrides[filename] ?? {};
    return {
      src: mod.default,
      filename,
      title: ov.title ?? '',
      location: ov.location ?? '',
      categories,
    };
  })
  .sort((a, b) => a.filename.localeCompare(b.filename));

const labelFor = (cat: string) => CATEGORY_LABELS[cat] ?? cat;
---

<Layout
  title="Project Gallery | AZ Turf Suppliers — Queen Creek, AZ"
  description="Real artificial turf, paver, and hardscape installs across Arizona — backyards, putting greens, commercial properties, and more. Photos from AZ Turf Suppliers customers."
>
<style is:global>
.page-hero::before { background-image: url("/media/turf-hero-9.jpg") !important; }
/* ─── GALLERY SECTION ─── */
.gallery-section {
  padding: 88px 0;
  background: var(--gray-100);
}

/* Filter tabs */
.gallery-filters {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 48px;
}
.gallery-filter {
  padding: 10px 22px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 2px solid var(--gray-200);
  border-radius: 50px;
  background: var(--white);
  color: var(--gray-600);
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.gallery-filter:hover {
  border-color: var(--gray-400);
  color: var(--dark);
}
.gallery-filter.active {
  background: var(--dark);
  border-color: var(--dark);
  color: var(--white);
}

/* Square grid */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.gallery-item {
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  cursor: pointer;
  display: block;
  aspect-ratio: 1 / 1;
  background: var(--gray-200);
}
.gallery-item img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.gallery-item:hover img {
  transform: scale(1.04);
}
.gallery-item-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 50%);
  opacity: 0;
  transition: opacity 0.3s;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24px;
}
.gallery-item:hover .gallery-item-overlay {
  opacity: 1;
}
.gallery-item-overlay h4 {
  font-size: 0.9rem;
  color: var(--white);
  margin-bottom: 4px;
  text-transform: none;
  letter-spacing: 0;
}
.gallery-item-overlay span {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.7);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* Empty state */
.gallery-empty {
  text-align: center;
  padding: 80px 20px;
  color: var(--gray-400);
  font-size: 0.95rem;
}

/* Lightbox */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.92);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 40px;
  cursor: zoom-out;
}
.lightbox.open { display: flex; }
.lightbox img {
  max-width: 90%;
  max-height: 85vh;
  border-radius: var(--radius-lg);
  object-fit: contain;
}
.lightbox-close,
.lightbox-nav {
  position: absolute;
  width: 44px;
  height: 44px;
  background: rgba(255,255,255,0.1);
  border: none;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
  color: var(--white);
}
.lightbox-close { top: 24px; right: 24px; }
.lightbox-nav { top: 50%; transform: translateY(-50%); }
.lightbox-prev { left: 24px; }
.lightbox-next { right: 24px; }
.lightbox-close:hover,
.lightbox-nav:hover { background: rgba(255,255,255,0.2); }
.lightbox-close svg,
.lightbox-nav svg { width: 20px; height: 20px; color: var(--white); }
.lightbox-nav svg { width: 24px; height: 24px; }
@media (max-width: 480px) {
  .lightbox-prev { left: 12px; }
  .lightbox-next { right: 12px; }
}
.lightbox-caption {
  position: absolute;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  white-space: nowrap;
}
.lightbox-caption h4 {
  font-size: 1rem;
  color: var(--white);
  text-transform: none;
  letter-spacing: 0;
  margin-bottom: 4px;
}
.lightbox-caption span {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.5);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* Responsive */
@media (max-width: 768px) {
  .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .gallery-section { padding: 30px 0; }
}
@media (max-width: 480px) {
  .gallery-grid { grid-template-columns: 1fr; }
  .gallery-filters { gap: 6px; }
  .gallery-filter { padding: 8px 16px; font-size: 0.72rem; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Our Work</div>
      <h1>Project <em>Gallery</em></h1>
      <p>Real projects, real results. See how AZ Turf Suppliers products transform outdoor spaces across the East Valley.</p>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    <div class="stat-item">
      <div class="stat-num">500<span>+</span></div>
      <div class="stat-label">Projects Completed</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">5.0</div>
      <div class="stat-label">Google Rating</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">15<span>yr</span></div>
      <div class="stat-label">Warranty</div>
    </div>
  </div>
</div>

<!-- ═══ GALLERY ═══ -->
<section class="gallery-section">
  <div class="container">

    <!-- Filters -->
    <div class="gallery-filters">
      <button class="gallery-filter active" data-filter="all">All Projects</button>
      <button class="gallery-filter" data-filter="turf">Artificial Turf</button>
      <button class="gallery-filter" data-filter="putting">Putting Greens</button>
      <button class="gallery-filter" data-filter="stone">Natural Stone</button>
      <button class="gallery-filter" data-filter="pavers">Pavers</button>
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid" id="gallery-grid">
      {items.length === 0 ? (
        <div class="gallery-empty">Photos coming soon.</div>
      ) : (
        items.map(item => (
          <div
            class="gallery-item"
            data-categories={item.categories.join(' ')}
            data-title={item.title}
            data-location={item.location}
            data-reveal
          >
            <Image
              src={item.src}
              alt={item.title || item.categories.map(labelFor).join(' & ')}
              loading="lazy"
              width={900}
            />
            {(item.title || item.location) && (
              <div class="gallery-item-overlay">
                {item.title && <h4>{item.title}</h4>}
                <span>
                  {item.categories.map(labelFor).join(' & ')}
                  {item.location && ` · ${item.location}`}
                </span>
              </div>
            )}
          </div>
        ))
      )}
    </div>

  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">Start Your Project</div>
    <h2>Ready to Transform Your Outdoor Space?</h2>
    <p>Whether you're a contractor or a homeowner, we'll help you plan, source, and deliver everything you need. Let's make it happen.</p>
    <div class="cta-btns">
      <a href="/contact" class="btn btn-primary">Get a Free Quote <Icon name="arrow-right" size={16} /></a>
      <a href="/artificial-turf" class="btn btn-outline">Browse Products</a>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lightbox-close" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next image">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
  <img src="" alt="" id="lightbox-img"  loading="lazy" decoding="async"/>
  <div class="lightbox-caption" id="lightbox-caption">
    <h4 id="lightbox-title"></h4>
    <span id="lightbox-location"></span>
  </div>
</div>

<script>
// ─── MODULE-LEVEL STATE (persists across navigations) ───
let allItems: HTMLElement[] = [];
let currentList: HTMLElement[] = [];
let currentIndex = 0;
let _lightbox: HTMLElement | null = null;
let _lightboxImg: HTMLImageElement | null = null;
let _lightboxTitle: HTMLElement | null = null;
let _lightboxLocation: HTMLElement | null = null;
let _lightboxCaption: HTMLElement | null = null;

function visibleItems(): HTMLElement[] {
  return allItems.filter(el => el.style.display !== 'none');
}

function showItem(item: HTMLElement) {
  const img = item.querySelector('img');
  if (!img || !_lightboxImg || !_lightboxTitle || !_lightboxLocation || !_lightboxCaption) return;
  _lightboxImg.src = img.src;
  _lightboxImg.alt = img.alt;
  const title = item.getAttribute('data-title') || '';
  const location = item.getAttribute('data-location') || '';
  _lightboxTitle.textContent = title;
  _lightboxLocation.textContent = location;
  _lightboxCaption.style.display = (title || location) ? '' : 'none';
}

function step(delta: number) {
  if (currentList.length === 0) return;
  currentIndex = (currentIndex + delta + currentList.length) % currentList.length;
  showItem(currentList[currentIndex]);
}

function closeLightbox() {
  _lightbox?.classList.remove('open');
  document.body.style.overflow = '';
}

function initGallery() {
  _lightbox = document.getElementById('lightbox');
  _lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  _lightboxTitle = document.getElementById('lightbox-title');
  _lightboxLocation = document.getElementById('lightbox-location');
  _lightboxCaption = document.getElementById('lightbox-caption');

  if (!_lightbox) return; // not on gallery page

  const filters = document.querySelectorAll('.gallery-filter');
  const filterItems = document.querySelectorAll<HTMLElement>('.gallery-item');
  allItems = Array.from(filterItems);

  filters.forEach(btn => {
    btn.addEventListener('click', () => {
      filters.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.getAttribute('data-filter');
      filterItems.forEach(item => {
        const cats = (item.getAttribute('data-categories') || '').split(' ').filter(Boolean);
        item.style.display = (cat === 'all' || cats.includes(cat!)) ? '' : 'none';
      });
    });
  });

  allItems.forEach(item => {
    item.addEventListener('click', () => {
      currentList = visibleItems();
      currentIndex = currentList.indexOf(item);
      if (currentIndex === -1) return;
      showItem(item);
      _lightbox!.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  document.getElementById('lightbox-prev')?.addEventListener('click', e => { e.stopPropagation(); step(-1); });
  document.getElementById('lightbox-next')?.addEventListener('click', e => { e.stopPropagation(); step(1); });
  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  _lightbox.addEventListener('click', e => { if (e.target === _lightbox) closeLightbox(); });
}

initGallery();
document.addEventListener('astro:page-load', initGallery);

// Document keydown registered once; uses module-level _lightbox reference
document.addEventListener('keydown', e => {
  if (!_lightbox?.classList.contains('open')) return;
  if (e.key === 'Escape') closeLightbox();
  else if (e.key === 'ArrowLeft') step(-1);
  else if (e.key === 'ArrowRight') step(1);
});
</script>
</Layout>
