            {page.transformers.bullets.map((bullet) => (
              <div class="transformers-item">
                <Icon name="check" size={16} />
                <p set:html={renderInline(bullet)} />
              </div>
            ))}
          </div>
          <p set:html={renderInline(page.transformers.bodyFooter)} />
          <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:20px;">
            <a href={page.transformers.cta.link} class="btn btn-primary">{page.transformers.cta.text} <Icon name="arrow-right" size={16} /></a>
          </div>
        </div>
      </div>
      <div class="transformers-img" data-reveal>
        <img src="/media/lighting-outdoor-2.webp" alt="Professional landscape lighting installation" loading="lazy" decoding="async"/>
      </div>
    </div>
  </div>
</section>

