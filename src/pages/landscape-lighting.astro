---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
---

<Layout
  title="Landscape Lighting | AZ Turf Suppliers — Queen Creek, AZ"
  description="Low-voltage landscape lighting for Arizona yards: path lights, flood lights, transformers, and accessories. Designed to handle desert heat. Stocked in Queen Creek, AZ."
>
<style is:global>
.page-hero::before { background-image: url("/media/lighting-flood-lights.webp") !important; }
/* ─── INTRO ─── */
.lighting-intro {
  padding: 88px 0;
  background: var(--white);
}
.lighting-intro-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}
.lighting-intro-content h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 16px;
}
.lighting-intro-content > p {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 28px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.lighting-intro-img {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--dark);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 40px;
}
.lighting-intro-img img { width: 100%; height: 100%; object-fit: cover; }
.lighting-intro-img img.lt-brand-logo { width: 100%; max-width: 340px; height: auto; object-fit: contain; display: block; }
.lt-brand-badge {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  border: 1px solid rgba(255,255,255,0.15);
  padding: 6px 16px;
  border-radius: 100px;
}

/* ─── WHY WIRE ─── */
.why-wire {
  padding: 88px 0;
  background: var(--gray-100);
}
.why-wire-header {
  text-align: center;
  margin-bottom: 56px;
}
.why-wire-header h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 12px;
}
.why-wire-header p {
  font-size: 0.95rem;
  color: var(--gray-600);
  max-width: 620px;
  margin: 0 auto;
  line-height: 1.75;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.why-wire-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.why-wire-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 36px 28px;
  border: 1px solid rgba(0,0,0,0.04);
  box-shadow: var(--shadow-sm);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.why-wire-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}
.why-wire-card svg {
  width: 28px;
  height: 28px;
  color: var(--green-700);
  margin-bottom: 18px;
}
.why-wire-card h4 {
  font-size: 0.9rem;
  color: var(--dark);
  margin-bottom: 10px;
  letter-spacing: 0.04em;
}
.why-wire-card p {
  font-size: 0.85rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── PHOTO GALLERY STRIP ─── */
.lighting-gallery {
  padding: 0;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  height: 320px;
  overflow: hidden;
}
.lighting-gallery-item {
  overflow: hidden;
  position: relative;
}
.lighting-gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: block;
}
.lighting-gallery-item:hover img { transform: scale(1.05); }
@media (max-width: 768px) {
  .lighting-gallery { grid-template-columns: 1fr 1fr; height: 220px; }
  .lighting-gallery-item:last-child { display: none; }
}

/* ─── PRODUCT CATEGORIES ─── */
.lighting-products {
  padding: 88px 0;
  background: var(--white);
}
.lighting-cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
.lighting-cat {
  background: var(--gray-100);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1px solid rgba(0,0,0,0.04);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.lighting-cat:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.lighting-cat-img {
  aspect-ratio: 1;
  background: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0,0,0,0.15);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.lighting-cat-img img { width: 100%; height: 100%; object-fit: cover; }
.lighting-cat-content {
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.lighting-cat-content h3 {
  font-size: 1.1rem;
  color: var(--dark);
  margin-bottom: 10px;
  letter-spacing: 0.02em;
}
.lighting-cat-content p {
  font-size: 0.85rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  margin-bottom: 20px;
}
.lighting-cat-content .btn { align-self: flex-start; }

/* Full-width category */
.lighting-cat.full-width {
  grid-template-columns: 1fr 2fr;
}

/* ─── SAMPLE PRODUCTS ─── */
.sample-products { padding: 88px 0; background: var(--gray-100); }
.products-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.product-placeholder { background: var(--white); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid rgba(0,0,0,0.04); box-shadow: var(--shadow-sm); transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
.product-placeholder:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.product-placeholder-img { aspect-ratio: 1; background: var(--gray-100); display: flex; align-items: center; justify-content: center; color: rgba(0,0,0,0.12); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
.product-placeholder-body { padding: 20px 24px; }
.product-placeholder-body h4 { font-size: 0.95rem; color: var(--dark); margin-bottom: 4px; text-transform: none; letter-spacing: 0; }
.product-placeholder-body p { font-size: 0.82rem; color: var(--gray-600); font-weight: 400; text-transform: none; letter-spacing: 0; margin-bottom: 14px; }

/* ─── CATALOG ─── */
.lt-catalog { padding: 88px 0; background: var(--gray-100); }
.lt-note {
  background: var(--white);
  border-radius: var(--radius);
  padding: 14px 20px;
  font-size: 0.85rem;
  color: var(--gray-600);
  margin-bottom: 40px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  border-left: 3px solid var(--green-700);
}
.lt-cat { margin-bottom: 40px; }
.lt-cat:last-child { margin-bottom: 0; }
.lt-cat-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--white);
  background: var(--green-700);
  display: inline-block;
  padding: 5px 14px;
  border-radius: 4px;
  margin-bottom: 16px;
}
.ltt-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-200);
}
.ltt { width: 100%; border-collapse: collapse; background: var(--white); }
.ltt thead { background: var(--green-700); }
.ltt thead th {
  padding: 10px 16px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  text-align: left;
}
.ltt tbody tr { border-bottom: 1px solid var(--gray-200); transition: background 0.15s; }
.ltt tbody tr:last-child { border-bottom: none; }
.ltt tbody tr:hover { background: var(--gray-100); }
.ltt tbody td {
  padding: 10px 16px;
  font-size: 0.85rem;
  color: var(--dark);
  vertical-align: middle;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.5;
}
.ltt-sku {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--green-700);
  white-space: nowrap;
}
.ltt th.ltt-th-img, .ltt td.ltt-td-img { width: 72px; padding: 8px; }
.ltt-thumb {
  width: 56px;
  height: 56px;
  object-fit: contain;
  background: var(--white);
  border-radius: 6px;
  border: 1px solid var(--gray-200);
  display: block;
  padding: 3px;
}

/* ─── DARK SECTION - TRANSFORMERS ─── */
.lighting-transformers {
  padding: 88px 0;
  background: var(--dark);
}
.transformers-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}
.transformers-content h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  color: var(--white);
  margin-bottom: 16px;
}
.transformers-content > p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.75;
  margin-bottom: 28px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.transformers-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 32px;
}
.transformers-item {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.transformers-item svg {
  width: 20px;
  height: 20px;
  color: var(--green-700);
  flex-shrink: 0;
  margin-top: 2px;
}
.transformers-item p {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.transformers-item p strong {
  color: var(--white);
  font-weight: 700;
}
.transformers-img {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.15);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.transformers-img img { width: 100%; height: 100%; object-fit: cover; }

/* ─── CONTRACTOR CALLOUT ─── */
.contractor-callout {
  padding: 56px 0;
  background: var(--green-700);
}
.contractor-callout-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}
.contractor-callout-text h3 {
  font-size: 1.4rem;
  color: var(--white);
  margin-bottom: 6px;
  text-transform: none;
  letter-spacing: -0.01em;
}
.contractor-callout-text p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.75);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .lighting-cat-grid { grid-template-columns: 1fr; }
  .lighting-cat.full-width { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 768px) {
  .lighting-intro-inner { grid-template-columns: 1fr; gap: 32px; }
  .why-wire-grid { grid-template-columns: 1fr; }
  .lighting-cat { grid-template-columns: 1fr; }
  .lighting-cat.full-width { grid-template-columns: 1fr; }
  .transformers-inner { grid-template-columns: 1fr; gap: 32px; }
  .contractor-callout-inner { flex-direction: column; text-align: center; }
  .lighting-intro { padding: 56px 0; }
  .why-wire { padding: 56px 0; }
  .lighting-products { padding: 56px 0; }
  .lighting-transformers { padding: 56px 0; }
  .lt-catalog { padding: 56px 0; }
  .ltt thead th, .ltt tbody td { padding: 8px 10px; font-size: 0.78rem; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Lumenex Lighting</div>
      <h1>Landscape <em>Lighting</em></h1>
      <p>Professional-grade, low-voltage landscape lighting built for Arizona. In stock and ready for pickup or next-day delivery.</p>
      <div class="page-hero-btns">
        <a href="/contact" class="btn btn-primary">Get a Quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="tel:4807393854" class="btn btn-outline">Call 480-739-3854</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    <div class="stat-item">
      <div class="stat-num">Low<span>-V</span></div>
      <div class="stat-label">Safe &amp; Energy Efficient</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">LED</div>
      <div class="stat-label">Long-Life Technology</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">75<span>–600W</span></div>
      <div class="stat-label">Transformer Range</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">Next<span>-Day</span></div>
      <div class="stat-label">Delivery Available</div>
    </div>
  </div>
</div>

<!-- ═══ INTRO ═══ -->
<section class="lighting-intro">
  <div class="container">
    <div class="lighting-intro-inner">
      <div class="lighting-intro-content" data-reveal>
        <div class="section-label">Professional Landscape Lighting</div>
        <h2>Illuminate Your Outdoor Space with Lumenex</h2>
        <p>Cheap solar fixtures fade, flicker, and fail. Lumenex is a professional-grade, low-voltage lighting line trusted by Arizona landscape contractors and homeowners. We stock everything you need to light up pathways, hardscapes, trees, and architectural features.</p>
        <p>Hardwired low-voltage systems deliver consistent illumination night after night — no batteries, no disappointments. Heavy-duty aluminum and brass construction holds up against Arizona's extreme heat and UV exposure.</p>
        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:8px;">
          <a href="/contact" class="btn btn-primary">Get a Lighting Quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          <a href="tel:4807393854" class="btn btn-dark">Call 480-739-3854</a>
        </div>
      </div>
      <div class="lighting-intro-img" data-reveal>
        <img class="lt-brand-logo" src="/media/lumenex-lighting.svg" alt="Lumenex Lighting" loading="lazy" decoding="async"/>
        <span class="lt-brand-badge">Authorized Dealer</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ WHY WIRE ═══ -->
<section class="why-wire">
  <div class="container">
    <div class="why-wire-header">
      <div class="section-label centered">Why Go Hardwired</div>
      <h2>Why Wire Lighting — Not Solar</h2>
      <p>Solar looks cheap because it is. Here's why professional landscape contractors always specify low-voltage hardwired systems.</p>
    </div>
    <div class="why-wire-grid">
      <div class="why-wire-card" data-reveal>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/></svg>
        <h4>Built for Arizona</h4>
        <p>Heavy-duty aluminum and brass construction engineered to handle extreme heat and relentless UV exposure without degradation.</p>
      </div>
      <div class="why-wire-card" data-reveal>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <h4>Energy-Efficient LED</h4>
        <p>Brilliant light output at a fraction of the operating cost. LED technology means longer bulb life and lower energy bills.</p>
      </div>
      <div class="why-wire-card" data-reveal>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <h4>Fully Controllable</h4>
        <p>Pair with digital timers, mechanical timers, photocells, or magnetic dimmers for complete automation. Set it and forget it.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PHOTO GALLERY STRIP ═══ -->
<div class="lighting-gallery">
  <div class="lighting-gallery-item">
    <img src="/media/lighting-flood-lights.webp" alt="Landscape flood lighting at night" loading="lazy" decoding="async"/>
  </div>
  <div class="lighting-gallery-item">
    <img src="/media/lighting-deck-lights.webp" alt="Deck lighting on outdoor patio" loading="lazy" decoding="async"/>
  </div>
  <div class="lighting-gallery-item">
    <img src="/media/lighting-well-lights.webp" alt="In-ground well lights in landscape" loading="lazy" decoding="async"/>
  </div>
</div>

<!-- ═══ PRODUCT CATEGORIES ═══ -->
<section class="lighting-products">
  <div class="container">
    <div class="section-header centered" style="margin-bottom:48px;">
      <div class="section-label centered">Our Collection</div>
      <h2>Lumenex Lighting Products</h2>
    </div>
    <div class="lighting-cat-grid">

      <div class="lighting-cat" data-reveal>
        <div class="lighting-cat-img">
          <img src="/media/lighting-path-lights.webp" alt="Lumenex path lights illuminating a walkway" loading="lazy" decoding="async"/>
        </div>
        <div class="lighting-cat-content">
          <h3>Path &amp; Area Lights</h3>
          <p>Illuminate walkways, garden beds, and turf borders with clean, ground-level light. Available in aluminum and brass with multiple finish options.</p>
          <a href="/contact" class="btn btn-dark">Get a Quote</a>
        </div>
      </div>

      <div class="lighting-cat" data-reveal>
        <div class="lighting-cat-img">
          <img src="/media/lighting-spot-lights.webp" alt="Lumenex spotlights on a landscape" loading="lazy" decoding="async"/>
        </div>
        <div class="lighting-cat-content">
          <h3>Spotlights &amp; Flood Lights</h3>
          <p>Highlight trees, walls, and architectural features. Choose from aluminum and brass spotlights, or go big with high-output flood lights for large areas.</p>
          <a href="/contact" class="btn btn-dark">Get a Quote</a>
        </div>
      </div>

      <div class="lighting-cat" data-reveal>
        <div class="lighting-cat-img">
          <img src="/media/lighting-hardscape-lights.webp" alt="Lumenex hardscape lights in a paver wall" loading="lazy" decoding="async"/>
        </div>
        <div class="lighting-cat-content">
          <h3>Hardscape &amp; Well Lights</h3>
          <p>Integrate lighting directly into paver walls, steps, fire pits, and pool decks. Available in multiple sizes with rotatable and replaceable module options.</p>
          <a href="/contact" class="btn btn-dark">Get a Quote</a>
        </div>
      </div>

      <div class="lighting-cat" data-reveal>
        <div class="lighting-cat-img">
          <img src="/media/lighting-wall-lights.webp" alt="Lumenex wall and deck lights" loading="lazy" decoding="async"/>
        </div>
        <div class="lighting-cat-content">
          <h3>Wall, Deck &amp; Flood Lights</h3>
          <p>Direct burial cable, waterproof connectors, wall-mount fixtures, deck lights, and mounting hardware. Everything you need for a clean, reliable installation.</p>
          <a href="/contact" class="btn btn-dark">Get a Quote</a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══ CATALOG ═══ -->
<section class="lt-catalog" id="catalog">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Our Inventory</div>
      <h2>Lumenex Product Catalog</h2>
      <p>Full range of Lumenex landscape lighting fixtures, transformers, cable, and accessories — stocked at our Queen Creek showroom.</p>
    </div>
    <div class="lt-note">Call or text <a href="tel:6025207511" style="color:var(--green-700);font-weight:600;">(602) 520-7511</a> for current pricing and stock availability on any item.</div>

    <div class="lt-cat" data-reveal>
      <div class="lt-cat-label">Lamps / Bulbs</div>
      <div class="ltt-wrap"><table class="ltt">
        <thead><tr><th class="ltt-th-img"></th><th style="width:140px;">Item #</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td class="ltt-td-img"><Pic name="LT1016A.jpg" class="ltt-thumb"   alt="" /></td><td><span class="ltt-sku">LT1016A</span></td><td>4W, 360lm, 2700K, 30°, Waterproof (MR16 Lamp)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT1016A.jpg" class="ltt-thumb"   alt="" /></td><td><span class="ltt-sku">LT1016A</span></td><td>4W, 360lm, 2700K, 60°, Waterproof (MR16 Lamp)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT1016A.jpg" class="ltt-thumb"   alt="" /></td><td><span class="ltt-sku">LT1016A</span></td><td>7W, 600lm, 2700K, 30°, Waterproof (MR16 Lamp)</td></tr>
