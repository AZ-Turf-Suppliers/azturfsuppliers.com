---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import { renderInline } from '../utils/inline-markdown';
import page from '../data/pages/landscape-lighting.json';

const introParas = page.intro.body.split('\n\n');
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
>
<style is:global set:html={`.page-hero::before { background-image: url("${page.heroImage}") !important; }`} />
<style is:global>
/* hero image is injected via the inline <style is:global> tag above */
/* ─── INTRO ─── */
.lighting-intro {
  padding: 88px 0;
  background: var(--white);
}
.lighting-intro-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}
.lighting-intro-content h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 16px;
}
.lighting-intro-content > p {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 28px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.lighting-intro-img {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--dark);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 40px;
}
.lighting-intro-img img { width: 100%; height: 100%; object-fit: cover; }
.lighting-intro-img img.lt-brand-logo { width: 100%; max-width: 340px; height: auto; object-fit: contain; display: block; }
.lt-brand-badge {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.4);
  border: 1px solid rgba(255,255,255,0.15);
  padding: 6px 16px;
  border-radius: 100px;
}

/* ─── WHY WIRE ─── */
.why-wire {
  padding: 88px 0;
  background: var(--gray-100);
}
.why-wire-header {
  text-align: center;
  margin-bottom: 56px;
}
.why-wire-header h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 12px;
}
.why-wire-header p {
  font-size: 0.95rem;
  color: var(--gray-600);
  max-width: 620px;
  margin: 0 auto;
  line-height: 1.75;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.why-wire-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.why-wire-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 36px 28px;
  border: 1px solid rgba(0,0,0,0.04);
  box-shadow: var(--shadow-sm);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.why-wire-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}
.why-wire-card svg {
  width: 28px;
  height: 28px;
  color: var(--green-700);
  margin-bottom: 18px;
}
.why-wire-card h4 {
  font-size: 0.9rem;
  color: var(--dark);
  margin-bottom: 10px;
  letter-spacing: 0.04em;
}
.why-wire-card p {
  font-size: 0.85rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── PHOTO GALLERY STRIP ─── */
.lighting-gallery {
  padding: 0;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  height: 320px;
  overflow: hidden;
}
.lighting-gallery-item {
  overflow: hidden;
  position: relative;
}
.lighting-gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  display: block;
}
.lighting-gallery-item:hover img { transform: scale(1.05); }
@media (max-width: 768px) {
  .lighting-gallery { grid-template-columns: 1fr 1fr; height: 220px; }
  .lighting-gallery-item:last-child { display: none; }
}

/* ─── PRODUCT CATEGORIES ─── */
.lighting-products {
  padding: 88px 0;
  background: var(--white);
}
.lighting-cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
.lighting-cat {
  background: var(--gray-100);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  border: 1px solid rgba(0,0,0,0.04);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.lighting-cat:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}
.lighting-cat-img {
  aspect-ratio: 1;
  background: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0,0,0,0.15);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.lighting-cat-img img { width: 100%; height: 100%; object-fit: cover; }
.lighting-cat-content {
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.lighting-cat-content h3 {
  font-size: 1.1rem;
  color: var(--dark);
  margin-bottom: 10px;
  letter-spacing: 0.02em;
}
.lighting-cat-content p {
  font-size: 0.85rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  margin-bottom: 20px;
}
.lighting-cat-content .btn { align-self: flex-start; }

/* Full-width category */
.lighting-cat.full-width {
  grid-template-columns: 1fr 2fr;
}

/* ─── SAMPLE PRODUCTS ─── */
.sample-products { padding: 88px 0; background: var(--gray-100); }
.products-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.product-placeholder { background: var(--white); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid rgba(0,0,0,0.04); box-shadow: var(--shadow-sm); transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
.product-placeholder:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.product-placeholder-img { aspect-ratio: 1; background: var(--gray-100); display: flex; align-items: center; justify-content: center; color: rgba(0,0,0,0.12); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
.product-placeholder-body { padding: 20px 24px; }
.product-placeholder-body h4 { font-size: 0.95rem; color: var(--dark); margin-bottom: 4px; text-transform: none; letter-spacing: 0; }
.product-placeholder-body p { font-size: 0.82rem; color: var(--gray-600); font-weight: 400; text-transform: none; letter-spacing: 0; margin-bottom: 14px; }

/* ─── CATALOG ─── */
.lt-catalog { padding: 88px 0; background: var(--gray-100); }
.lt-note {
  background: var(--white);
  border-radius: var(--radius);
  padding: 14px 20px;
  font-size: 0.85rem;
  color: var(--gray-600);
  margin-bottom: 40px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  border-left: 3px solid var(--green-700);
}
.lt-cat { margin-bottom: 40px; }
.lt-cat:last-child { margin-bottom: 0; }
.lt-cat-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--white);
  background: var(--green-700);
  display: inline-block;
  padding: 5px 14px;
  border-radius: 4px;
  margin-bottom: 16px;
}
.ltt-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-200);
}
.ltt { width: 100%; border-collapse: collapse; background: var(--white); }
.ltt thead { background: var(--green-700); }
.ltt thead th {
  padding: 10px 16px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  text-align: left;
}
.ltt tbody tr { border-bottom: 1px solid var(--gray-200); transition: background 0.15s; }
.ltt tbody tr:last-child { border-bottom: none; }
.ltt tbody tr:hover { background: var(--gray-100); }
.ltt tbody td {
  padding: 10px 16px;
  font-size: 0.85rem;
  color: var(--dark);
  vertical-align: middle;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.5;
}
.ltt-sku {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--green-700);
  white-space: nowrap;
}
.ltt th.ltt-th-img, .ltt td.ltt-td-img {
  width: 76px;
  min-width: 76px;
  padding: 8px;
}
.ltt-td-img {
  text-align: center;
}
/* Force every thumbnail to render in an identical 56×56 box regardless of
   the source image's intrinsic aspect ratio. */
.ltt-thumb {
  width: 56px;
  height: 56px;
  object-fit: cover;
  background: var(--white);
  border-radius: 6px;
  border: 1px solid var(--gray-200);
  display: inline-block;
  vertical-align: middle;
  padding: 0;
}
@media (max-width: 768px) {
  .ltt th.ltt-th-img, .ltt td.ltt-td-img { width: 68px; min-width: 68px; padding: 6px; }
  .ltt-thumb { width: 52px; height: 52px; }
}

/* ─── DARK SECTION - TRANSFORMERS ─── */
.lighting-transformers {
  padding: 88px 0;
  background: var(--dark);
}
.transformers-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}
.transformers-content h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  color: var(--white);
  margin-bottom: 16px;
}
.transformers-content > p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.75;
  margin-bottom: 28px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.transformers-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 32px;
}
.transformers-item {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.transformers-item svg {
  width: 20px;
  height: 20px;
  color: var(--green-700);
  flex-shrink: 0;
  margin-top: 2px;
}
.transformers-item p {
  font-size: 0.9rem;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.transformers-item p strong {
  color: var(--white);
  font-weight: 700;
}
.transformers-img {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.15);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.transformers-img img { width: 100%; height: 100%; object-fit: cover; }

/* ─── CONTRACTOR CALLOUT ─── */
.contractor-callout {
  padding: 56px 0;
  background: var(--green-700);
}
.contractor-callout-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}
.contractor-callout-text h3 {
  font-size: 1.4rem;
  color: var(--white);
  margin-bottom: 6px;
  text-transform: none;
  letter-spacing: -0.01em;
}
.contractor-callout-text p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.75);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .lighting-cat-grid { grid-template-columns: 1fr; }
  .lighting-cat.full-width { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 768px) {
  .lighting-intro-inner { grid-template-columns: 1fr; gap: 32px; }
  .why-wire-grid { grid-template-columns: 1fr; }
  .lighting-cat { grid-template-columns: 1fr; }
  .lighting-cat.full-width { grid-template-columns: 1fr; }
  .transformers-inner { grid-template-columns: 1fr; gap: 32px; }
  .contractor-callout-inner { flex-direction: column; text-align: center; }
  .lighting-intro { padding: 30px 0; }
  .why-wire { padding: 30px 0; }
  .lighting-products { padding: 30px 0; }
  .lighting-transformers { padding: 30px 0; }
  .lt-catalog { padding: 30px 0; }
  .ltt thead th, .ltt tbody td { padding: 8px 10px; font-size: 0.78rem; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{page.hero.eyebrow}</div>
      <h1 set:html={renderInline(page.hero.heading)} />
      <p>{page.hero.body}</p>
      <div class="page-hero-btns">
        <a href={page.hero.ctaPrimary.link} class="btn btn-primary">{page.hero.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
        <a href={page.hero.ctaSecondary.link} class="btn btn-outline">{page.hero.ctaSecondary.text}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    {page.statBar.map((item) => (
      <div class="stat-item">
        <div class="stat-num">{item.value}</div>
        <div class="stat-label">{item.label}</div>
      </div>
    ))}
  </div>
</div>

<!-- ═══ INTRO ═══ -->
<section class="lighting-intro">
  <div class="container">
    <div class="lighting-intro-inner">
      <div class="lighting-intro-content body-links" data-reveal>
        <div class="section-label">{page.intro.label}</div>
        <h2 set:html={renderInline(page.intro.heading)} />
        {introParas.map((para) => <p set:html={renderInline(para)} />)}
        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:8px;">
          <a href={page.intro.ctaPrimary.link} class="btn btn-primary">{page.intro.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
          <a href={page.intro.ctaSecondary.link} class="btn btn-dark">{page.intro.ctaSecondary.text}</a>
        </div>
      </div>
      <div class="lighting-intro-img" data-reveal>
        <img class="lt-brand-logo" src="/media/lumenex-lighting.svg" alt="Lumenex Lighting" loading="lazy" decoding="async"/>
        <span class="lt-brand-badge">{page.intro.brandBadge}</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ WHY WIRE ═══ -->
<section class="why-wire">
  <div class="container">
    <div class="why-wire-header">
      <div class="section-label centered">{page.whyWire.label}</div>
      <h2 set:html={renderInline(page.whyWire.heading)} />
      <p set:html={renderInline(page.whyWire.body)} />
    </div>
    <div class="why-wire-grid">
      {page.whyWire.items.map((item) => (
        <div class="why-wire-card" data-reveal>
          <Icon name={item.icon as any} size={28} />
          <h4 set:html={renderInline(item.heading)} />
          <p set:html={renderInline(item.body)} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PHOTO GALLERY STRIP ═══ -->
<div class="lighting-gallery">
  <div class="lighting-gallery-item">
    <img src="/media/lighting-flood-lights.webp" alt="Landscape flood lighting at night" loading="lazy" decoding="async"/>
  </div>
  <div class="lighting-gallery-item">
    <img src="/media/lighting-deck-lights.webp" alt="Deck lighting on outdoor patio" loading="lazy" decoding="async"/>
  </div>
  <div class="lighting-gallery-item">
    <img src="/media/lighting-well-lights.webp" alt="In-ground well lights in landscape" loading="lazy" decoding="async"/>
  </div>
</div>

<!-- ═══ PRODUCT CATEGORIES ═══ -->
<section class="lighting-products">
  <div class="container">
    <div class="section-header centered" style="margin-bottom:48px;">
      <div class="section-label centered">{page.products.label}</div>
      <h2 set:html={renderInline(page.products.heading)} />
    </div>
    <div class="lighting-cat-grid">
      {page.products.items.map((item) => (
        <div class="lighting-cat" data-reveal>
          <div class="lighting-cat-img">
            <img src={item.image} alt={item.alt} loading="lazy" decoding="async"/>
          </div>
          <div class="lighting-cat-content body-links">
            <h3 set:html={renderInline(item.heading)} />
            <p set:html={renderInline(item.body)} />
            <a href={item.link} class="btn btn-dark">{item.linkText}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CATALOG ═══ -->
<section class="lt-catalog" id="catalog">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Our Inventory</div>
      <h2>Lumenex Product Catalog</h2>
      <p>Full range of Lumenex landscape lighting fixtures, transformers, cable, and accessories — stocked at our Queen Creek showroom.</p>
    </div>
    <div class="lt-note">Call or text <a href="tel:4807931800" style="color:var(--green-700);font-weight:600;">(480) 793-1800</a> for current pricing and stock availability on any item.</div>

    <div class="lt-cat" data-reveal>
      <div class="lt-cat-label">Lamps / Bulbs</div>
      <div class="ltt-wrap"><table class="ltt">
        <thead><tr><th class="ltt-th-img"></th><th style="width:140px;">Item #</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td class="ltt-td-img"><Pic name="LT1016A.jpg" class="ltt-thumb"   alt="LT1016A lighting fixture" /></td><td><span class="ltt-sku">LT1016A</span></td><td>4W, 360lm, 2700K, 30°, Waterproof (MR16 Lamp)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT1016A.jpg" class="ltt-thumb"   alt="LT1016A lighting fixture" /></td><td><span class="ltt-sku">LT1016A</span></td><td>4W, 360lm, 2700K, 60°, Waterproof (MR16 Lamp)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT1016A.jpg" class="ltt-thumb"   alt="LT1016A lighting fixture" /></td><td><span class="ltt-sku">LT1016A</span></td><td>7W, 600lm, 2700K, 30°, Waterproof (MR16 Lamp)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT1016A.jpg" class="ltt-thumb"   alt="LT1016A lighting fixture" /></td><td><span class="ltt-sku">LT1016A</span></td><td>7W, 600lm, 2700K, 60°, Waterproof (MR16 Lamp)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT1016CG-CT5.jpg" class="ltt-thumb"   alt="LT1016CG-CT5 lighting fixture" /></td><td><span class="ltt-sku">LT1016CG-CT5</span></td><td>5W, 530lm, 2700/3000/4000/5000/6000K Adjustable, Replaceable lens 30/45/60° (MR16)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT108.jpg" class="ltt-thumb"   alt="LT108 lighting fixture" /></td><td><span class="ltt-sku">LT108</span></td><td>2.5W, 160lm, 2700K, 38° (MR8 Lamp)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT104A3.jpg" class="ltt-thumb"   alt="LT104A3 lighting fixture" /></td><td><span class="ltt-sku">LT104A3</span></td><td>2W, 180lm, 2700K (G4 Lamp)</td></tr>
        </tbody>
      </table></div>
    </div>

    <div class="lt-cat" data-reveal>
      <div class="lt-cat-label">Path Lights</div>
      <div class="ltt-wrap"><table class="ltt">
        <thead><tr><th class="ltt-th-img"></th><th style="width:140px;">Item #</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td class="ltt-td-img"><Pic name="LT2401A.png" class="ltt-thumb"   alt="LT2401A lighting fixture" /></td><td><span class="ltt-sku">LT2401A</span></td><td>Aluminum Path Light, Black or Bronze (G4 Lamp included, 2W 2700K 180lm)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT2405A.jpg" class="ltt-thumb"   alt="LT2405A lighting fixture" /></td><td><span class="ltt-sku">LT2405A</span></td><td>Aluminum Path Light, Black or Bronze (G4 Lamp included, 2W 2700K 180lm)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT2404A.png" class="ltt-thumb"   alt="LT2404A lighting fixture" /></td><td><span class="ltt-sku">LT2404A</span></td><td>Aluminum Path Light, Black (G4 Lamp included, 2W 2700K 180lm)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="9409B.jpg" class="ltt-thumb"   alt="9409B lighting fixture" /></td><td><span class="ltt-sku">9409B</span></td><td>Aluminum Path Light, Black (G4 Lamp included, 2W 2700K 180lm)</td></tr>
          <tr><td class="ltt-td-img"><Pic name="LT2401.png" class="ltt-thumb"   alt="LT2401 lighting fixture" /></td><td><span class="ltt-sku">LT2401</span></td><td>Brass Path Light, Antique Bronze (G4 Lamp included, 2W 2700K 180lm)</td></tr>
        </tbody>
      </table></div>
    </div>

    <div class="lt-cat" data-reveal>
      <div class="lt-cat-label">Spot Lights</div>
      <div class="ltt-wrap"><table class="ltt">
        <thead><tr><th class="ltt-th-img"></th><th style="width:140px;">Item #</th><th>Description</th></tr></thead>
