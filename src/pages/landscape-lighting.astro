<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">{page.cta.label}</div>
    <h2 set:html={renderInline(page.cta.heading)} />
    <p set:html={renderInline(page.cta.body)} />
    <div class="cta-btns">
      {page.cta.buttons.map((btn) => (
        <a href={btn.link} class={`btn btn-${btn.style}`}>
          {btn.text}
          {btn.style === 'primary' && (
            <Icon name="arrow-right" size={16} />
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<script>
// ─── SCROLL REVEAL ───
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('revealed'); revealObserver.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));
</script>
