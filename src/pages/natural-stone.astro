---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import { renderInline } from '../utils/inline-markdown';
import page from '../data/pages/natural-stone.json';

const introParas = page.intro.body.split('\n\n');
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
>
<style is:global set:html={`.page-hero::before { background-image: url("${page.heroImage}") !important; }`} />
<style is:global>
/* hero image is injected via the inline <style is:global> tag below */
/* ─── INTRO ─── */
.stone-intro { padding: 88px 0; background: var(--white); }
.stone-intro-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
.stone-intro-content h2 { font-size: clamp(1.9rem, 3vw, 2.8rem); margin-bottom: 16px; }
.stone-intro-content > p { font-size: 0.95rem; color: var(--gray-600); line-height: 1.75; margin-bottom: 24px; font-weight: 400; text-transform: none; letter-spacing: 0; }
.stone-intro-img { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4/3; background: var(--gray-200); display: flex; align-items: center; justify-content: center; color: rgba(0,0,0,0.15); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
.stone-intro-img img { width: 100%; height: 100%; object-fit: cover; }

/* ─── STONE TYPES ─── */
.stone-types { padding: 88px 0; background: var(--gray-100); }
.stone-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.stone-card { background: var(--white); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid rgba(0,0,0,0.04); box-shadow: var(--shadow-sm); transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
.stone-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
.stone-card-img { aspect-ratio: 4/3; background: var(--gray-200); display: flex; align-items: center; justify-content: center; color: rgba(0,0,0,0.12); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; overflow: hidden; }
.stone-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.stone-card:hover .stone-card-img img { transform: scale(1.04); }
.stone-card-mosaic { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 2px; background: var(--gray-200); }
.stone-card-mosaic img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.stone-card:hover .stone-card-mosaic img { transform: scale(1.04); }
.stone-card-body { padding: 24px; }
.stone-card-body h3 { font-size: 1.05rem; color: var(--dark); margin-bottom: 8px; text-transform: none; letter-spacing: 0; }
.stone-card-body p { font-size: 0.85rem; color: var(--gray-600); line-height: 1.65; font-weight: 400; text-transform: none; letter-spacing: 0; margin-bottom: 16px; }

/* ─── APPLICATIONS ─── */
.stone-apps { padding: 88px 0; background: var(--white); }
.stone-apps-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.stone-app { display: flex; gap: 20px; align-items: flex-start; background: var(--gray-100); border-radius: var(--radius-lg); padding: 28px; border: 1px solid rgba(0,0,0,0.04); }
.stone-app svg { width: 28px; height: 28px; color: var(--green-700); flex-shrink: 0; margin-top: 2px; }
.stone-app h4 { font-size: 0.9rem; color: var(--dark); margin-bottom: 6px; letter-spacing: 0.02em; text-transform: none; }
.stone-app p { font-size: 0.85rem; color: var(--gray-600); line-height: 1.65; font-weight: 400; text-transform: none; letter-spacing: 0; }

/* ─── SAMPLE PRODUCTS ─── */
.sample-products { padding: 88px 0; background: var(--gray-100); }
.products-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.product-placeholder { background: var(--white); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid rgba(0,0,0,0.04); box-shadow: var(--shadow-sm); transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
.product-placeholder:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.product-placeholder-img { aspect-ratio: 1; background: var(--gray-100); display: flex; align-items: center; justify-content: center; color: rgba(0,0,0,0.12); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
.product-placeholder-img img { width: 100%; height: 100%; object-fit: cover; }
.product-placeholder-body { padding: 20px 24px; }
.product-placeholder-body h4 { font-size: 0.95rem; color: var(--dark); margin-bottom: 4px; text-transform: none; letter-spacing: 0; }
.product-placeholder-body p { font-size: 0.82rem; color: var(--gray-600); font-weight: 400; text-transform: none; letter-spacing: 0; margin-bottom: 14px; }

/* ─── DARK SECTION ─── */
.stone-advantage { padding: 88px 0; position: relative; overflow: hidden; }
.stone-advantage::before { content: ''; position: absolute; inset: 0; background: url('https://static.showit.co/1600/toQS1ag5R9-rJia5bb5Y9A/shared/img_0995-preview.jpg') center / cover no-repeat; z-index: 0; }
.stone-advantage::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.75); z-index: 1; }
.stone-adv-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
.stone-adv-content h2 { font-size: clamp(1.9rem, 3vw, 2.8rem); color: var(--white); margin-bottom: 16px; }
.stone-adv-content > p { font-size: 0.95rem; color: rgba(255,255,255,0.65); line-height: 1.75; margin-bottom: 28px; font-weight: 400; text-transform: none; letter-spacing: 0; }
.stone-adv-list { display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }
.stone-adv-item { display: flex; gap: 12px; align-items: flex-start; }
.stone-adv-item svg { width: 20px; height: 20px; color: var(--green-700); flex-shrink: 0; margin-top: 2px; }
.stone-adv-item p { font-size: 0.9rem; color: rgba(255,255,255,0.7); line-height: 1.6; font-weight: 400; text-transform: none; letter-spacing: 0; }
.stone-adv-item p strong { color: var(--white); font-weight: 700; }
.stone-adv-img { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4/3; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); }
.stone-adv-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* ─── PRICING ─── */
.stone-pricing { padding: 88px 0; background: var(--gray-100); }
.pricing-note {
  background: var(--white);
  border-radius: var(--radius);
  padding: 14px 20px;
  font-size: 0.85rem;
  color: var(--gray-600);
  margin-bottom: 40px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  border-left: 3px solid var(--green-700);
}
.stone-cat { margin-bottom: 64px; }
.stone-cat:last-child { margin-bottom: 0; }
.stone-cat-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--white);
  background: var(--green-700);
  display: inline-block;
  padding: 5px 14px;
  border-radius: 4px;
  margin-bottom: 28px;
}
.stone-variant { margin-bottom: 40px; padding-bottom: 40px; border-bottom: 1px solid var(--gray-200); }
.stone-variant:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
.stone-variant-title {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--dark);
  margin-bottom: 18px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.stone-swatch {
  width: 56px;
  height: 56px;
  border-radius: 10px;
  flex-shrink: 0;
  object-fit: cover;
  border: 1px solid var(--gray-200);
  box-shadow: var(--shadow-sm);
  background: var(--gray-100);
}
.stone-sub-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gray-400);
  margin: 14px 0 6px;
}
.ptable-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-200);
  margin-bottom: 4px;
}
.ptable { width: 100%; border-collapse: collapse; background: var(--white); }
.ptable thead { background: var(--green-700); }
.ptable thead th {
  padding: 10px 16px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  text-align: left;
}
.ptable thead th:last-child { text-align: right; }
.ptable tbody tr { border-bottom: 1px solid var(--gray-200); transition: background 0.15s; }
.ptable tbody tr:last-child { border-bottom: none; }
.ptable tbody tr:hover { background: var(--gray-100); }
.ptable tbody td {
  padding: 10px 16px;
  font-size: 0.85rem;
  color: var(--dark);
  vertical-align: middle;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.ptable tbody td:last-child { text-align: right; }
.stone-price { font-size: 0.95rem; font-weight: 800; color: var(--green-700); white-space: nowrap; }

/* ─── RESPONSIVE ─── */
@media (max-width: 768px) {
  .stone-intro-inner { grid-template-columns: 1fr; gap: 32px; }
  .stone-grid { grid-template-columns: 1fr; }
  .stone-apps-grid { grid-template-columns: 1fr; }
  .stone-adv-inner { grid-template-columns: 1fr; gap: 32px; }
  .stone-intro, .stone-types, .stone-apps, .stone-pricing, .stone-advantage { padding: 30px 0; }
  .ptable thead th, .ptable tbody td { padding: 8px 10px; font-size: 0.78rem; }
  .hide-mobile { display: none; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{page.hero.eyebrow}</div>
      <h1 set:html={renderInline(page.hero.heading)} />
      <p>{page.hero.body}</p>
      <div class="page-hero-btns">
        <a href={page.hero.ctaPrimary.link} class="btn btn-primary">{page.hero.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
        <a href={page.hero.ctaSecondary.link} class="btn btn-outline">{page.hero.ctaSecondary.text}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    {page.statBar.map((item) => (
      <div class="stat-item">
        <div class="stat-num">{item.value}</div>
        <div class="stat-label">{item.label}</div>
      </div>
    ))}
  </div>
</div>

<!-- ═══ INTRO ═══ -->
<section class="stone-intro">
  <div class="container">
    <div class="stone-intro-inner">
      <div class="stone-intro-content" data-reveal>
        <div class="section-label">{page.intro.label}</div>
        <h2 set:html={renderInline(page.intro.heading)} />
        {introParas.map((para) => <p set:html={renderInline(para)} />)}
        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:8px;">
          <a href={page.intro.ctaPrimary.link} class="btn btn-primary">{page.intro.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
          <a href={page.intro.ctaSecondary.link} class="btn btn-dark">{page.intro.ctaSecondary.text}</a>
        </div>
      </div>
      <div class="stone-intro-img" data-reveal><Pic name="stone.jpg" alt="Natural stone display" /></div>
    </div>
  </div>
</section>

<!-- ═══ STONE TYPES ═══ -->
<section class="stone-types">
  <div class="container">
    <div class="section-header centered" style="margin-bottom:48px;">
      <div class="section-label centered">{page.stoneTypes.label}</div>
      <h2 set:html={renderInline(page.stoneTypes.heading)} />
    </div>
    <div class="stone-grid">
      <div class="stone-card" data-reveal>
        <div class="stone-card-img stone-card-mosaic">
          <Pic name="Walnut.png" alt="Walnut Travertine" />
          <Pic name="Beige.png" alt="Tuscany Beige Travertine" />
          <Pic name="Silver.png" alt="Tuscany Silver Travertine" />
          <Pic name="Porcini.png" alt="Porcini Travertine" />
        </div>
        <div class="stone-card-body">
          <h3>{page.stoneTypes.items[0].heading}</h3>
          <p set:html={renderInline(page.stoneTypes.items[0].body)} />
          <a href={page.stoneTypes.items[0].link} class="btn btn-dark">{page.stoneTypes.items[0].linkText}</a>
        </div>
      </div>
      <div class="stone-card" data-reveal>
        <div class="stone-card-img stone-card-mosaic">
          <Pic name="Greecian Silver.png" alt="Greecian Silver Limestone" />
          <Pic name="Greecian Marbella.png" alt="Greecian Marbella Limestone" />
          <Pic name="Greecian Antico.png" alt="Greecian Antico Limestone" />
          <Pic name="Mayra White.png" alt="Mayra White Limestone" />
        </div>
        <div class="stone-card-body">
          <h3>{page.stoneTypes.items[1].heading}</h3>
          <p set:html={renderInline(page.stoneTypes.items[1].body)} />
          <a href={page.stoneTypes.items[1].link} class="btn btn-dark">{page.stoneTypes.items[1].linkText}</a>
        </div>
      </div>
      <div class="stone-card" data-reveal>
        <div class="stone-card-img"><Pic name="Sierra White.png" alt="Sierra White Marble" /></div>
        <div class="stone-card-body">
          <h3>{page.stoneTypes.items[2].heading}</h3>
          <p set:html={renderInline(page.stoneTypes.items[2].body)} />
          <a href={page.stoneTypes.items[2].link} class="btn btn-dark">{page.stoneTypes.items[2].linkText}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ APPLICATIONS ═══ -->
<section class="stone-apps">
  <div class="container">
    <div class="section-header centered" style="margin-bottom:48px;">
      <div class="section-label centered">{page.applications.label}</div>
      <h2 set:html={renderInline(page.applications.heading)} />
    </div>
    <div class="stone-apps-grid">
      {page.applications.items.map((app) => (
        <div class="stone-app" data-reveal>
          <Icon name={app.icon as any} size={28} />
          <div>
            <h4 set:html={renderInline(app.heading)} />
            <p set:html={renderInline(app.body)} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PRICING ═══ -->
<section class="stone-pricing" id="pricing">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Our Collection</div>
      <h2>Natural Stone Inventory</h2>
      <p>Tumbled travertine, limestone, and marble sourced from Turkey and Egypt — available in pavers and matching coping across a range of sizes.</p>
    </div>
    <div class="pricing-note">Call or text <a href="tel:6025207511" style="color:var(--green-700);font-weight:600;">(602) 520-7511</a> for current pricing and availability on any of our natural stone.</div>

    <!-- ─── TRAVERTINE: TURKEY ─── -->
    <div class="stone-cat">
      <div class="stone-cat-label">Travertine — Turkey</div>

      <div class="stone-variant">
        <div class="stone-variant-title"><Pic name="Walnut.png" class="stone-swatch"   alt="Walnut (Noce) Travertine — Tumbled, 3cm swatch" /><span>Walnut (Noce) Travertine — Tumbled, 3cm</span></div>
        <div class="stone-sub-label">Pavers</div>
        <div class="ptable-wrap"><table class="ptable">
          <thead><tr><th>Size</th><th class="hide-mobile">Packaging</th><th class="hide-mobile">Sqft / Pallet</th><th>Price / Sqft</th></tr></thead>
          <tbody>
            <tr><td>12x12, 6x12 &amp; 6x6 (kit)</td><td class="hide-mobile">20 Kit</td><td class="hide-mobile">150</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>12x12</td><td class="hide-mobile">166 pcs</td><td class="hide-mobile">166</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>6x12</td><td class="hide-mobile">340 pcs</td><td class="hide-mobile">170</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>6x6</td><td class="hide-mobile">490 pcs</td><td class="hide-mobile">122.5</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>16x24, 16x16, 8x16, 8x8 (kit)</td><td class="hide-mobile">10 Kit</td><td class="hide-mobile">160</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>16x24</td><td class="hide-mobile">60 pcs</td><td class="hide-mobile">159.6</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>12x24</td><td class="hide-mobile">60 pcs</td><td class="hide-mobile">120</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>24x24</td><td class="hide-mobile">34 pcs</td><td class="hide-mobile">136</td><td><span class="stone-price">Call</span></td></tr>
          </tbody>
        </table></div>
        <div class="stone-sub-label">Coping</div>
        <div class="ptable-wrap"><table class="ptable">
          <thead><tr><th>Finish</th><th>Size</th><th class="hide-mobile">Thickness</th><th class="hide-mobile">Sqft / Pallet</th><th>Price / Sqft</th></tr></thead>
          <tbody>
            <tr><td>Unfilled / Brushed</td><td>12x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">80</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Unfilled / Brushed</td><td>16x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">106.4</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Unfilled / Honed</td><td>12x24</td><td class="hide-mobile">3cm</td><td class="hide-mobile">120</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Unfilled / Honed</td><td>6x12</td><td class="hide-mobile">3cm</td><td class="hide-mobile">170</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Brushed Eased Edge</td><td>12x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">80</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Brushed Eased Edge</td><td>16x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">106.4</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>2-Side Bull Nose</td><td>16x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">106.4</td><td><span class="stone-price">Call</span></td></tr>
          </tbody>
        </table></div>
      </div>

      <div class="stone-variant">
        <div class="stone-variant-title"><Pic name="Beige.png" class="stone-swatch"   alt="Tuscany Beige Travertine — Tumbled, 3cm swatch" /><span>Tuscany Beige Travertine — Tumbled, 3cm</span></div>
        <div class="stone-sub-label">Pavers</div>
        <div class="ptable-wrap"><table class="ptable">
          <thead><tr><th>Size</th><th class="hide-mobile">Packaging</th><th class="hide-mobile">Sqft / Pallet</th><th>Price / Sqft</th></tr></thead>
          <tbody>
            <tr><td>12x12, 6x12 &amp; 6x6 (kit)</td><td class="hide-mobile">20 Kit</td><td class="hide-mobile">150</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>12x12</td><td class="hide-mobile">166 pcs</td><td class="hide-mobile">166</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>6x12</td><td class="hide-mobile">340 pcs</td><td class="hide-mobile">170</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>6x6</td><td class="hide-mobile">490 pcs</td><td class="hide-mobile">122.5</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>16x24, 16x16, 8x16, 8x8 (kit)</td><td class="hide-mobile">10 Kit</td><td class="hide-mobile">160</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>16x24</td><td class="hide-mobile">60 pcs</td><td class="hide-mobile">159.6</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>12x24</td><td class="hide-mobile">60 pcs</td><td class="hide-mobile">120</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>24x24</td><td class="hide-mobile">34 pcs</td><td class="hide-mobile">136</td><td><span class="stone-price">Call</span></td></tr>
          </tbody>
        </table></div>
        <div class="stone-sub-label">Coping</div>
        <div class="ptable-wrap"><table class="ptable">
          <thead><tr><th>Finish</th><th>Size</th><th class="hide-mobile">Thickness</th><th class="hide-mobile">Sqft / Pallet</th><th>Price / Sqft</th></tr></thead>
          <tbody>
            <tr><td>Unfilled / Brushed</td><td>12x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">80</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Unfilled / Brushed</td><td>16x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">106.4</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Honed</td><td>12x24</td><td class="hide-mobile">3cm</td><td class="hide-mobile">120</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Unfilled / Honed</td><td>12x12</td><td class="hide-mobile">3cm</td><td class="hide-mobile">166</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Brushed Eased Edge</td><td>12x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">80</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Brushed Eased Edge</td><td>16x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">106.4</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>Brushed Eased Edge</td><td>12x24</td><td class="hide-mobile">3cm</td><td class="hide-mobile">120</td><td><span class="stone-price">Call</span></td></tr>
            <tr><td>2-Side Bull Nose</td><td>16x24</td><td class="hide-mobile">2 in</td><td class="hide-mobile">106.4</td><td><span class="stone-price">Call</span></td></tr>
          </tbody>
        </table></div>
