<section class="stone-advantage">
  <div class="container">
    <div class="stone-adv-inner">
      <div data-reveal>
        <div class="section-label inverted">{page.advantage.label}</div>
        <div class="stone-adv-content">
          <h2 set:html={renderInline(page.advantage.heading)} />
          <p set:html={renderInline(page.advantage.body)} />
          <div class="stone-adv-list">
            {page.advantage.bullets.map((bullet) => (
              <div class="stone-adv-item">
                <Icon name="check" size={16} />
                <p set:html={renderInline(bullet)} />
              </div>
            ))}
          </div>
          <a href={page.advantage.cta.link} class="btn btn-primary">{page.advantage.cta.text} <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
      <div class="stone-adv-img" data-reveal>
        <Pic name="stone-other.jpg" alt="Natural stone patio installation" />
      </div>
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">{page.cta.label}</div>
    <h2 set:html={renderInline(page.cta.heading)} />
    <p set:html={renderInline(page.cta.body)} />
    <div class="cta-btns">
      {page.cta.buttons.map((btn) => (
        <a href={btn.link} class={`btn btn-${btn.style}`}>
          {btn.text}
          {btn.style === 'primary' && (
            <Icon name="arrow-right" size={16} />
          )}
        </a>
      ))}
    </div>
  </div>
</section>
<script>
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('revealed'); revealObserver.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));
</script>
