---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
import { renderInline } from '../utils/inline-markdown';
import page from '../data/pages/artificial-turf.json';

// FAQ JSON-LD built from page.faq.items so editors see SEO impact of edits.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Artificial Turf', url: '/artificial-turf' },
];
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
  schema={faqSchema}
  breadcrumbs={breadcrumbs}
>
<style is:global>
/* ─── PAGE HERO ─── */

/* ─── SERIES SECTIONS ─── */
.series-section { padding: 88px 0; }
.series-section:nth-child(even) { background: var(--gray-100); }

.series-inner {
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 60px;
  align-items: start;
}
.series-inner.reverse { grid-template-columns: 1fr 420px; }
.series-inner.reverse .series-img-col { order: 2; }
.series-inner.reverse .series-content { order: 1; }

.series-img-col { position: sticky; top: 100px; }
.series-img-panel {
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  position: relative;
  overflow: hidden;
}
.series-img-panel img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.5s ease; }
.series-img-panel:hover img { transform: scale(1.04) translateY(-4px); }
.series-img-placeholder { background: var(--green-700); border: 2px dashed rgba(255,255,255,0.12); }
.placeholder-label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.25); text-align: center; line-height: 1.6; }

.series-header { margin-bottom: 28px; }
.series-header h2 { font-size: clamp(1.6rem, 2.5vw, 2.2rem); margin-bottom: 10px; }
.series-header p { font-size: 0.95rem; color: var(--gray-600); max-width: 640px; line-height: 1.75; font-weight: 400; text-transform: none; letter-spacing: 0; }

/* Product tables */
.product-table-wrap { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid var(--gray-200); }
.product-table { width: 100%; border-collapse: collapse; background: var(--white); }
.product-table thead { background: var(--green-700); }
.product-table thead th { padding: 14px 20px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.75); text-align: left; }
.product-table thead th:last-child { text-align: right; }
.product-table tbody tr { border-bottom: 1px solid var(--gray-200); transition: background 0.15s; }
.product-table tbody tr:last-child { border-bottom: none; }
.product-table tbody tr:hover { background: var(--gray-100); }
.product-table tbody td { padding: 16px 20px; font-size: 0.9rem; color: var(--dark); vertical-align: middle; }
.product-table tbody td:last-child { text-align: right; }
.product-name { font-weight: 700; color: var(--dark); display: block; }
.product-badge { display: inline-block; margin-top: 4px; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange); background: var(--orange-light); padding: 2px 8px; border-radius: 20px; }
.product-price { font-size: 1.05rem; font-weight: 800; color: var(--green-700); white-space: nowrap; }
.product-price-sub { display: block; font-size: 0.7rem; font-weight: 500; color: var(--gray-400); text-transform: uppercase; letter-spacing: 0.06em; }
.color-dot { display: inline-flex; align-items: center; gap: 7px; font-size: 0.85rem; }
.color-dot::before { content: ''; display: block; width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.color-emerald::before { background: #4a9a3a; }
.color-olive::before   { background: #7a8a3a; }
.color-billow::before  { background: #3a8a4a; }
.color-notify::before  { background: #5a9a6a; }

/* Wholesale banner */
.wholesale-banner { background: var(--dark); border-radius: var(--radius-lg); padding: 28px 36px; margin-top: 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.wholesale-banner p { font-size: 0.875rem; color: rgba(255,255,255,0.65); line-height: 1.5; font-weight: 400; text-transform: none; letter-spacing: 0; }
.wholesale-banner strong { display: block; font-size: 0.95rem; font-weight: 800; color: var(--white); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; }


/* ─── WHY WE LOVE SECTION ─── */
.why-love {
  padding: 88px 0;
  background: var(--white);
}
.why-love-header {
  text-align: center;
  margin-bottom: 56px;
}
.why-love-header h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  font-weight: 800;
  text-transform: none;
  letter-spacing: -0.02em;
}
.why-love-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}
.why-love-item {
  text-align: center;
}
.why-love-icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  
}
.why-love-icon svg { width: 32px; height: 32px; color: var(--green-700); }

.why-love-logo {
  max-width: 160px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}
.why-love-logo img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.why-love-item h4 {
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--dark);
  margin-bottom: 10px;
}
.why-love-item p {
  font-size: 0.85rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  max-width: 280px;
  margin: 0 auto;
}
@media (max-width: 768px) {
  .why-love-grid { grid-template-columns: 1fr 1fr; gap: 32px 20px; }
  .why-love { padding: 30px 0; }
}
@media (max-width: 480px) {
  .why-love-grid { grid-template-columns: 1fr; gap: 36px; }
}

/* ─── AZ DIFFERENCE ─── */
.az-difference { padding: 88px 0; position: relative; overflow: hidden; }
.az-difference::before { content: ''; position: absolute; inset: 0; background: url('/media/winter-blend-2.jpg') center / cover no-repeat; z-index: 0; }
.az-difference::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.7); z-index: 1; }
.az-diff-header { text-align: center; margin-bottom: 48px; position: relative; z-index: 2; }
.az-diff-header .section-label { justify-content: center; color: var(--green-700); }
.az-diff-header .section-label::before { background: var(--green-700); }
.az-diff-header h2 { color: var(--white); font-size: clamp(1.9rem, 3vw, 2.8rem); }
.az-diff-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; position: relative; z-index: 2; }
.diff-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); padding: 32px 28px; transition: all 0.3s; }
.diff-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-3px); }
.diff-icon { width: 48px; height: 48px;   display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
.diff-icon svg { width: 28px; height: 28px; color: var(--green-700); }
.diff-card h4 { font-size: 0.95rem; color: var(--white); margin-bottom: 8px; letter-spacing: 0.04em; }
.diff-card p { font-size: 0.875rem; color: rgba(255,255,255,0.62); line-height: 1.65; font-weight: 400; text-transform: none; letter-spacing: 0; }

/* ─── FAQ ─── */
.faq-section { padding: 88px 0; background: var(--white); }
.faq-header { text-align: center; margin-bottom: 48px; }
.faq-header h2 { font-size: clamp(1.9rem, 3vw, 2.8rem); }
.faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 960px; margin: 0 auto; }
.faq-item { background: var(--gray-100); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid rgba(0,0,0,0.05); }
.faq-q { width: 100%; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; text-align: left; font-family: 'Montserrat', sans-serif; font-size: 0.85rem; font-weight: 700; color: var(--dark); letter-spacing: 0.02em; text-transform: uppercase; transition: color 0.2s; }
.faq-q:hover { color: var(--green-700); }
.faq-q:focus { outline: none; }
.faq-q svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--green-700); transition: transform 0.3s; }
.faq-item.open .faq-q svg { transform: rotate(180deg); }
.faq-a { max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.3s ease; padding: 0 24px; }
.faq-item.open .faq-a { max-height: 300px; padding: 0 24px 20px; }
.faq-a p { font-size: 0.875rem; color: var(--gray-600); line-height: 1.7; font-weight: 400; text-transform: none; letter-spacing: 0; border-top: 1px solid var(--gray-200); padding-top: 16px; }

/* ─── CTA ─── */
.cta-section { padding: 88px 0; background: linear-gradient(135deg, var(--dark) 0%, var(--dark-800) 50%, var(--green-900) 100%); text-align: center; position: relative; overflow: hidden; }
.cta-section::before { content: ''; position: absolute; top: -80px; left: -80px; width: 320px; height: 320px; background: radial-gradient(circle, rgba(35,155,43,0.12) 0%, transparent 70%); }
.cta-section::after  { content: ''; position: absolute; bottom: -80px; right: -80px; width: 320px; height: 320px; background: radial-gradient(circle, rgba(86,155,48,0.15) 0%, transparent 70%); }
.cta-inner { position: relative; z-index: 2; }
.cta-section h2 { font-size: clamp(1.9rem, 3vw, 2.8rem); color: var(--white); margin-bottom: 16px; }
.cta-section p { font-size: 0.95rem; color: rgba(255,255,255,0.68); margin-bottom: 36px; max-width: 540px; margin-left: auto; margin-right: auto; line-height: 1.75; font-weight: 400; text-transform: none; letter-spacing: 0; }
.cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .series-inner, .series-inner.reverse { grid-template-columns: 1fr; gap: 32px; }
  .series-inner.reverse .series-img-col { order: 0; }
  .series-inner.reverse .series-content { order: 0; }
  .series-img-col { position: static; }
  .series-img-panel { aspect-ratio: 4/3; }
  .az-diff-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .product-table thead th:nth-child(3), .product-table tbody td:nth-child(3) { display: none; }
  .az-diff-grid { grid-template-columns: 1fr; }
  .faq-grid { grid-template-columns: 1fr; }
  .series-img-panel { aspect-ratio: 1/1; max-height: 280px; }
}
@media (max-width: 480px) {
  .product-table thead th:nth-child(2), .product-table tbody td:nth-child(2) { display: none; }
}


@media (max-width: 768px) {
  /* ── .diff-card grouped list (mobile) ── */
  .az-diff-grid .diff-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 12px;
    padding: 14px 18px;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    box-shadow: none;
    transform: none;
    background: rgba(255,255,255,0.06);
    transition: none;
  }
  .az-diff-grid .diff-card:first-child { border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .az-diff-grid .diff-card:last-child  { border-radius: 0 0 var(--radius-lg) var(--radius-lg); border-bottom: none; }
  .az-diff-grid .diff-card:hover { transform: none; box-shadow: none; }
  .az-diff-grid .diff-card:hover { background: rgba(255,255,255,0.06); }
  .az-diff-grid .diff-icon { width: 36px; height: 36px; min-width: 36px; margin-bottom: 0; flex-shrink: 0; border-radius: 8px; }
  .az-diff-grid .diff-card h4 { flex: 1; margin-bottom: 0; font-size: 0.85rem; }
  .az-diff-grid .diff-card p  { width: 100%; padding-top: 5px; padding-left: 48px; font-size: 0.78rem; color: rgba(255,255,255,0.62); }
}

@media (max-width: 768px) {
  .az-diff-grid {
    grid-template-columns: 1fr;
    gap: 0;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255,255,255,0.12);
    overflow: visible;
  }
  .product-table thead th { padding: 10px 12px; font-size: 0.65rem; }
  /* Badge: stay inline, don't force new line, smaller */
  .product-badge {
    display: inline;
    font-size: 0.58rem;
    padding: 1px 5px;
    margin-left: 4px;
    white-space: nowrap;
    vertical-align: middle;
  }
  /* Name stays on one line if possible */
  .product-name { display: inline; }
  /* Price column tighter */
  .product-price { font-size: 0.9rem; }
  .product-price-sub { font-size: 0.62rem; }
}

@media (max-width: 768px) {
  .product-table tbody td { padding: 10px 12px; font-size: 0.82rem; }
  .product-table thead th { padding: 10px 12px; font-size: 0.65rem; }
  .product-badge {
    display: block;
    font-size: 0.58rem;
    padding: 2px 6px;
    margin-top: 4px;
    margin-left: 0;
    width: fit-content;
  }
  .product-name { display: block; }
  .product-price { font-size: 0.9rem; }
  .product-price-sub { font-size: 0.62rem; }
}

@media (max-width: 768px) {
  /* Hide Color column — not enough room */
  .product-table thead th:nth-child(4),
  .product-table tbody td:nth-child(4) { display: none; }
}

/* ─── PRODUCT CARDS ─── */
.products-cards-section { padding: 88px 0; background: var(--gray-100); }

.turf-note {
  text-align: center;
  font-size: 0.85rem;
  color: var(--gray-400);
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 40px;
  padding: 10px 24px;
  background: var(--white);
  border-radius: 50px;
  display: inline-block;
  left: 50%;
  transform: translateX(-50%);
  position: relative;
  border: 1px solid var(--gray-200);
  line-height: 1.6;
}

.turf-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.turf-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.05);
  transition: transform 0.3s, box-shadow 0.3s;
  display: flex;
  flex-direction: column;
}
.turf-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }

/* Image area */
.turf-card-img {
  position: relative;
  background: var(--white);
  aspect-ratio: 4/3;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: zoom-in;
}
.turf-card-img img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 16px;
  transition: transform 0.4s ease;
}
.turf-card:hover .turf-card-img img { transform: scale(1.04); }
.turf-card-mag {
  position: absolute;
  bottom: 12px;
  right: 12px;
  width: 36px;
  height: 36px;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.turf-card:hover .turf-card-mag { opacity: 1; }
.turf-card-mag svg { width: 16px; height: 16px; color: var(--white); }

/* Turf Lightbox */
.turf-lightbox {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.92);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 40px;
  cursor: zoom-out;
}
.turf-lightbox.open { display: flex; }
.turf-lightbox img {
  max-width: 90%;
  max-height: 85vh;
  border-radius: var(--radius-lg);
  object-fit: contain;
}
.turf-lightbox-close {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 44px;
  height: 44px;
  background: rgba(255,255,255,0.1);
  border: none;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.turf-lightbox-close:hover { background: rgba(255,255,255,0.2); }
.turf-lightbox-close svg { width: 20px; height: 20px; color: var(--white); }

.turf-card-img--placeholder {
  background: var(--green-700);
  flex-direction: column;
  gap: 8px;
}
.turf-card-img--placeholder span:first-child {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.35);
  text-align: center;
  line-height: 1.6;
}

/* Badge in image corner */
.turf-card-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  
  color: var(--white);
  padding: 4px 10px;
  border-radius: 20px;
  white-space: nowrap;
  z-index: 2;
}
.turf-card-badge--popular {
  
}
.turf-card-badge--green {
  background: var(--green-700);
}

/* Dark name bar */
.turf-card-name {
  background: var(--dark);
  color: var(--white);
  font-size: 0.9rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 14px 20px;
  line-height: 1.2;
}

/* Body */
.turf-card-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 16px;
}

/* Specs 2-col grid */
.turf-specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 12px;
}
.turf-spec {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.turf-spec span {
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--gray-400);
}
.turf-spec strong {
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--dark);
  text-transform: none;
  letter-spacing: 0;
}

/* Price + CTA row */
.turf-card-footer {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: 16px;
  border-top: 1px solid var(--gray-100);
  margin-top: auto;
}
.turf-card-footer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.turf-price {
  font-size: 1.4rem;
  font-weight: 900;
  color: var(--green-700);
  letter-spacing: -0.02em;
  line-height: 1;
}
.turf-price span {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--gray-400);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.turf-card-btns {
  display: flex;
  gap: 8px;
}
.turf-card-btns .btn {
  flex: 1;
  padding: 10px 16px;
  font-size: 0.78rem;
  border-radius: 50px;
  white-space: nowrap;
  text-align: center;
  justify-content: center;
}
.turf-card-footer .btn {
  padding: 10px 20px;
  font-size: 0.8rem;
  border-radius: 50px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Responsive */
@media (max-width: 1024px) {
  .turf-cards-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .turf-cards-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .turf-card-name { font-size: 0.75rem; padding: 10px 14px; }
  .turf-card-body { padding: 14px; gap: 12px; }
  .turf-specs { gap: 6px 10px; }
  .turf-spec span { font-size: 0.58rem; }
  .turf-spec strong { font-size: 0.75rem; }
  .turf-price { font-size: 1.1rem; }
  .turf-card-footer .btn { padding: 10px 14px; font-size: 0.78rem; }
  .turf-card-btns {
    flex-direction: column;
    gap: 8px;
  }
  .turf-card-btns .btn {
    width: 100%;
    padding: 10px 14px;
    font-size: 0.78rem;
  }
  .turf-card-footer { padding-top: 12px; }
}
@media (max-width: 400px) {
  .turf-cards-grid { grid-template-columns: 1fr; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{page.hero.eyebrow}</div>
      <h1 set:html={renderInline(page.hero.heading)} />
      <p>{page.hero.body}</p>
      <div class="page-hero-btns">
        <a href={page.hero.ctaPrimary.link} class="btn btn-primary">{page.hero.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
        <a href={page.hero.ctaSecondary.link} class="btn btn-outline">{page.hero.ctaSecondary.text}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    {page.statBar.map((item) => (
      <div class="stat-item">
        <div class="stat-num">{item.value}</div>
        <div class="stat-label">{item.label}</div>
      </div>
    ))}
  </div>
</div>

<!-- ═══ PRODUCT SERIES ═══ -->
<div id="products">

<!-- ═══ PRODUCT CARDS ═══ -->
<section class="products-cards-section">
  <div class="container">
    <div class="section-header centered" style="margin-bottom:32px;">
      <div class="section-label centered">{page.products.label}</div>
      <h2 set:html={renderInline(page.products.heading)} />
      <p set:html={renderInline(page.products.body)} />
    </div>

    <div class="turf-note">{page.products.note}</div>

    <div class="turf-cards-grid">
      {page.products.cards.map((card) => (
        <div class="turf-card">
          <div class="turf-card-img">
            <div class="turf-card-mag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></div>
            <Pic name={card.image} alt={card.alt} />
            {card.badge && (
              <span class={`turf-card-badge${card.badge.style ? ` turf-card-badge--${card.badge.style}` : ''}`}>{card.badge.text}</span>
            )}
          </div>
          <div class="turf-card-name">{card.name}</div>
          <div class="turf-card-body">
            <div class="turf-specs">
              <div class="turf-spec"><span>Face Weight</span><strong>{card.faceWeight}</strong></div>
              <div class="turf-spec"><span>Pile Height</span><strong>{card.pileHeight}</strong></div>
              <div class="turf-spec"><span>Color</span><strong>{card.color}</strong></div>
              <div class="turf-spec"><span>Roll Width</span><strong>{card.rollWidth}</strong></div>
            </div>
            <div class="turf-card-footer">
              <div class="turf-card-footer-top">
                <div class="turf-price">{card.price} <span>{card.priceUnit}</span></div>
              </div>
              <div class="turf-card-btns">
                <a href={card.detailsLink} class="btn btn-dark">More Details</a>
                <a href="/contact" class="btn btn-primary">Get a Quote</a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


</div><!-- end #products -->

<!-- ═══ TESTIMONIALS ═══ -->
<section class="testimonials">
  <div class="container">
    <div class="testimonials-header">
      <div class="section-label centered">{page.testimonials.label}</div>
      <h2 set:html={renderInline(page.testimonials.heading)} />
    </div>
    <Testimonials />
    <div class="testimonials-cta" data-reveal>
      <a href={page.testimonials.ctaLink}>{page.testimonials.ctaText} <Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</section>


<!-- ═══ WHY WE LOVE ═══ -->
<section class="why-love">
  <div class="container">
    <div class="why-love-header">
      <div class="section-label centered">{page.whyLove.label}</div>
      <h2 set:html={renderInline(page.whyLove.heading)} />
    </div>
    <div class="why-love-grid">
      {page.whyLove.items.map((item) => (
        <div class="why-love-item" data-reveal>
          <div class="why-love-logo">
            <Pic name={item.logo} alt={item.alt} />
          </div>
          <p set:html={renderInline(item.body)} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ AZ DIFFERENCE ═══ -->
<section class="az-difference">
  <div class="container">
    <div class="az-diff-header">
      <div class="section-label">{page.azDifference.label}</div>
      <h2 set:html={renderInline(page.azDifference.heading)} />
    </div>
    <div class="az-diff-grid">
      {page.azDifference.items.map((item) => (
        <div class="diff-card" data-reveal>
          <div class="diff-icon"><Icon name={item.icon as any} size={28} /></div>
          <h4 set:html={renderInline(item.heading)} />
          <p set:html={renderInline(item.body)} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ FAQ ═══ -->
<section class="faq-section">
  <div class="container">
    <div class="faq-header">
      <div class="section-label centered">{page.faq.label}</div>
      <h2 set:html={renderInline(page.faq.heading)} />
    </div>
    <div class="faq-grid">
      {page.faq.items.map((item) => (
        <div class="faq-item" data-reveal>
          <button class="faq-q" onclick="toggleFaq(this)">{item.question}<Icon name="chevron-down" size={16} /></button>
          <div class="faq-a"><p set:html={renderInline(item.answer)} /></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section" id="contact">
  <div class="container cta-inner">
    <div class="section-label centered inverted">{page.cta.label}</div>
    <h2 set:html={renderInline(page.cta.heading)} />
    <p set:html={renderInline(page.cta.body)} />
    <div class="cta-btns">
      {page.cta.buttons.map((btn) => (
        <a href={btn.link} class={`btn btn-${btn.style}`}>
          {btn.text}
          {btn.style === 'primary' && (
            <Icon name="phone" size={16} />
          )}
        </a>
      ))}
    </div>
    <p style="margin-top:24px; font-size:0.8rem; color:rgba(255,255,255,0.45);">{page.cta.footnote}</p>
  </div>
</section>

<script>
function toggleFaq(btn) {
  const item = btn.parentElement;
  const wasOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
  if (!wasOpen) item.classList.add('open');
}
(window as any).toggleFaq = toggleFaq;

// scroll reveal handled by Layout.astro

// ─── TURF IMAGE LIGHTBOX ───
document.querySelectorAll('.turf-card-img').forEach(function(cardImg) {
  cardImg.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    var img = this.querySelector('img');
    if (!img) return;
    var lb = document.createElement('div');
    lb.className = 'turf-lightbox open';
    lb.innerHTML = '<button class="turf-lightbox-close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button><img src="' + img.src + '" alt="' + (img.alt || '') + '" loading="lazy" decoding="async">';
    lb.addEventListener('click', function(ev) { if (ev.target === lb || ev.target.closest('.turf-lightbox-close')) lb.remove(); });
    document.body.appendChild(lb);
    document.addEventListener('keydown', function handler(ev) { if (ev.key === 'Escape') { lb.remove(); document.removeEventListener('keydown', handler); } });
  });
});
</script>
</Layout>
