---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await post.render();

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://azturfsuppliers.com';
const pageUrl = `${siteUrl}/blog/${post.slug}/`;
const monthYear = post.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(post.data.image, siteUrl).toString(),
  datePublished: post.data.date.toISOString().slice(0, 10),
  dateModified: (post.data.dateModified ?? post.data.date).toISOString().slice(0, 10),
  author: { '@type': 'Organization', name: site.name },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: new URL('/media/logo.png', siteUrl).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
};

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: post.data.title, url: `/blog/${post.slug}/` },
];
---

<Layout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.image}
  schema={articleSchema}
  breadcrumbs={breadcrumbs}
>
<style is:global define:vars={{ heroImage: `url("${post.data.image}")` }}>
.page-hero::before { background-image: var(--heroImage) !important; }

.article { padding: 72px 0 88px; background: var(--white); }
.article-inner { max-width: 760px; margin: 0 auto; }
.article-meta {
  display: flex; gap: 12px; align-items: center;
  font-size: 0.72rem; font-weight: 700; color: var(--green-700);
  text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 16px;
}
.article-meta .dot { color: var(--gray-400); }
.article-meta .read { color: var(--gray-600); font-weight: 500; letter-spacing: 0.04em; }
.article h1 {
  font-size: clamp(2rem, 4vw, 3rem); line-height: 1.15; margin-bottom: 20px;
  color: var(--dark); letter-spacing: -0.01em;
}
.article-lede {
  font-size: 1.15rem; line-height: 1.65; color: var(--gray-700);
  margin-bottom: 40px; font-weight: 400; text-transform: none; letter-spacing: 0;
}
.article-hero-img {
  margin: 0 0 48px; border-radius: var(--radius-lg); overflow: hidden;
  aspect-ratio: 16/9; background: var(--gray-100); box-shadow: var(--shadow-lg);
}
.article-hero-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
.article-body h2 {
  font-size: 1.6rem; line-height: 1.25; margin: 56px 0 16px;
  color: var(--dark); letter-spacing: -0.005em; scroll-margin-top: 100px;
}
.article-body h3 {
  font-size: 1.15rem; line-height: 1.35; margin: 36px 0 12px;
  color: var(--dark); letter-spacing: 0;
}
.article-body p, .article-body li {
  font-size: 1rem; line-height: 1.75; color: var(--gray-700);
  font-weight: 400; text-transform: none; letter-spacing: 0;
}
.article-body p { margin-bottom: 18px; }
.article-body ul, .article-body ol {
  margin: 0 0 18px; padding-left: 22px;
  display: flex; flex-direction: column; gap: 8px;
}
.article-body strong { color: var(--dark); font-weight: 700; }
.article-body a { color: var(--green-700); font-weight: 600; border-bottom: 1px solid currentColor; }
.article-body a:hover { color: var(--green-800); }
.callout {
  background: var(--gray-100); border-left: 4px solid var(--green-700);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  padding: 24px 28px; margin: 32px 0;
}
.callout-title {
  font-size: 0.72rem; font-weight: 800; color: var(--green-700);
  text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 8px;
}
.callout p { margin-bottom: 0; font-size: 0.95rem; }
.callout.warning { background: #fff8ed; border-left-color: var(--orange); }
.callout.warning .callout-title { color: var(--orange); }
.toc { background: var(--gray-100); border-radius: var(--radius-lg); padding: 24px 28px; margin: 0 0 48px; }
.toc-title {
  font-size: 0.72rem; font-weight: 800; color: var(--gray-600);
  text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 12px;
}
.toc ol {
  list-style: decimal; padding-left: 20px; margin: 0;
  display: flex; flex-direction: column; gap: 6px;
}
.toc a { font-size: 0.92rem; color: var(--dark); font-weight: 500; border-bottom: none; }
.toc a:hover { color: var(--green-700); }
.spec-table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 0.92rem; }
.spec-table th, .spec-table td {
  text-align: left; padding: 12px 16px;
  border-bottom: 1px solid var(--gray-200); color: var(--gray-700);
}
.spec-table th {
  background: var(--gray-100); color: var(--dark); font-weight: 700;
  font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em;
}
.spec-table tr:last-child td { border-bottom: none; }
.post-cta {
  margin-top: 56px; padding: 36px 32px; background: var(--dark);
  border-radius: var(--radius-lg); text-align: center; color: var(--white);
}
.post-cta h3 { color: var(--white); font-size: 1.4rem; margin-bottom: 10px; }
.post-cta p {
  color: rgba(255,255,255,0.65); font-size: 0.95rem; margin-bottom: 24px;
  max-width: 460px; margin-left: auto; margin-right: auto;
}
.post-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
@media (max-width: 640px) {
  .article-hero-img { aspect-ratio: 4/3; margin-bottom: 32px; }
  .article-body h2 { font-size: 1.35rem; margin-top: 40px; }
  .toc { padding: 20px; }
  .post-cta { padding: 28px 20px; }
}
</style>

<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{post.data.category}</div>
      <h1>{post.data.title}</h1>
    </div>
  </div>
</section>

<article class="article">
  <div class="container">
    <div class="article-inner">
      <div class="article-meta">
        <span>{post.data.category}</span>
        <span class="dot">·</span>
        <span class="read">{monthYear} · {post.data.readTime}</span>
      </div>
      <p class="article-lede">{post.data.lede}</p>

      <div class="article-hero-img">
        <img src={post.data.image} alt={post.data.imageAlt} loading="eager" decoding="async" />
      </div>

      <div class="article-body">
        <Content />

        <div class="post-cta">
          <h3>Need help with your project?</h3>
          <p>Whether you're a homeowner doing your first install or a contractor running 20 jobs a month, we have the inventory and the answers. Stop by our Queen Creek showroom or text us your measurements.</p>
          <div class="post-cta-btns">
            <a href={`tel:${site.phone_tel}`} class="btn btn-primary">Call or Text {site.phone} <Icon name="phone" size={16} /></a>
            <a href="/turf-calculator/" class="btn btn-outline">Use the Turf Calculator</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
</Layout>
