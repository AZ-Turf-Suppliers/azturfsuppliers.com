<script>
// ─── HOME CONTACT FORM ───
document.getElementById('home-contact-form')?.addEventListener('submit', async function (e) {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const btn = document.getElementById('home-submit-btn') as HTMLButtonElement;
  const status = document.getElementById('home-form-status') as HTMLElement;

  btn.disabled = true;
  btn.textContent = 'Sending…';
  status.style.display = 'none';

  try {
    const res = await fetch('https://formspree.io/f/mdabkzde', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(form),
    });
    const json = await res.json();
    if (res.ok && json.ok) {
      status.style.display = 'block';
      status.style.background = '#e8f7e9';
      status.style.color = '#186b1e';
      status.textContent = "Message sent! We'll be in touch same day.";
      form.reset();
    } else {
      throw new Error(json.error ?? 'Unknown error');
    }
  } catch {
    status.style.display = 'block';
    status.style.background = '#fff0f0';
    status.style.color = '#c0392b';
    status.textContent = 'Something went wrong. Please call us at 480-739-3854.';
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Send Message <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
  }
});
</script>

<script>
// ─── TICKER ───
(function() {
  const items = [
    { icon: '✦', text: 'Price Match Guarantee' },
    { icon: '✦', text: 'Next Day Delivery Guarantee' },
    { icon: '✦', text: '15-Minute In-Store Pickup' },
    { icon: '✦', text: 'Nationwide Shipping Available' },
    { icon: '✦', text: '15-Year Manufacturer Warranty' },
    { icon: '✦', text: '100% Pet Friendly & Lead-Free' },
  ];

  const track = document.getElementById('ticker-track');
  if (!track) return;

  // Build three sets for seamless loop
  const set = items.map(item =>
    `<span class="ticker-item">${item.text}</span><span class="ticker-sep">✦</span>`
  ).join('');
  const html = set + set + set;

  track.innerHTML = html;
})();

// scroll reveal handled by Layout.astro;

// Accordion toggle
function toggleBenefit(btn) {
  const item = btn.parentElement;
  const wasActive = item.classList.contains('active');
  document.querySelectorAll('.benefit-item').forEach(i => i.classList.remove('active'));
  if (!wasActive) item.classList.add('active');
}
(window as any).toggleBenefit = toggleBenefit;
</script>
<script>
// ─── REVIEW CAROUSEL DOTS (mobile) ───
(function() {
  function initCarousels() {
    document.querySelectorAll('.reviews-grid').forEach(function(grid) {
      var cards = grid.querySelectorAll('.review-card');
      if (cards.length < 2) return;

      // Only show dots on mobile
      if (window.innerWidth > 768) return;

      // Build dots container
      var dotsWrap = document.createElement('div');
      dotsWrap.className = 'reviews-dots';
      cards.forEach(function(_, i) {
        var dot = document.createElement('button');
        dot.className = 'reviews-dot' + (i === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Review ' + (i + 1));
        dot.addEventListener('click', function() {
          cards[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        });
        dotsWrap.appendChild(dot);
      });
      grid.parentNode.insertBefore(dotsWrap, grid.nextSibling);

      // Update active dot on scroll
      var dots = dotsWrap.querySelectorAll('.reviews-dot');
      var ticking = false;
      grid.addEventListener('scroll', function() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function() {
          var scrollLeft = grid.scrollLeft;
          var cardWidth = cards[0].offsetWidth + 16; // gap
          var idx = Math.round(scrollLeft / cardWidth);
          idx = Math.max(0, Math.min(idx, dots.length - 1));
          dots.forEach(function(d, i) {
            d.classList.toggle('active', i === idx);
          });
          ticking = false;
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousels);
  } else {
    initCarousels();
  }
})();

</script>
