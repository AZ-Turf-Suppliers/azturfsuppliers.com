<script>
// ─── HOME CONTACT FORM ───
async function handleHomeFormSubmit(e: Event) {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const btn = document.getElementById('home-submit-btn') as HTMLButtonElement;
  const status = document.getElementById('home-form-status') as HTMLElement;

  btn.disabled = true;
  btn.textContent = 'Sending…';
  status.style.display = 'none';

  try {
    const res = await fetch('https://formspree.io/f/mdabkzde', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(form),
    });
    const json = await res.json();
    if (res.ok && json.ok) {
      status.style.display = 'block';
      status.style.background = '#e8f7e9';
      status.style.color = '#186b1e';
      status.textContent = "Message sent! We'll be in touch same day.";
      form.reset();
    } else {
      throw new Error(json.error ?? 'Unknown error');
    }
  } catch {
    status.style.display = 'block';
    status.style.background = '#fff0f0';
    status.style.color = '#c0392b';
    status.textContent = 'Something went wrong. Please call us at 480-793-1800.';
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Send Message <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 11h11.586l-4.293-4.293 1.414-1.414L20.414 12l-6.707 6.707-1.414-1.414L16.586 13H5z"/></svg>';
  }
}

function initHomeForm() {
  const form = document.getElementById('home-contact-form');
  if (!form) return;
  form.removeEventListener('submit', handleHomeFormSubmit);
  form.addEventListener('submit', handleHomeFormSubmit);
}
initHomeForm();
document.addEventListener('astro:page-load', initHomeForm);
</script>

<script>
// ─── YOUTUBE HERO FACADE ───
// The hero shows a fallback image immediately. The iframe is injected after the
// page is idle so it doesn't block LCP / compete with critical resources.
function initHeroVideoFacade() {
  const wrap = document.querySelector<HTMLElement>('.hero-video-wrap[data-youtube-id]');
  if (!wrap || wrap.querySelector('iframe')) return;
  const id = wrap.dataset.youtubeId;
  if (!id) return;

  const inject = () => {
    if (wrap.querySelector('iframe')) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&iv_load_policy=3&disablekb=1`;
    iframe.title = 'AZ Turf Suppliers';
    iframe.setAttribute('allow', 'autoplay; encrypted-media');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('loading', 'lazy');
    wrap.appendChild(iframe);
  };

  if ('requestIdleCallback' in window) {
    (window as any).requestIdleCallback(inject, { timeout: 2500 });
  } else {
    setTimeout(inject, 1500);
  }
}
initHeroVideoFacade();
document.addEventListener('astro:page-load', initHeroVideoFacade);

// Accordion toggle — set once at module scope, survives navigations
function toggleBenefit(btn: HTMLElement) {
  const item = btn.parentElement;
  const wasActive = item?.classList.contains('active');
  document.querySelectorAll('.benefit-item').forEach(i => i.classList.remove('active'));
  if (!wasActive) item?.classList.add('active');
}
(window as any).toggleBenefit = toggleBenefit;
</script>
</Layout>
