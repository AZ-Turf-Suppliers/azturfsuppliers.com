---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import { renderInline } from '../utils/inline-markdown';
import page from '../data/pages/accessories.json';

const btnClass = (style: string) => {
  if (style === 'primary') return 'btn btn-primary';
  if (style === 'dark') return 'btn btn-dark';
  return 'btn btn-outline';
};
---

<Layout
  title={page.meta.title}
  description={page.meta.description}
>
<style is:global>
.page-hero::before { background-image: url("/media/accessories-hero.jpg") !important; }
.acc-section { padding: 88px 0; background: var(--white); }
.acc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 48px; }
.acc-card {
  background: var(--gray-100); border: 1px solid var(--gray-200);
  border-radius: var(--radius-lg); overflow: hidden;
  display: flex; flex-direction: column; transition: transform 0.3s, box-shadow 0.3s;
}
.acc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); background: var(--white); }
.acc-img {
  aspect-ratio: 1; background: var(--white);
  display: flex; align-items: center; justify-content: center;
  padding: 20px; border-bottom: 1px solid var(--gray-200);
}
.acc-img img { width: 100%; height: 100%; object-fit: contain; display: block; }
.acc-body { padding: 20px 20px 18px; display: flex; flex-direction: column; flex: 1; gap: 8px; }
.acc-name { font-size: 0.88rem; font-weight: 700; color: var(--dark); letter-spacing: 0.01em; line-height: 1.3; }
.acc-desc {
  font-size: 0.8rem; color: var(--gray-600); line-height: 1.6;
  font-weight: 400; text-transform: none; letter-spacing: 0; flex: 1;
}
.acc-price { font-size: 1.1rem; font-weight: 800; color: var(--green-700); margin-top: 4px; }
.acc-note {
  background: var(--gray-100); border-left: 3px solid var(--green-700);
  border-radius: var(--radius); padding: 14px 20px;
  font-size: 0.85rem; color: var(--gray-600);
  font-weight: 400; text-transform: none; letter-spacing: 0; margin-top: 48px;
}
.acc-note a { color: var(--green-700); font-weight: 600; }
@media (max-width: 1024px) { .acc-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 768px)  { .acc-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } .acc-section { padding: 30px 0; } }
@media (max-width: 480px)  { .acc-grid { grid-template-columns: 1fr; } }
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{page.hero.eyebrow}</div>
      <h1 set:html={renderInline(page.hero.heading)} />
      <p>{page.hero.body}</p>
      <div class="page-hero-btns">
        <a href={page.hero.ctaPrimary.link} class="btn btn-primary">{page.hero.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
        <a href={page.hero.ctaSecondary.link} class="btn btn-outline">{page.hero.ctaSecondary.text}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PRODUCTS ═══ -->
<section class="acc-section">
  <div class="container">
    <div class="section-header centered" data-reveal>
      <div class="section-label centered">{page.products.label}</div>
      <h2 set:html={renderInline(page.products.heading)} />
      <p set:html={renderInline(page.products.body)} />
    </div>

    <div class="acc-grid">
      {page.products.items.map((p) => (
        <div class="acc-card" data-reveal>
          <div class="acc-img">
            <Pic name={p.image} alt={p.name} loading="lazy" />
          </div>
          <div class="acc-body">
            <div class="acc-name">{p.name}</div>
            <div class="acc-desc" set:html={renderInline(p.description)} />
            <div class="acc-price">{p.price}</div>
          </div>
        </div>
      ))}
    </div>

    <p class="acc-note" set:html={renderInline(page.products.note)} />
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">{page.cta.label}</div>
    <h2 set:html={renderInline(page.cta.heading)} />
    <p set:html={renderInline(page.cta.body)} />
    <div class="cta-btns">
      {page.cta.buttons.map((btn) => (
        <a href={btn.link} class={btnClass(btn.style)}>
          {btn.text}
          {btn.style === 'primary' && (
            <Icon name="phone" size={16} />
          )}
        </a>
      ))}
    </div>
  </div>
</section>
</Layout>
