---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
---

<Layout title="DIY Homeowners | AZ Turf Suppliers — Queen Creek, AZ">
<style is:global>
.page-hero::before { background-image: url("/media/natural-series-turf-3.jpg") !important; }
/* ─── PAGE HERO ─── */

/* ─── WHY TURF ─── */
.why-turf {
  padding: 88px 0;
  background: var(--white);
}
.why-turf-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.why-turf-content h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 20px;
}
.why-turf-content > p {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 32px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.why-list { display: flex; flex-direction: column; gap: 16px; }
.why-item { display: flex; gap: 16px; align-items: flex-start; }
.why-item-icon {
  width: 44px;
  height: 44px;

  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.why-item-icon svg { width: 28px; height: 28px; color: var(--green-700); }
.why-item h4 { font-size: 0.95rem; color: var(--dark); margin-bottom: 4px; letter-spacing: 0.02em; }
.why-item p {
  font-size: 0.875rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.why-turf-img {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/5;
  background: var(--green-700);
  position: relative;
}
.why-turf-img img { width: 100%; height: 100%; object-fit: cover; }
.why-turf-img-placeholder {
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.2);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* ─── CHOOSING GUIDE ─── */
.choosing-guide {
  padding: 88px 0;
  background: var(--gray-100);
}
.choosing-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}
.choosing-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 32px 28px;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.04);
  position: relative;
  overflow: hidden;
}
.choosing-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
}
.choosing-card.high-traffic::before { background: var(--green-700); }
.choosing-card.low-traffic::before { background: var(--green-700); }
.choosing-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 4px 12px;
  border-radius: 20px;
  margin-bottom: 16px;
}
.high-traffic .choosing-tag { background: var(--orange-light); color: var(--orange); }
.low-traffic .choosing-tag { background: var(--gray-100); color: var(--green-700); }
.choosing-card h3 { font-size: 1.1rem; color: var(--dark); margin-bottom: 10px; letter-spacing: 0.02em; }
.choosing-card > p {
  font-size: 0.875rem;
  color: var(--gray-600);
  line-height: 1.65;
  margin-bottom: 20px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.choosing-specs { display: flex; gap: 12px; flex-wrap: wrap; }
.spec-chip { background: var(--gray-100); border-radius: 8px; padding: 8px 14px; text-align: center; }
.spec-chip-val { display: block; font-size: 1rem; font-weight: 900; color: var(--dark); line-height: 1.1; }
.spec-chip-label { font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gray-400); }
.choosing-note {
  background: var(--gray-100);
  border-radius: var(--radius);
  padding: 16px 20px;
  font-size: 0.875rem;
  color: var(--green-700);
  line-height: 1.6;
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.choosing-note svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; color: var(--green-700); }

/* ─── PRODUCT TABLE ─── */
.products-section {
  padding: 88px 0;
  background: var(--white);
}
.products-note {
  background: var(--gray-100);
  border-radius: var(--radius);
  padding: 14px 20px;
  font-size: 0.85rem;
  color: var(--gray-600);
  margin-bottom: 32px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  border-left: 3px solid var(--green-700);
}
.series-block { margin-bottom: 40px; }
.series-block:last-child { margin-bottom: 0; }
.series-block h3 {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--green-700);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.series-block h3::before {
  content: '';
  display: block;
  width: 24px;
  height: 2px;
  background: var(--green-700);
}
.product-table-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-200);
  margin-bottom: 8px;
}
.product-table { width: 100%; border-collapse: collapse; background: var(--white); }
.product-table thead { background: var(--green-700); }
.product-table thead th {
  padding: 12px 20px;
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  text-align: left;
}
.product-table thead th:last-child { text-align: right; }
.product-table tbody tr { border-bottom: 1px solid var(--gray-200); transition: background 0.15s; }
.product-table tbody tr:last-child { border-bottom: none; }
.product-table tbody tr:hover { background: var(--gray-100); }
.product-table tbody td { padding: 14px 20px; font-size: 0.875rem; color: var(--dark); vertical-align: middle; }
.product-table tbody td:last-child { text-align: right; }
.product-name { font-weight: 700; display: block; }
.product-badge {
  display: inline-block;
  margin-top: 3px;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--orange);
  background: var(--orange-light);
  padding: 2px 7px;
  border-radius: 20px;
}
.product-price { font-size: 1rem; font-weight: 800; color: var(--green-700); white-space: nowrap; }
.product-price-sub { display: block; font-size: 0.68rem; font-weight: 500; color: var(--gray-400); text-transform: uppercase; letter-spacing: 0.06em; }
.color-dot { display: inline-flex; align-items: center; gap: 7px; font-size: 0.85rem; }
.color-dot::before { content: ''; display: block; width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.color-emerald::before { background: #4a9a3a; }
.color-olive::before   { background: #7a8a3a; }
.color-billow::before  { background: #3a8a4a; }
.color-notify::before  { background: #5a9a6a; }

/* ─── ACCESSORIES ─── */
.accessories {
  padding: 88px 0;
  background: var(--gray-100);
}
.accessories-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 32px;
}
.acc-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.04);
}
.acc-card-icon {
  width: 46px;
  height: 46px;

  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}
.acc-card-icon svg { width: 28px; height: 28px; color: var(--green-700); }
.acc-card h4 { font-size: 0.95rem; color: var(--dark); margin-bottom: 12px; letter-spacing: 0.02em; }
.acc-item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 6px 0;
  border-bottom: 1px solid var(--gray-100);
  gap: 8px;
}
.acc-item:last-child { border-bottom: none; }
.acc-item-name {
  font-size: 0.82rem;
  color: var(--gray-600);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.4;
}
.acc-item-price { font-size: 0.82rem; font-weight: 700; color: var(--green-700); white-space: nowrap; flex-shrink: 0; }

/* Installer callout */
.installer-callout {
  background: var(--dark);
  border-radius: var(--radius-lg);
  padding: 36px;
  display: flex;
  gap: 24px;
  align-items: flex-start;
}
.installer-callout-icon {
  width: 48px;
  height: 48px;

  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.installer-callout-icon svg { width: 28px; height: 28px; color: var(--green-700); }
.installer-callout h4 { font-size: 0.95rem; color: var(--white); margin-bottom: 8px; letter-spacing: 0.04em; }
.installer-callout p {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.65;
  margin-bottom: 20px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── RESPONSIVE ─── */
@media (max-width: 768px) {
  .why-turf-inner { grid-template-columns: 1fr; gap: 32px; }
  .why-turf-img { aspect-ratio: 16/9; }
  .choosing-grid { grid-template-columns: 1fr; }
  .accessories-grid { grid-template-columns: 1fr 1fr; }
  .installer-callout { flex-direction: column; }
  .product-table thead th:nth-child(3),
  .product-table tbody td:nth-child(3) { display: none; }
}
@media (max-width: 480px) {
  .accessories-grid { grid-template-columns: 1fr; }
  .product-table thead th:nth-child(2),
  .product-table tbody td:nth-child(2) { display: none; }
  .product-table thead th { padding: 10px 12px; font-size: 0.65rem; }
  /* Badge: stay inline, don't force new line, smaller */
  .product-badge {
    display: inline;
    font-size: 0.58rem;
    padding: 1px 5px;
    margin-left: 4px;
    white-space: nowrap;
    vertical-align: middle;
  }
  /* Name stays on one line if possible */
  .product-name { display: inline; }
  /* Price column tighter */
  .product-price { font-size: 0.9rem; }
  .product-price-sub { font-size: 0.62rem; }
}

@media (max-width: 768px) {
  .product-table tbody td { padding: 10px 12px; font-size: 0.82rem; }
  .product-table thead th { padding: 10px 12px; font-size: 0.65rem; }
  .product-badge {
    display: block;
    font-size: 0.58rem;
    padding: 2px 6px;
    margin-top: 4px;
    margin-left: 0;
    width: fit-content;
  }
  .product-name { display: block; }
  .product-price { font-size: 0.9rem; }
  .product-price-sub { font-size: 0.62rem; }
}

@media (max-width: 768px) {
  /* Hide Color column — not enough room */
  .product-table thead th:nth-child(4),
  .product-table tbody td:nth-child(4) { display: none; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">DIY Homeowners</div>
      <h1>Build the Backyard <em>You've Always Wanted</em></h1>
      <p>Whether you're a weekend warrior ready to tackle the project yourself or just want to buy professional-grade materials before hiring an installer, we have everything you need — at the same prices the pros pay.</p>
      <div class="page-hero-btns">
        <a href="tel:4807393854" class="btn btn-primary">Call for a Free Project Quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91A16 16 0 0 0 14 15.82l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></a>
        <a href="/artificial-turf" class="btn btn-outline">Browse Turf Products</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ WHY TURF ═══ -->
<section class="why-turf">
  <div class="container">
    <div class="why-turf-inner">
      <div class="why-turf-content">
        <div class="section-label">Why Make the Switch</div>
        <h2>Why Phoenix Homeowners Love Artificial Turf</h2>
        <p>Transforming your natural grass into artificial turf is a smart investment that instantly boosts your home's curb appeal while saving you time and money every single month.</p>
        <div class="why-list">
          <div class="why-item" data-reveal>
            <div class="why-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div>
              <h4>Pet &amp; Family Friendly</h4>
              <p>Allergen-free, easy to clean, and no toxic chemical pesticides or fertilizers. Let your kids and pets enjoy the lawn they deserve.</p>
            </div>
          </div>
          <div class="why-item" data-reveal>
            <div class="why-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            </div>
            <div>
              <h4>Massive Water Savings</h4>
              <p>A lush, perfectly green yard without watching your water bill skyrocket. Artificial turf is a drought-proof solution built for desert living.</p>
            </div>
          </div>
          <div class="why-item" data-reveal>
            <div class="why-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <h4>Zero Maintenance</h4>
              <p>Reclaim your weekends. Say goodbye to mowing, fertilizing, fixing sprinklers, and pulling weeds — for good.</p>
            </div>
          </div>
          <div class="why-item" data-reveal>
            <div class="why-item-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/><path d="M12 8v4l3 3"/></svg>
            </div>
            <div>
              <p>Many of our premium lines feature CoolYarn technology — optimizing airflow to lower surface temps in Arizona's 110°+ summers.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="why-turf-img">
        <Pic name="natural-series-turf-large.png" alt="Beautiful backyard artificial turf installation" />
      </div>
    </div>
  </div>
</section>

<!-- ═══ CHOOSING GUIDE ═══ -->
<section class="choosing-guide">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Buyer's Guide</div>
      <h2>How to Choose the Right Turf for Your Home</h2>
      <p>New to artificial turf? Don't worry — we make it simple. The two most important numbers are pile height (how tall the blades are) and face weight (how dense the turf is).</p>
    </div>
    <div class="choosing-grid">
      <div class="choosing-card high-traffic">
        <div class="choosing-tag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          High Traffic
        </div>
        <h3>Backyards, Play Areas &amp; Dogs</h3>
        <p>Look for a higher face weight and taller pile height. Thicker turf resists matting and holds up better to running, playing, and pets digging around.</p>
        <div class="choosing-specs">
          <div class="spec-chip">
            <span class="spec-chip-val">84–107 oz</span>
            <span class="spec-chip-label">Face Weight</span>
          </div>
          <div class="spec-chip">
            <span class="spec-chip-val">1.65–2.0"</span>
            <span class="spec-chip-label">Pile Height</span>
          </div>
          <div class="spec-chip">
            <span class="spec-chip-val">Spring 107</span>
            <span class="spec-chip-label">Top Pick</span>
          </div>
        </div>
      </div>
      <div class="choosing-card low-traffic">
        <div class="choosing-tag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          Curb Appeal
        </div>
        <h3>Front Yards &amp; Low-Traffic Areas</h3>
        <p>Save money with a lower face weight that still delivers a gorgeous, realistic look. No need to withstand heavy foot traffic — just beautiful, maintenance-free curb appeal.</p>
        <div class="choosing-specs">
          <div class="spec-chip">
            <span class="spec-chip-val">70–75 oz</span>
            <span class="spec-chip-label">Face Weight</span>
          </div>
          <div class="spec-chip">
            <span class="spec-chip-val">1.5"</span>
            <span class="spec-chip-label">Pile Height</span>
          </div>
          <div class="spec-chip">
            <span class="spec-chip-val">Natural 75</span>
            <span class="spec-chip-label">Top Pick</span>
          </div>
        </div>
      </div>
    </div>
    <div class="choosing-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Not sure what to choose? Bring your yard measurements into our Queen Creek showroom — we'll walk you through the options and let you walk on our turf displays before you decide.
    </div>
  </div>
</section>

<!-- ═══ DARK CTA BREAK ═══ -->
<section style="padding:56px 0; background:var(--dark); text-align:center; position:relative; overflow:hidden;">
  <div style="position:absolute; top:-60px; right:-60px; width:300px; height:300px; background:radial-gradient(circle, rgba(35,155,43,0.1) 0%, transparent 70%);"></div>
  <div class="container" style="position:relative;">
    <h2 style="font-size:clamp(1.4rem,2.5vw,2rem); color: var(--green-700); margin-bottom:12px;">Not Sure Which Turf Is Right for You?</h2>
    <p style="font-size:0.95rem; color:rgba(255,255,255,0.65); max-width:480px; margin:0 auto 28px; line-height:1.7; font-weight:400; text-transform:none; letter-spacing:0;">Bring your yard measurements to our showroom — we'll help you pick the perfect turf and calculate exactly what you need.</p>
    <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
      <a href="/contact" class="btn btn-primary">Get a Free Quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="tel:4807393854" class="btn btn-outline">Call 480-739-3854</a>
    </div>
  </div>
</section>

<!-- ═══ PRODUCT TABLES ═══ -->
<section class="products-section">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Our Collection</div>
      <h2>Premium Turf — Direct to You</h2>
      <p>All turf is sold in standard 15-foot wide rolls. Prices below are standard retail per square foot — every product is guaranteed lead-free, pet-friendly, and backed by a 15-year manufacturer warranty.</p>
    </div>
    <div class="products-note">All pricing is standard retail per sq ft. Professional contractors — call or text for exclusive wholesale pricing.</div>

    <div class="series-block">
      <h3>Natural Blend Series</h3>
      <div class="product-table-wrap">
        <table class="product-table">
          <thead><tr><th>Product</th><th>Pile Height</th><th>Face Weight</th><th>Color</th><th>Price / sq ft</th></tr></thead>
          <tbody>
            <tr><td><span class="product-name">Natural Blend 75</span></td><td>1.5"</td><td>75 oz</td><td><span class="color-dot color-emerald">Emerald &amp; Lime</span></td><td><span class="product-price">$1.40<span class="product-price-sub">per sq ft</span></span></td></tr>
            <tr><td><span class="product-name">Natural Blend 84</span></td><td>1.65"</td><td>84 oz</td><td><span class="color-dot color-emerald">Emerald &amp; Lime</span></td><td><span class="product-price">$1.50<span class="product-price-sub">per sq ft</span></span></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="series-block">
      <h3>Winter Blend Series</h3>
      <div class="product-table-wrap">
        <table class="product-table">
          <thead><tr><th>Product</th><th>Pile Height</th><th>Face Weight</th><th>Color</th><th>Price / sq ft</th></tr></thead>
          <tbody>
            <tr><td><span class="product-name">Winter Blend 84</span></td><td>1.65"</td><td>84 oz</td><td><span class="color-dot color-notify">Notify Emerald &amp; Lime</span></td><td><span class="product-price">$1.50<span class="product-price-sub">per sq ft</span></span></td></tr>
            <tr><td><span class="product-name">Winter Blend 103</span><span class="product-badge">Moderate–Heavy Traffic</span></td><td>1.7"</td><td>103 oz</td><td><span class="color-dot color-notify">Notify Emerald &amp; Lime</span></td><td><span class="product-price">$1.70<span class="product-price-sub">per sq ft</span></span></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="series-block">
