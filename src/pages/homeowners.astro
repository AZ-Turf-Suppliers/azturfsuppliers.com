<!-- ═══ INSTALLER POPUP ═══ -->
<div class="installer-popup-overlay" id="installer-popup" role="dialog" aria-modal="true" aria-labelledby="installer-popup-title" aria-hidden="true">
  <div class="installer-popup">
    <button type="button" class="installer-popup-close" id="installer-popup-close" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="installer-popup-icon">
      <Icon name="users" size={16} />
    </div>
    <h3 id="installer-popup-title">Need Help with Installation?</h3>
    <p>We work with a network of trusted local installers. If you'd rather have a pro handle it, we'll connect you with a top-rated contractor who knows our products inside and out.</p>
    <div class="installer-popup-btns">
      <a href="/contact?need=installation" class="btn btn-primary" id="installer-popup-yes">Yes, connect me <Icon name="arrow-right" size={16} /></a>
      <button type="button" class="btn btn-outline" id="installer-popup-no">No thanks</button>
    </div>
  </div>
</div>

<script>
function initInstallerPopup() {
  const overlay = document.getElementById('installer-popup');
  if (!overlay) return;
  const closeBtn = document.getElementById('installer-popup-close');
  const noBtn = document.getElementById('installer-popup-no');
  const yesBtn = document.getElementById('installer-popup-yes');
  const STORAGE_KEY = 'az_installer_popup_dismissed';

  const open = () => {
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
  };

  let dismissed = false;
  try { dismissed = sessionStorage.getItem(STORAGE_KEY) === '1'; } catch (e) {}
  if (!dismissed) {
    setTimeout(open, 1500);
  }

  closeBtn?.addEventListener('click', close);
  noBtn?.addEventListener('click', close);
  yesBtn?.addEventListener('click', () => {
    try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) {}
  });
  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) close();
  });
}

initInstallerPopup();
document.addEventListener('astro:page-load', initInstallerPopup);
</script>

