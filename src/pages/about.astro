---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="About Us | AZ Turf Suppliers — Queen Creek, AZ"
  description="AZ Turf Suppliers is a Queen Creek-based wholesaler of premium artificial turf, pavers, natural stone, and landscape lighting. Family-run, contractor-trusted, lead-free."
>
<style is:global>
.page-hero::before { background-image: url("/media/turf-hero-6.jpg") !important; }
/* ─── PAGE HERO ─── */

/* ─── INTRO ─── */
.about-intro {
  padding: 88px 0;
  background: var(--white);
}
.about-intro-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.about-intro-text h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 20px;
}
.about-intro-text p {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 16px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.about-intro-text p:last-child { margin-bottom: 0; }
.about-img {
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}
.about-img img { width: 100%; height: auto; display: block; }
.about-img-placeholder {
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.2);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* ─── MISSION ─── */
.mission {
  padding: 88px 0;
  background: var(--dark);
  position: relative;
  overflow: hidden;
}
.mission::before {
  content: '';
  position: absolute;
  inset: 0;
  background: url('/media/az-turf-sign.jpg') center / cover no-repeat;
  z-index: 0;
}
.mission::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.74);
  z-index: 1;
}
.mission .container {
  position: relative;
  z-index: 2;
}
.mission-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 48px;
}
.mission-card {
  background: rgba(255,255,255,0.06);
  border-radius: var(--radius-lg);
  padding: 40px 36px;
  border: 1px solid rgba(255,255,255,0.1);
  position: relative;
  overflow: hidden;
}
.mission-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: var(--green-700);
}
.mission-card h3 {
  font-size: 1.1rem;
  color: var(--white);
  margin-bottom: 10px;
  letter-spacing: 0.02em;
}
.mission-card p {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.6);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── DIFFERENCE ─── */
.difference {
  padding: 88px 0;
  background: var(--white);
}
.difference-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
.diff-item {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  padding: 28px 32px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--gray-200);
  background: var(--white);
  transition: all 0.3s;
}
.diff-item:hover {
  border-color: var(--green-700);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.diff-item-icon {
  width: 48px;
  height: 48px;

  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.diff-item-icon svg { width: 28px; height: 28px; color: var(--green-700); }
.diff-item h4 {
  font-size: 0.95rem;
  color: var(--dark);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}
.diff-item p {
  font-size: 0.875rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── SHOWROOM ─── */
.showroom-section {
  padding: 88px 0;
  background: var(--gray-100);
}
.showroom-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.showroom-content h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 16px;
}
.showroom-content > p {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 32px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.showroom-details {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 32px;
}
.showroom-detail {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.showroom-detail-icon {
  width: 38px;
  height: 38px;

  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.showroom-detail-icon svg { width: 26px; height: 26px; color: var(--green-700); }
.showroom-section .showroom-detail-text strong {
  display: block;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--gray-400);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 2px;
}
.showroom-section .showroom-detail-text span {
  font-size: 0.875rem;
  color: var(--dark);
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
}
.showroom-map {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--gray-200);
  box-shadow: var(--shadow-md);
}
.showroom-map iframe { width: 100%; height: 100%; border: none; display: block; }

/* ─── RESPONSIVE ─── */
@media (max-width: 768px) {
  .about-intro-inner { grid-template-columns: 1fr; gap: 32px; }
  .about-img { aspect-ratio: 16/9; }
  .mission-inner { grid-template-columns: 1fr; }
  .difference-grid { grid-template-columns: 1fr; }
  .showroom-inner { grid-template-columns: 1fr; gap: 32px; }
  .showroom-map { aspect-ratio: 16/9; }
}
@media (max-width: 480px) {
  .mission-card { padding: 28px 24px; }
  .diff-item { padding: 20px; }
}


/* Mobile difference-grid styling is handled by shared.css */
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Queen Creek, Arizona</div>
      <h1>Locally Owned. <em>Expert Driven.</em></h1>
      <p>AZ Turf Suppliers is a locally owned landscape supply company dedicated to providing premium artificial turf, pavers, natural stone, and lighting at wholesale pricing — backed by real people who know the products.</p>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    <div class="stat-item">
      <div class="stat-num">5<span>+</span></div>
      <div class="stat-label">Years Serving the East Valley</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">15<span>yr</span></div>
      <div class="stat-label">Manufacturer Warranty</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">15<span>min</span></div>
      <div class="stat-label">In-Store Pickup</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">100<span>%</span></div>
      <div class="stat-label">Lead-Free &amp; Pet Safe</div>
    </div>
  </div>
</div>

<!-- ═══ INTRO / STORY ═══ -->
<section class="about-intro">
  <div class="container">
    <div class="about-intro-inner">
      <div class="about-intro-text">
        <div class="section-label">Our Story</div>
        <h2>Your Local Hardscape &amp; Turf Experts</h2>
        <p>Welcome to AZ Turf Suppliers, LLC. Located in Queen Creek, Arizona, we are a locally owned and operated landscape supply company dedicated to providing premium artificial turf at wholesale pricing.</p>
        <p>For over five years, we have been serving the East Valley and the greater Phoenix area — growing from a dedicated synthetic grass supplier into a comprehensive one-stop shop for all your hardscaping needs, including pavers, natural stone, and landscape lighting.</p>
        <p>We know that you have choices when it comes to landscape suppliers, but we pride ourselves on a relationship-driven approach that big-box stores simply cannot match.</p>
      </div>
      <div class="about-img" data-reveal>
        <Pic name="team.jpg" alt="The AZ Turf Suppliers team in Queen Creek, Arizona" />
      </div>
    </div>
  </div>
</section>

<!-- ═══ MISSION ═══ -->
<section class="mission">
  <div class="container">
    <div class="section-label inverted">Our Mission</div>
    <h2 style="font-size:clamp(1.9rem,3vw,2.8rem); max-width:560px; margin-bottom:0; color:var(--white);">Let Us Help Create the Yard of Your Dreams</h2>
    <div class="mission-inner">
      <div class="mission-card" data-reveal>
        <h3>For Professional Contractors</h3>
        <p>Our goal is to help you grow your business by providing reliable inventory, excellent service, quality products, and blazing-fast delivery. Text us your orders — we'll handle the rest.</p>
      </div>
      <div class="mission-card" data-reveal>
        <h3>For DIY Homeowners</h3>
        <p>We welcome all DIYers working to achieve their dream yard. We're here to provide the education, materials, and expert answers you need to get the job done right — from measurements to the final blade.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ THE AZ TURF DIFFERENCE ═══ -->
<section class="difference">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Why Choose Us</div>
      <h2>The AZ Turf Difference</h2>
      <p>When you buy from AZ Turf Suppliers, you deal with real people who know the products — not a call center or a website checkout.</p>
    </div>
    <div class="difference-grid">
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon"><Icon name="chat" size={28} /></div>
        <div>
          <h4>Direct-to-Owner Communication</h4>
          <p>You deal directly with the owner. Contractors can simply text us their orders for immediate processing — no middleman, no hold music.</p>
        </div>
      </div>
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon"><Icon name="truck" size={28} /></div>
        <div>
          <h4>Lightning-Fast Logistics</h4>
          <p>15-minute in-store pickup for fast loading, plus guaranteed next-day delivery directly to your home or job site. We respect your deadlines.</p>
        </div>
      </div>
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon"><Icon name="shield-check" size={28} /></div>
        <div>
          <h4>Pro-Grade Quality</h4>
          <p>Our turf is built for Arizona's 110°+ heat — guaranteed lead-free, completely pet-friendly, and backed by a 15-year manufacturer warranty.</p>
        </div>
      </div>
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon"><Icon name="dollar" size={28} /></div>
        <div>
          <h4>Wholesale Pricing &amp; Price Match</h4>
          <p>Top-tier materials at unbeatable prices. Find a better price locally? Bring us the invoice — we'll match it, no questions asked.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIALS ═══ -->
<section class="testimonials">
  <div class="container">
    <div class="testimonials-header">
      <div class="section-label centered">Words From Our Clients</div>
      <h2>What Our Customers Say</h2>
    </div>
    <Testimonials />
    <div class="testimonials-cta" data-reveal>
      <a href="/reviews">Read More Reviews <Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</section>

<!-- ═══ SHOWROOM ═══ -->
<section class="showroom-section">
  <div class="container">
    <div class="showroom-inner">
      <div class="showroom-content">
        <div class="section-label">Visit Us</div>
        <h2>Come See Us at Our Queen Creek Showroom</h2>
        <p>Whether you need a quick restock of nails and seam tape or you're planning a massive 5,000 sq ft backyard overhaul, we have the inventory and expertise to help. Stop by to feel our turf quality in person and pick up free samples.</p>
        <p>Bring in your measurements (length and width in feet) and our friendly team will calculate exactly what you need and provide an immediate pricing quote.</p>
        <div class="showroom-details">
          <div class="showroom-detail" data-reveal>
            <div class="showroom-detail-icon"><Icon name="location" size={24} /></div>
            <div class="showroom-detail-text">
              <strong>Address</strong>
              <span>18607 E San Tan Blvd, Queen Creek, AZ</span>
            </div>
          </div>
          <div class="showroom-detail" data-reveal>
            <div class="showroom-detail-icon"><Icon name="phone" size={24} /></div>
            <div class="showroom-detail-text">
              <strong>Phone / Text</strong>
              <span>(602) 520-7511</span>
            </div>
          </div>
          <div class="showroom-detail" data-reveal>
            <div class="showroom-detail-icon"><Icon name="clock" size={24} /></div>
            <div class="showroom-detail-text">
              <strong>Hours</strong>
              <span>Mon–Fri: 7 AM – 3 PM · Sat–Sun: Closed</span>
            </div>
          </div>
        </div>
        <a href="tel:6025207511" class="btn btn-primary">Call or Text Us Today <Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="showroom-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3334.5!2d-111.6200!3d33.2050!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s18607+E+San+Tan+Blvd%2C+Queen+Creek%2C+AZ!5e0!3m2!1sen!2sus!4v1"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="AZ Turf Suppliers Showroom Location">
        </iframe>
      </div>
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">Get Started Today</div>
    <h2>Ready to Build Your Dream Yard?</h2>
    <p>Call or text us at (602) 520-7511 to get started. Same-day response, next-day delivery, and a price match guarantee — every time.</p>
    <div class="cta-btns">
      <a href="tel:6025207511" class="btn btn-primary">Call or Text (602) 520-7511 <Icon name="phone" size={16} /></a>
      <a href="/artificial-turf" class="btn btn-outline">Browse Our Products</a>
    </div>
  </div>
</section>

</Layout>
