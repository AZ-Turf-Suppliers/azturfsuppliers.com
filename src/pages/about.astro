---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us | AZ Turf Suppliers — Queen Creek, AZ">
<style is:global>
/* ─── PAGE HERO ─── */

/* ─── INTRO ─── */
.about-intro {
  padding: 88px 0;
  background: var(--white);
}
.about-intro-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.about-intro-text h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 20px;
}
.about-intro-text p {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 16px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.about-intro-text p:last-child { margin-bottom: 0; }
.about-img {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--green-700);
  position: relative;
}
.about-img img { width: 100%; height: 100%; object-fit: cover; }
.about-img-placeholder {
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.2);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* ─── MISSION ─── */
.mission {
  padding: 88px 0;
  background: var(--dark);
}
.mission-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 48px;
}
.mission-card {
  background: rgba(255,255,255,0.06);
  border-radius: var(--radius-lg);
  padding: 40px 36px;
  border: 1px solid rgba(255,255,255,0.1);
  position: relative;
  overflow: hidden;
}
.mission-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: var(--green-700);
}
.mission-card-icon {
  width: 48px;
  height: 48px;

  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}
.mission-card-icon svg { width: 28px; height: 28px; color: var(--green-700); }
.mission-card h3 {
  font-size: 1.1rem;
  color: var(--white);
  margin-bottom: 10px;
  letter-spacing: 0.02em;
}
.mission-card p {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.6);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── DIFFERENCE ─── */
.difference {
  padding: 88px 0;
  background: var(--white);
}
.difference-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
.diff-item {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  padding: 28px 32px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--gray-200);
  background: var(--white);
  transition: all 0.3s;
}
.diff-item:hover {
  border-color: var(--green-700);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.diff-item-icon {
  width: 48px;
  height: 48px;

  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.diff-item-icon svg { width: 28px; height: 28px; color: var(--green-700); }
.diff-item h4 {
  font-size: 0.95rem;
  color: var(--dark);
  margin-bottom: 8px;
  letter-spacing: 0.02em;
}
.diff-item p {
  font-size: 0.875rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── SHOWROOM ─── */
.showroom-section {
  padding: 88px 0;
  background: var(--gray-100);
}
.showroom-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
.showroom-content h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  margin-bottom: 16px;
}
.showroom-content > p {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 32px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.showroom-details {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 32px;
}
.showroom-detail {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.showroom-detail-icon {
  width: 38px;
  height: 38px;

  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.showroom-detail-icon svg { width: 26px; height: 26px; color: var(--green-700); }
.showroom-detail-text strong {
  display: block;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--gray-400);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 2px;
}
.showroom-detail-text span {
  font-size: 0.875rem;
  color: var(--dark);
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
}
.showroom-map {
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--gray-200);
  box-shadow: var(--shadow-md);
}
.showroom-map iframe { width: 100%; height: 100%; border: none; display: block; }

/* ─── RESPONSIVE ─── */
@media (max-width: 768px) {
  .about-intro-inner { grid-template-columns: 1fr; gap: 32px; }
  .about-img { aspect-ratio: 16/9; }
  .mission-inner { grid-template-columns: 1fr; }
  .difference-grid { grid-template-columns: 1fr; }
  .showroom-inner { grid-template-columns: 1fr; gap: 32px; }
  .showroom-map { aspect-ratio: 16/9; }
}
@media (max-width: 480px) {
  .mission-card { padding: 28px 24px; }
  .diff-item { padding: 20px; }
}


@media (max-width: 768px) {
  /* ── diff-item: same pattern as homepage choose-turf-card ── */
  .difference-grid .diff-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 12px;
    padding: 14px 16px;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--gray-200);
    box-shadow: none;
    transform: none;
    background: var(--white);
    transition: none;
  }
  .difference-grid .diff-item:first-child { border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .difference-grid .diff-item:last-child  { border-radius: 0 0 var(--radius-lg) var(--radius-lg); border-bottom: none; }
  .difference-grid .diff-item:hover { transform: none; box-shadow: none; }
  .difference-grid .diff-item-icon { width: 36px; height: 36px; min-width: 36px; flex-shrink: 0; border-radius: 8px; }
  .difference-grid .diff-item h4 { flex: 1; margin-bottom: 0; font-size: 0.85rem; }
  .difference-grid .diff-item p  { width: 100%; padding-top: 5px; padding-left: 48px; font-size: 0.78rem; line-height: 1.55; }
}

@media (max-width: 768px) {
  .difference-grid {
    grid-template-columns: 1fr;
    gap: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--gray-200);
    overflow: visible;
  }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Queen Creek, Arizona</div>
      <h1>Locally Owned. <em>Expert Driven.</em></h1>
      <p>AZ Turf Suppliers is a locally owned landscape supply company dedicated to providing premium artificial turf, pavers, natural stone, and lighting at wholesale pricing — backed by real people who know the products.</p>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    <div class="stat-item">
      <div class="stat-num">5<span>+</span></div>
      <div class="stat-label">Years Serving the East Valley</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">15<span>yr</span></div>
      <div class="stat-label">Manufacturer Warranty</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">15<span>min</span></div>
      <div class="stat-label">In-Store Pickup</div>
    </div>
    <div class="stat-item">
      <div class="stat-num">100<span>%</span></div>
      <div class="stat-label">Lead-Free &amp; Pet Safe</div>
    </div>
  </div>
</div>

<!-- ═══ INTRO / STORY ═══ -->
<section class="about-intro">
  <div class="container">
    <div class="about-intro-inner">
      <div class="about-intro-text">
        <div class="section-label">Our Story</div>
        <h2>Your Local Hardscape &amp; Turf Experts</h2>
        <p>Welcome to AZ Turf Suppliers, LLC. Located in Queen Creek, Arizona, we are a locally owned and operated landscape supply company dedicated to providing premium artificial turf at wholesale pricing.</p>
        <p>For over five years, we have been serving the East Valley and the greater Phoenix area — growing from a dedicated synthetic grass supplier into a comprehensive one-stop shop for all your hardscaping needs, including pavers, natural stone, and landscape lighting.</p>
        <p>We know that you have choices when it comes to landscape suppliers, but we pride ourselves on a relationship-driven approach that big-box stores simply cannot match.</p>
      </div>
      <div class="about-img">
        <div class="about-img-placeholder">Showroom / Team Photo</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ MISSION ═══ -->
<section class="mission">
  <div class="container">
    <div class="section-label inverted">Our Mission</div>
    <h2 style="font-size:clamp(1.9rem,3vw,2.8rem); max-width:560px; margin-bottom:0; color:var(--white);">Let Us Help Create the Yard of Your Dreams</h2>
    <div class="mission-inner">
      <div class="mission-card" data-reveal>
        <div class="mission-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>For Professional Contractors</h3>
        <p>Our goal is to help you grow your business by providing reliable inventory, excellent service, quality products, and blazing-fast delivery. Text us your orders — we'll handle the rest.</p>
      </div>
      <div class="mission-card" data-reveal>
        <div class="mission-card-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <h3>For DIY Homeowners</h3>
        <p>We welcome all DIYers working to achieve their dream yard. We're here to provide the education, materials, and expert answers you need to get the job done right — from measurements to the final blade.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ THE AZ TURF DIFFERENCE ═══ -->
<section class="difference">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Why Choose Us</div>
      <h2>The AZ Turf Difference</h2>
      <p>When you buy from AZ Turf Suppliers, you deal with real people who know the products — not a call center or a website checkout.</p>
    </div>
    <div class="difference-grid">
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91A16 16 0 0 0 14 15.82l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div>
          <h4>Direct-to-Owner Communication</h4>
          <p>You deal directly with the owner. Contractors can simply text us their orders for immediate processing — no middleman, no hold music.</p>
        </div>
      </div>
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div>
          <h4>Lightning-Fast Logistics</h4>
          <p>15-minute in-store pickup for fast loading, plus guaranteed next-day delivery directly to your home or job site. We respect your deadlines.</p>
        </div>
      </div>
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <h4>Pro-Grade Quality</h4>
          <p>Our turf is built for Arizona's 110°+ heat — guaranteed lead-free, completely pet-friendly, and backed by a 15-year manufacturer warranty.</p>
        </div>
      </div>
      <div class="diff-item" data-reveal>
        <div class="diff-item-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div>
          <h4>Wholesale Pricing &amp; Price Match</h4>
          <p>Top-tier materials at unbeatable prices. Find a better price locally? Bring us the invoice — we'll match it, no questions asked.</p>
        </div>
      </div>
    </div>
  </div>
</section>

