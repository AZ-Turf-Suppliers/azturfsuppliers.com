---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
---

<Layout
  title="Natural Blend 75 | AZ Turf Suppliers — Queen Creek, AZ"
  description="Natural Blend 75 artificial turf — $1.40/sqft. Soft, realistic blade for front yards, side yards, and low-traffic landscaping. In stock in Queen Creek, AZ."
>
<style is:global>
.page-hero::before { background-image: url("/media/natural-blend-75-side.png") !important; }
/* ─── PRODUCT DETAIL ─── */
.pd-section {
  padding: 88px 0;
  background: var(--white);
}
.pd-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: start;
}
.pd-image {
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--gray-100);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.pd-gallery {
  position: sticky;
  top: 96px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.pd-thumbs {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.pd-thumb {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid transparent;
  background: var(--gray-100);
  cursor: pointer;
  padding: 0;
  transition: border-color 0.2s, transform 0.2s;
}
.pd-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.pd-thumb:hover { transform: translateY(-2px); }
.pd-thumb.is-active { border-color: var(--green-700); }
.pd-image img {
  width: 85%;
  height: auto;
  object-fit: contain;
}
.pd-content h2 {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  margin-bottom: 8px;
}
.pd-price {
  font-size: 1.8rem;
  font-weight: 900;
  color: var(--green-700);
  margin-bottom: 20px;
  line-height: 1;
}
.pd-price span {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--gray-400);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.pd-desc {
  font-size: 0.95rem;
  color: var(--gray-600);
  line-height: 1.75;
  margin-bottom: 24px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.pd-best-for {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  background: var(--gray-100);
  border-radius: var(--radius);
  margin-bottom: 28px;
  font-size: 0.85rem;
  color: var(--gray-600);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.pd-best-for strong {
  font-weight: 700;
  color: var(--dark);
  white-space: nowrap;
}
.pd-btns {
  display: flex;
  gap: 12px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}
.pd-btns .btn { white-space: nowrap; }

/* Key specs grid */
.pd-key-specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 32px;
}
.pd-key-spec {
  background: var(--gray-100);
  border-radius: var(--radius);
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.pd-key-label {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gray-400);
}
.pd-key-value {
  font-size: 1rem;
  font-weight: 800;
  color: var(--dark);
}

/* Features list */
.pd-features {
  margin-bottom: 36px;
}
.pd-features h3 {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--dark);
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--dark);
}
.pd-feature {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 10px 0;
}
.pd-feature-icon {
  width: 28px;
  height: 28px;

  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pd-feature-icon svg { width: 30px; height: 30px; color: var(--green-700); }
.pd-feature p {
  font-size: 0.875rem;
  color: var(--gray-600);
  line-height: 1.6;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* Full spec table */
.pd-full-specs {

  background: var(--dark);
  padding: 88px 0;
}
.pd-spec-table {
  width: 100%;
  max-width: 700px;
  margin: 0 auto;
  border-collapse: collapse;
}
.pd-spec-table tr { border-bottom: 1px solid rgba(255,255,255,0.1); }
.pd-spec-table tr:last-child { border-bottom: none; }
.pd-spec-table td {
  padding: 14px 16px;
  font-size: 0.875rem;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.pd-spec-table td:first-child {

  font-weight: 700;
  color: var(--white);
  width: 40%;
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.pd-spec-table td:last-child {
  color: rgba(255,255,255,0.6);
}

/* Trust badges */
.pd-badges {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.pd-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 50px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  background: var(--gray-100);
  color: var(--dark);
  border: 1px solid var(--gray-200);
}
.pd-badge svg { width: 14px; height: 14px; color: var(--green-700); }


/* ─── PRODUCT IMAGE LIGHTBOX ─── */
.pd-image {
  cursor: zoom-in;
}
.pd-image::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0);
  transition: background 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg);
}
.pd-image:hover::after {
  background: rgba(0,0,0,0.15);
}
.pd-mag {
  position: absolute;
  bottom: 20px;
  right: 20px;
  width: 44px;
  height: 44px;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.pd-image:hover .pd-mag {
  opacity: 1;
}
.pd-mag svg { width: 20px; height: 20px; color: var(--white); }

.pd-lightbox {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.92);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 40px;
  cursor: zoom-out;
}
.pd-lightbox.open { display: flex; }
.pd-lightbox img {
  max-width: 90%;
  max-height: 85vh;
  border-radius: var(--radius-lg);
  object-fit: contain;
}
.pd-lightbox-close,
.pd-lightbox-nav {
  position: absolute;
  width: 44px;
  height: 44px;
  background: rgba(255,255,255,0.1);
  border: none;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.pd-lightbox-close { top: 24px; right: 24px; }
.pd-lightbox-nav { top: 50%; transform: translateY(-50%); }
.pd-lightbox-prev { left: 24px; }
.pd-lightbox-next { right: 24px; }
.pd-lightbox-close:hover,
.pd-lightbox-nav:hover { background: rgba(255,255,255,0.2); }
.pd-lightbox-close svg { width: 20px; height: 20px; color: var(--white); }
.pd-lightbox-nav svg { width: 24px; height: 24px; color: var(--white); }

/* Responsive */
@media (max-width: 768px) {
  .pd-grid { grid-template-columns: 1fr; gap: 32px; }
  .pd-image { aspect-ratio: 4/3; }
  .pd-gallery { position: static; }
  .pd-section { padding: 56px 0; }
  .pd-full-specs {
 padding: 56px 0; }
}


/* ─── WHY WE LOVE SECTION ─── */
.why-love {
  padding: 88px 0;
  background: var(--white);
}
.why-love-header {
  text-align: center;
  margin-bottom: 56px;
}
.why-love-header h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  font-weight: 800;
  text-transform: none;
  letter-spacing: -0.02em;
}
.why-love-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}
.why-love-item {
  text-align: center;
}
.why-love-icon {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  
}
.why-love-icon svg { width: 32px; height: 32px; color: var(--green-700); }

.why-love-logo {
  max-width: 160px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}
.why-love-logo img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.why-love-item h4 {
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--dark);
  margin-bottom: 10px;
}
.why-love-item p {
  font-size: 0.85rem;
  color: var(--gray-600);
  line-height: 1.65;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  max-width: 280px;
  margin: 0 auto;
}
@media (max-width: 768px) {
  .why-love-grid { grid-template-columns: 1fr 1fr; gap: 32px 20px; }
  .why-love { padding: 56px 0; }
}
@media (max-width: 480px) {
  .why-love-grid { grid-template-columns: 1fr; gap: 36px; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Artificial Turf</div>
      <h1>Natural Blend 75</h1>
      <p>A lightweight, natural-looking turf that captures the relaxed appearance of real grass. Its blend of green and subtle ye...</p>
      <div class="page-hero-btns">
        <a href="/contact" class="btn btn-primary">Get a Quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="/artificial-turf" class="btn btn-outline">All Turf Products</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PRODUCT DETAIL ═══ -->
<section class="pd-section">
  <div class="container">
    <div class="pd-grid">
      <div class="pd-gallery" data-reveal>
        <div class="pd-image">
          <div class="pd-mag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></div>
          <Pic name="natural-series-turf.png" alt="Natural Blend 75" />
        </div>
        <div class="pd-thumbs">
          <button type="button" class="pd-thumb is-active" data-src="/media/natural-series-turf.png" aria-label="View 1"><Pic name="natural-series-turf.png" alt="" /></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-blend-75-side.png" aria-label="View 2"><Pic name="natural-blend-75-side.png" alt="" /></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-series-turf-1.jpg" aria-label="View 3"><img src="/media/natural-series-turf-1.jpg" alt="" loading="lazy" decoding="async"/></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-series-turf-2.jpg" aria-label="View 4"><Pic name="natural-series-turf-2.jpg" alt="" /></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-series-turf-3.jpg" aria-label="View 5"><Pic name="natural-series-turf-3.jpg" alt="" /></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-series-turf-4.jpg" aria-label="View 6"><Pic name="natural-series-turf-4.jpg" alt="" /></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-series-turf-5.jpg" aria-label="View 7"><Pic name="natural-series-turf-5.jpg" alt="" /></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-series-turf-6.jpg" aria-label="View 8"><Pic name="natural-series-turf-6.jpg" alt="" /></button>
          <button type="button" class="pd-thumb" data-src="/media/natural-series-turf-7.jpg" aria-label="View 9"><img src="/media/natural-series-turf-7.jpg" alt="" loading="lazy" decoding="async"/></button>
        </div>
      </div>
      <div class="pd-content">
        <div class="section-label">Premium Artificial Turf</div>
        <h2>Natural Blend 75</h2>
        <div class="pd-price">$1.40 <span>/ sq ft</span></div>
