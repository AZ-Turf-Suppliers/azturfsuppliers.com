</section>


<!-- ═══ WHY WE LOVE ═══ -->
<section class="why-love">
  <div class="container">
    <div class="why-love-header">
      <div class="section-label centered">Why We Love Our</div>
      <h2>Natural Blend 75 Turf</h2>
    </div>
    <div class="why-love-grid">
      <div class="why-love-item" data-reveal>
        <div class="why-love-logo">
          <Pic name="coolyarn.jpg" alt="CoolYarn Technology" />
        </div>
        <p>Optimizes airflow to reduce surface temperature in extreme weather. UV-stabilized to resist fading from the sun.</p>
      </div>
      <div class="why-love-item" data-reveal>
        <div class="why-love-logo">
          <Pic name="pet-friendly.jpg" alt="Pet Friendly" />
        </div>
        <p>Allergen-free, easy to clean, and comfortable to play on. A great choice for any pet owner.</p>
      </div>
      <div class="why-love-item" data-reveal>
        <div class="why-love-logo">
          <Pic name="save-water.jpg" alt="Save Water" />
        </div>
        <p>No watering, mowing, or fertilizing needed. Even in a drought, your lawn stays lush and beautiful year-round.</p>
      </div>
      <div class="why-love-item" data-reveal>
        <div class="why-love-logo">
          <Pic name="lead-free.jpg" alt="Lead Free" />
        </div>
        <p>100% non-toxic and guaranteed lead-free. No pesticides or fertilizers required — safe for your family.</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">Get Started</div>
    <h2>Ready to Order Natural Blend 75?</h2>
    <p>Call or text us at 480-739-3854 to get a quote, schedule delivery, or pick up at our Queen Creek showroom.</p>
    <div class="cta-btns">
      <a href="/contact" class="btn btn-primary">Get a Quote <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a href="/artificial-turf" class="btn btn-outline">View All Products</a>
    </div>
  </div>
</section>
<script>
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('revealed'); revealObserver.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));

// ─── PRODUCT IMAGE THUMBNAILS ───
document.querySelectorAll('.pd-thumb').forEach(function(thumb) {
  thumb.addEventListener('click', function() {
    var src = thumb.getAttribute('data-src');
    var mainImg = document.querySelector('.pd-image img');
    if (!mainImg || !src) return;
    mainImg.src = src;
    document.querySelectorAll('.pd-thumb').forEach(function(t) { t.classList.remove('is-active'); });
    thumb.classList.add('is-active');
  });
});

// ─── PRODUCT IMAGE LIGHTBOX ───
var thumbSrcs = Array.from(document.querySelectorAll('.pd-thumb')).map(function(t) { return t.getAttribute('data-src'); });
var lbIndex = 0;
var lb = document.createElement('div');
lb.className = 'pd-lightbox';
var navHTML = thumbSrcs.length > 1 ? '<button class="pd-lightbox-nav pd-lightbox-prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button><button class="pd-lightbox-nav pd-lightbox-next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>' : '';
lb.innerHTML = '<button class="pd-lightbox-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>' + navHTML + '<img src="" alt="" loading="lazy" decoding="async">';
document.body.appendChild(lb);
var lbImg = lb.querySelector('img');
function lbClose() { lb.classList.remove('open'); document.body.style.overflow = ''; }
function lbStep(delta) {
  if (!thumbSrcs.length) return;
  lbIndex = (lbIndex + delta + thumbSrcs.length) % thumbSrcs.length;
  lbImg.src = thumbSrcs[lbIndex];
}
document.querySelector('.pd-image').addEventListener('click', function() {
  var img = this.querySelector('img');
  if (!img) return;
  if (thumbSrcs.length) {
    var idx = thumbSrcs.findIndex(function(s) { return img.src.endsWith(s); });
    lbIndex = idx >= 0 ? idx : 0;
    lbImg.src = thumbSrcs[lbIndex];
  } else { lbImg.src = img.src; }
  lbImg.alt = img.alt || '';
  lb.classList.add('open'); document.body.style.overflow = 'hidden';
});
lb.querySelector('.pd-lightbox-close').addEventListener('click', lbClose);
lb.addEventListener('click', function(e) { if (e.target === lb) lbClose(); });
var prevEl = lb.querySelector('.pd-lightbox-prev');
var nextEl = lb.querySelector('.pd-lightbox-next');
if (prevEl) prevEl.addEventListener('click', function(e) { e.stopPropagation(); lbStep(-1); });
if (nextEl) nextEl.addEventListener('click', function(e) { e.stopPropagation(); lbStep(1); });
document.addEventListener('keydown', function(e) {
  if (!lb.classList.contains('open')) return;
  if (e.key === 'Escape') lbClose();
  else if (e.key === 'ArrowLeft') lbStep(-1);
  else if (e.key === 'ArrowRight') lbStep(1);
});

</script>
</Layout>
