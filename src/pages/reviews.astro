---
import Layout from '../layouts/Layout.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Customer Reviews | AZ Turf Suppliers — Queen Creek, AZ" description="See what Arizona homeowners and contractors are saying about AZ Turf Suppliers. Real Google reviews from real customers.">
<style is:global>
.page-hero::before { background-image: url("/media/turf-hero-4.jpg") !important; }

/* ─── REVIEWS PAGE ─── */
.reviews-page {
  padding: 88px 0;
  background: var(--dark);
  min-height: 80vh;
}
.reviews-page .section-label { color: var(--green-700); }
.reviews-page .section-label::before { background: var(--green-700); }
.reviews-page-header {
  text-align: center;
  margin-bottom: 56px;
}
.reviews-page-header h2 {
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  color: var(--white);
  margin-bottom: 12px;
}
.reviews-page-header p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.55);
  max-width: 540px;
  margin: 0 auto;
  line-height: 1.7;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
/* Dark surface styling for reviews-page grid */
.reviews-page .reviews-grid { grid-template-columns: repeat(3, 1fr); }
.reviews-page .review-card {
  background: rgba(255,255,255,0.06);
  border-color: rgba(255,255,255,0.1);
  box-shadow: none;
}
.reviews-page .review-card:hover {
  background: rgba(255,255,255,0.1);
  box-shadow: none;
}
.reviews-page .review-text { color: rgba(255,255,255,0.7); }
.reviews-page .review-text::before { color: var(--green-700); }
.reviews-page .review-name { color: var(--white); }
.reviews-page .review-source { color: rgba(255,255,255,0.4); }
.reviews-page .review-meta { border-top-color: rgba(255,255,255,0.08); }
.reviews-page .reviews-summary-text { color: var(--white); }
.reviews-page .reviews-summary-text span { color: rgba(255,255,255,0.5); }
@media (max-width: 1024px) { .reviews-page .reviews-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .reviews-page .reviews-grid { grid-template-columns: 1fr; } }
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">What Our Customers Say</div>
      <h1>Real Reviews from <em>Real Customers</em></h1>
      <p>Hundreds of Arizona homeowners and contractors trust AZ Turf Suppliers for premium turf, pavers, and hardscaping supplies. Here's what they have to say.</p>
      <div class="page-hero-btns">
        <a href="/contact" class="btn btn-primary">Get a Quote <Icon name="arrow-right" size={16} /></a>
        <a href="https://g.page/r/azturfsuppliers/review" target="_blank" rel="noopener" class="btn btn-outline">Leave a Review</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ REVIEWS GRID ═══ -->
<section class="reviews-page">
  <div class="container">
    <div class="reviews-page-header" data-reveal>
      <div class="section-label centered">Google Reviews</div>
      <h2>Trusted by Arizona Homeowners &amp; Contractors</h2>
      <p>All reviews are pulled directly from Google. We don't filter or curate — you see everything.</p>
    </div>
    <Testimonials showAllOnReviewsPage />
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered orange">Ready to Get Started?</div>
    <h2>Join Hundreds of Happy Customers</h2>
    <p>Call or text us to get pricing, check inventory, or schedule a delivery. Same-day response guaranteed.</p>
    <div class="cta-btns">
      <a href="tel:6025207511" class="btn btn-primary">Call or Text (602) 520-7511 <Icon name="phone" size={16} /></a>
      <a href="/contact" class="btn btn-outline">Contact Us</a>
    </div>
  </div>
</section>

</Layout>
