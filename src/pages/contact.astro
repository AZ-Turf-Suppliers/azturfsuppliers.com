<script>
// Scroll reveal (data-reveal system)
// scroll reveal handled by Layout.astro

// Smooth scroll for anchor links
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const target = document.querySelector(a.getAttribute('href'));
    if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  });
});
</script>

<script>
document.getElementById('contact-form')?.addEventListener('submit', async function (e) {
  e.preventDefault();

  const form = e.target as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const status = document.getElementById('form-status') as HTMLElement;

  btn.disabled = true;
  btn.textContent = 'Sending…';

  status.style.display = 'none';

  try {
    const res = await fetch('https://formspree.io/f/mdabkzde', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: new FormData(form),
    });

    const json = await res.json();

    if (res.ok && json.ok) {
      window.location.href = '/thank-you';
    } else {
      throw new Error(json.error ?? 'Unknown error');
    }
  } catch (err) {
    status.style.display = 'block';
    status.style.background = '#fff0f0';
    status.style.color = '#c0392b';
    status.textContent = 'Something went wrong. Please call us at 480-739-3854.';
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Send Message <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
  }
});
</script>
