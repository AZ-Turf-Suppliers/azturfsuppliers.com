---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
---

<Layout
  title="Contact Us | AZ Turf Suppliers — Queen Creek, AZ"
  description="Call or text 480-739-3854, or visit our Queen Creek showroom at 18607 E San Tan Blvd. Same-day quotes on artificial turf, pavers, natural stone, and landscape lighting."
>
<style is:global>
.page-hero::before { background-image: url("/media/natural-series-turf-4.jpg") !important; }
/* ─── PAGE HERO ─── */


/* ─── MAIN CONTACT GRID ─── */
.contact-main {
  padding: 88px 0;
  background: var(--gray-100);
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 40px;
  align-items: start;
}

/* ─── LEFT COLUMN: INFO ─── */
.contact-info-col {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

/* Contact details card */
.contact-details-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.04);
}
.contact-details-header {
  background: var(--green-700);
  padding: 20px 28px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.contact-details-header svg { width: 18px; height: 18px; color: var(--green-700); flex-shrink: 0; }
.contact-details-header h3 { font-size: 0.82rem; color: var(--white); letter-spacing: 0.1em; }
.contact-details-body { padding: 0; }

.contact-row {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 18px 28px;
  border-bottom: 1px solid var(--gray-100);
  transition: background 0.2s;
  text-decoration: none;
  color: inherit;
}
.contact-row:last-child { border-bottom: none; }
.contact-row:hover { background: var(--gray-100); }
.contact-row-icon {
  width: 40px;
  height: 40px;

  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.contact-row-icon svg { width: 26px; height: 26px; color: var(--green-700); }
.contact-row-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.contact-row-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gray-400);
}
.contact-row-value {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--dark);
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.45;
}
.contact-row-value span {
  display: block;
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--gray-600);
  margin-top: 1px;
}

/* Shopping options card */
.shopping-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.04);
}
.shopping-card-header {
  background: var(--dark-800);
  padding: 20px 28px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.shopping-card-header svg { width: 18px; height: 18px; color: var(--orange); flex-shrink: 0; }
.shopping-card-header h3 { font-size: 0.82rem; color: var(--white); letter-spacing: 0.1em; }
.shopping-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.shopping-opt {
  padding: 20px 24px;
  border-right: 1px solid var(--gray-100);
  border-bottom: 1px solid var(--gray-100);
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.shopping-opt:nth-child(2n) { border-right: none; }
.shopping-opt:nth-last-child(-n+2) { border-bottom: none; }
.shopping-opt-icon {
  width: 36px;
  height: 36px;
  background: var(--orange-light);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.shopping-opt-icon svg { width: 30px; height: 30px; color: var(--orange); }
.shopping-opt h4 { font-size: 0.82rem; color: var(--dark); letter-spacing: 0.04em; }
.shopping-opt p { font-size: 0.75rem; color: var(--gray-600); font-weight: 400; text-transform: none; letter-spacing: 0; line-height: 1.4; }

/* Payments card */
.payments-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 20px 28px;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.payments-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gray-400);
  white-space: nowrap;
}
.payment-chips {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.payment-chip {
  background: var(--gray-100);
  border-radius: 6px;
  padding: 5px 12px;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--dark);
  letter-spacing: 0.02em;
}

/* ─── RIGHT COLUMN: FORM ─── */
.contact-form-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1px solid rgba(0,0,0,0.04);
  position: sticky;
  top: 96px;
}
.form-card-header {
  background: var(--green-700);
  padding: 28px 36px;
}
.form-card-header h2 {
  font-size: 1.4rem;
  color: var(--white);
  margin-bottom: 6px;
}
.form-card-header p {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.65);
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.5;
}
.form-card-body { padding: 32px 36px; }

.form-group { margin-bottom: 16px; }
.form-group label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--dark);
  margin-bottom: 7px;
}
.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  padding: 12px 16px;
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius);
  font-family: 'Montserrat', sans-serif;
  font-size: 0.9rem;
  color: var(--dark);
  transition: border-color 0.2s, box-shadow 0.2s;
  background: var(--gray-100);
  outline: none;
}
.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  border-color: var(--green-700);
  background: var(--white);
  box-shadow: 0 0 0 3px rgba(35,155,43,0.1);
}
.form-group textarea { resize: vertical; min-height: 110px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

.submit-btn {
  width: 100%;
  justify-content: center;
  padding: 16px 32px;
  font-size: 0.95rem;
  margin-top: 8px;
  position: relative;
  overflow: hidden;
}
.submit-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
  transform: translateX(-100%);
  transition: transform 0.5s;
}
.submit-btn:hover::after { transform: translateX(100%); }

.form-note {
  text-align: center;
  font-size: 0.75rem;
  color: var(--gray-400);
  margin-top: 12px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* ─── TRUST & SOCIAL PROOF ─── */

/* Review prompt */
.review-stars { display: flex; gap: 4px; margin-bottom: 6px; }


/* ─── LOCATION-SPECIFIC CONTENT ─── */
.location-section {
  padding: 88px 0;
  background: var(--gray-100);
}
.location-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: start;
}

/* Team card */
.team-intro {
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.04);
}
.team-img {
  background: var(--gray-100);
  position: relative;
  overflow: hidden;
}
.team-img img { width: 100%; height: auto; display: block; }
.team-body { padding: 28px 32px; }
.team-body h3 { font-size: 1.1rem; color: var(--dark); margin-bottom: 10px; }
.team-body p { font-size: 0.875rem; color: var(--gray-600); line-height: 1.65; font-weight: 400; text-transform: none; letter-spacing: 0; }
.contact-socials {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--gray-200);
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.contact-socials a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  background: var(--gray-100);
  border: 1px solid var(--gray-200);
  border-radius: 999px;
  color: var(--dark);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-decoration: none;
  transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
}
.contact-socials a:hover {
  background: var(--green-700);
  border-color: var(--green-700);
  color: var(--white);
  transform: translateY(-1px);
}
.contact-socials svg { width: 16px; height: 16px; flex-shrink: 0; }

/* Service area + guarantees */
.local-cards { display: flex; flex-direction: column; gap: 20px; }
.guarantee-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 24px 28px;
  box-shadow: var(--shadow-sm);
  border: 1px solid rgba(0,0,0,0.04);
  display: flex;
  gap: 16px;
  align-items: flex-start;
}
.guarantee-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.guarantee-icon.green {  }
.guarantee-icon.orange {  }
.guarantee-icon.green svg { width: 28px; height: 28px; color: var(--green-700); }
.guarantee-icon.orange svg { width: 28px; height: 28px; color: var(--green-700); }
.guarantee-card h4 { font-size: 0.95rem; color: var(--dark); margin-bottom: 4px; letter-spacing: 0.02em; }
.guarantee-card p { font-size: 0.82rem; color: var(--gray-600); font-weight: 400; text-transform: none; letter-spacing: 0; line-height: 1.55; }

/* Service zones */
.zone-pills-wrap { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.zone-tag {
  background: var(--gray-100);
  color: var(--green-700);
  border-radius: 50px;
  padding: 5px 14px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.map-detail-row:last-of-type { margin-bottom: 28px; }

/* ─── CTA SECTION ─── */
.cta-section {
  padding: 88px 0;
  background: linear-gradient(135deg, var(--dark) 0%, var(--dark-800) 50%, var(--green-900) 100%);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.cta-section::before {
  content: '';
  position: absolute;
  inset: 0;
}
.cta-inner { position: relative; z-index: 2; }
.cta-section h2 { font-size: clamp(1.9rem, 3vw, 2.8rem); color: var(--white); margin-bottom: 14px; }
.cta-section p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.65);
  max-width: 520px;
  margin: 0 auto 36px;
  line-height: 1.75;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}
.cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.cta-pulse {
  animation: pulse 2.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(35,155,43,0); }
  50% { box-shadow: 0 0 0 10px rgba(35,155,43,0.18); }
}

/* ─── RESPONSIVE ─── */
@media (max-width: 1024px) {
  .contact-grid { grid-template-columns: 1fr; }
  .contact-form-card { position: static; }
      }
@media (max-width: 768px) {
    .location-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  .form-card-body { padding: 24px 20px; }
  .form-card-header { padding: 22px 20px; }
    .shopping-options { grid-template-columns: 1fr; }
  .shopping-opt:nth-child(2n) { border-right: none; }
  .shopping-opt { border-right: none; }
}
@media (max-width: 480px) {
    }
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Queen Creek, Arizona</div>
      <h1>Let's Build Your <em>Dream Yard</em></h1>
      <p>Stop by our showroom, call or text us, or fill out the form below. We respond same day and deliver next day — no runaround, no wait music.</p>
      <div class="page-hero-btns">
        <a href="tel:4807393854" class="btn btn-primary">Call or Text Us Now <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91A16 16 0 0 0 14 15.82l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></a>
        <a href="#contact-form" class="btn btn-outline">Send Us a Message</a>
      </div>
    </div>
  </div>
</section>


<!-- ═══ 2. CONTACT INFORMATION + FORM ═══ -->
<section class="contact-main" id="contact-form">
  <div class="container">
    <div class="section-header" style="margin-bottom:48px;">
      <div class="section-label">Get In Touch</div>
      <h2>Contact Information</h2>
      <p>Multiple ways to reach us — use whatever's easiest for you.</p>
    </div>
    <div class="contact-grid">

      <!-- Left: All contact details -->
      <div class="contact-info-col">

        <!-- Core contact details -->
        <div class="contact-details-card">
          <div class="contact-details-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <h3>Contact Details</h3>
          </div>
          <div class="contact-details-body">
            <a href="tel:4807393854" class="contact-row">
              <div class="contact-row-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91A16 16 0 0 0 14 15.82l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div class="contact-row-text">
                <span class="contact-row-label">Call or Text</span>
                <span class="contact-row-value">480-739-3854<span>Same-day response guaranteed</span></span>
              </div>
            </a>
            <a href="mailto:contact@azturfsuppliers.com" class="contact-row">
              <div class="contact-row-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div class="contact-row-text">
                <span class="contact-row-label">Email</span>
                <span class="contact-row-value">contact@azturfsuppliers.com</span>
              </div>
            </a>
            <div class="contact-row" data-reveal>
              <div class="contact-row-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div class="contact-row-text">
                <span class="contact-row-label">Showroom Address</span>
                <span class="contact-row-value">18607 E San Tan Blvd<span>Queen Creek, AZ 85142</span></span>
              </div>
            </div>
            <div class="contact-row" data-reveal>
              <div class="contact-row-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="contact-row-text">
                <span class="contact-row-label">Hours</span>
                <span class="contact-row-value">Mon–Fri: 7:00 AM – 3:00 PM<span>Sat–Sun: Closed</span></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Shopping options -->
        <div class="shopping-card">
          <div class="shopping-card-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <h3>Shopping Options</h3>
          </div>
          <div class="shopping-options">
            <div class="shopping-opt" data-reveal>
              <div class="shopping-opt-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <h4>15-Min In-Store Pickup</h4>
              <p>Drive up, we load your trailer in 15 minutes or less.</p>
            </div>
            <div class="shopping-opt" data-reveal>
              <div class="shopping-opt-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </div>
              <h4>Next-Day Delivery</h4>
              <p>Guaranteed delivery to your home or job site.</p>
            </div>
            <div class="shopping-opt" data-reveal>
              <div class="shopping-opt-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </div>
              <h4>Nationwide Shipping</h4>
              <p>We ship turf and accessories across the country.</p>
            </div>
            <div class="shopping-opt" data-reveal>
              <div class="shopping-opt-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              </div>
              <h4>Appointment Available</h4>
              <p>Book a one-on-one showroom consultation anytime.</p>
            </div>
          </div>
        </div>

        <!-- Accepted payments -->
        <div class="payments-card">
          <span class="payments-label">Accepted Payments</span>
          <div class="payment-chips">
            <span class="payment-chip">Cash</span>
            <span class="payment-chip">Check</span>
            <span class="payment-chip">Visa</span>
            <span class="payment-chip">Mastercard</span>
            <span class="payment-chip">Amex</span>
            <span class="payment-chip">Zelle</span>
          </div>
        </div>

      </div>

      <!-- Right: Contact Form -->
      <div class="contact-form-card">
        <div class="form-card-header">
          <h2>Send Us a Message</h2>
          <p>We'll get back to you same day. For a faster response, call or text 480-739-3854.</p>
        </div>
        <div class="form-card-body">
          <form id="contact-form" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="firstName">First Name</label>
                <input id="firstName" name="firstName" type="text" placeholder="John" required>
              </div>
              <div class="form-group">
                <label for="lastName">Last Name</label>
                <input id="lastName" name="lastName" type="text" placeholder="Smith">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" placeholder="john@example.com" required>
              </div>
              <div class="form-group">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" placeholder="(480) 739-3854">
              </div>
            </div>
            <div class="form-group">
              <label for="role">I Am A...</label>
              <select id="role" name="role">
                <option value="">Select one</option>
                <option>Homeowner</option>
                <option>Contractor / Landscaper</option>
                <option>Pool Builder</option>
                <option>Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message">How Can We Help?</label>
              <textarea id="message" name="message" placeholder="Tell us about your project — approximate square footage, product interest, timeline, etc."></textarea>
            </div>
            <div id="form-status" style="display:none;margin-bottom:12px;padding:12px 16px;border-radius:8px;font-size:0.875rem;font-weight:600;"></div>
            <button type="submit" class="btn btn-primary submit-btn cta-pulse" id="submit-btn">
              Send Message
