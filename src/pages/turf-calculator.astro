---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Turf Layout Calculator | AZ Turf Suppliers — Queen Creek, AZ">
<style is:global>
/* ─── CALCULATOR SPECIFIC STYLES ─── */
  
  .calc-section {
    padding: 88px 0;
    background: var(--gray-100);
  }

  /* Input Panel */
  .input-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-end;
    margin-bottom: 40px;
    padding: 32px 36px;
  }
  
  @media (max-width: 768px) {
    .input-panel {
      flex-direction: column;
      align-items: stretch;
      padding: 24px 20px;
    }
  }

  .calc-inputs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    flex: 1;
  }

  .calc-inputs-row .form-group {
    margin-bottom: 0;
    flex: 1;
    min-width: 140px;
  }
  
  .calc-inputs-row .form-group input,
  .calc-inputs-row .form-group select {
    font-weight: 600;
  }

  .checkbox-group {
    display: flex;
    gap: 16px;
    align-items: center;
    height: 46px; /* Match input height */
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    color: var(--dark);
  }

  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--green-700);
    cursor: pointer;
  }

  .orientation-icon {
    font-size: 1rem;
    color: var(--gray-400);
    line-height: 1;
  }

  /* Results */
  .results-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .option-card {
    padding: 0; /* Override default card padding to use internal grid */
    overflow: hidden;
  }

  .option-card.best-option {
    border-color: var(--orange);
    box-shadow: 0 0 0 2px var(--orange), var(--shadow-md);
  }

  .option-header {
    padding: 16px 28px;
    background: var(--gray-100);
    border-bottom: 1px solid var(--gray-200);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .option-header h2 {
    font-size: 1.1rem;
    margin-bottom: 0;
    color: var(--dark);
    letter-spacing: 0.02em;
  }

  .best-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--orange);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .best-badge::before { content: '★'; }

  .option-body {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 0;
  }

  @media (max-width: 900px) {
    .option-body { grid-template-columns: 1fr; }
  }

  /* Stats Column */
  .stats-col {
    padding: 28px;
    border-right: 1px solid var(--gray-200);
    background: var(--white);
  }

  @media (max-width: 900px) {
    .stats-col { border-right: none; border-bottom: 1px solid var(--gray-200); }
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 8px 0;
    font-size: 0.85rem;
  }

  .stat-row + .stat-row { border-top: 1px solid var(--gray-100); }

  .stat-label {
    color: var(--gray-600);
    font-weight: 500;
  }

  .stat-value {
    font-weight: 700;
    font-size: 0.9rem;
    text-align: right;
    color: var(--dark);
  }

  .stat-value.zero { color: var(--green-700); }
  .stat-value.has-waste { color: #e11d48; } /* Red for waste */

  .stat-section-title {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dark);
    padding: 16px 0 6px;
    margin-top: 12px;
    border-top: 2px solid var(--dark);
  }

  .stat-section-title:first-child { border-top: none; margin-top: 0; padding-top: 0; }

  .roll-detail {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--gray-600);
    line-height: 1.7;
    padding: 8px 0;
    font-family: 'Montserrat', sans-serif; /* Keep site font consistent */
  }

  .infill-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 0.85rem;
  }

  .infill-name {
    font-weight: 600;
    color: var(--green-700);
  }

  .infill-value {
    font-weight: 700;
  }

  /* Diagram Column */
  .diagram-col {
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 340px;
    background: #fbfbfb;
  }

  .diagram-col canvas {
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.06));
  }

  .diagram-legend {
    display: flex;
    gap: 20px;
    margin-top: 24px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gray-600);
    flex-wrap: wrap;
    justify-content: center;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
  }

  .legend-line {
    width: 16px;
    height: 3px;
    border-radius: 2px;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--gray-600);
    font-size: 1rem;
    font-weight: 500;
  }

  .empty-state .icon { 
    width: 48px; 
    height: 48px;

    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }
  
  .empty-state .icon svg {
    width: 24px;
    height: 24px;
  }

  /* Result card entry animation */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">Interactive Tool</div>
      <h1>Turf Layout <em>Calculator</em></h1>
      <p>Enter your project dimensions to automatically calculate optimal roll cuts, minimize waste, and estimate infill requirements.</p>
    </div>
  </div>
</section>

<!-- ═══ CALCULATOR TOOL ═══ -->
<section class="calc-section">
  <div class="container">
    
    <!-- Inputs -->
    <div class="input-panel card" data-reveal>
      <div class="calc-inputs-row">
        <div class="form-group">
          <label>Project Width (ft)</label>
          <input type="number" id="projectWidth" value="25" min="1" step="1">
        </div>
        <div class="form-group">
          <label>Project Length (ft)</label>
          <input type="number" id="projectLength" value="40" min="1" step="1">
        </div>
        <div class="form-group">
          <label>Turf Face Weight</label>
          <select id="turfWeight">
            <option value="2">70–80oz (2 lbs/sqft)</option>
            <option value="2.5">90–100oz (2.5 lbs/sqft)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Orientations</label>
          <div class="checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" id="chkVertical" checked>
              Vertical <span class="orientation-icon">↕</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" id="chkHorizontal" checked>
              Horizontal <span class="orientation-icon">↔</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Results -->
    <div id="results" class="results-container">
      <div class="empty-state card">
        <div class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        Enter project dimensions and click Calculate to view optimized layouts.
      </div>
    </div>
    
  </div>
</section>

<!-- ═══ CTA SECTION ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">Get Started</div>
    <h2>Ready to Order Your Materials?</h2>
    <p>Bring your layout numbers into our Queen Creek showroom or text us directly. We'll pull your inventory and have you loaded up in 15 minutes.</p>
    <div class="cta-btns">
      <a href="tel:4807393854" class="btn btn-primary">Call or Text 480-739-3854 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91A16 16 0 0 0 14 15.82l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></a>
      <a href="/artificial-turf" class="btn btn-outline">Browse Turf Products</a>
    </div>
  </div>
</section>

<!-- Shared Footer -->

<!-- ─── CALCULATOR LOGIC ─── -->
<script>
// Scroll reveal logic
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('revealed');
      revealObserver.unobserve(e.target);
    }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));

// Configuration mapping to match standard inputs
const TURF_CONFIG = {
  '15FT': { rollWidth: 15 }
};

const MAX_ROLL_LENGTH = 100;
const BAG_WEIGHT = 50; // lbs

function computeLayout(projW, projL, rollW, orientation) {
  let coverDim, stripDim;
  if (orientation === 'width') {
    coverDim = projW;
    stripDim = projL;
  } else {
    coverDim = projL;
    stripDim = projW;
  }

  const installedArea = projW * projL;
  const numFullStrips = Math.floor(coverDim / rollW);
  const remainder = coverDim - numFullStrips * rollW;

  // Full strips
  const rollsPerFullStrip = Math.ceil(stripDim / MAX_ROLL_LENGTH);
  const totalFullRolls = numFullStrips * rollsPerFullStrip;
  const fullStripPurchased = numFullStrips * rollW * stripDim;
  const fullStripHeadSeams = numFullStrips * (rollsPerFullStrip - 1);

  const fullRollLengths = [];
  for (let i = 0; i < rollsPerFullStrip; i++) {
    const len = (i < rollsPerFullStrip - 1) ? MAX_ROLL_LENGTH : (stripDim - (rollsPerFullStrip - 1) * MAX_ROLL_LENGTH);
    fullRollLengths.push(len);
  }

  // Remainder logic
  let planType, remainderPurchased = 0, remainderHeadSeams = 0, remainderRolls = 0;
  let remainderRollDesc = '';
  let remainderPieces = [];

  if (remainder === 0) {
    planType = 'Exact fit';
  } else {
    const piecesPerRoll = Math.floor(rollW / remainder);

    if (piecesPerRoll >= 2) {
      const rollLen = Math.ceil(stripDim / 2);

      if (rollLen <= MAX_ROLL_LENGTH) {
        remainderRolls = 1;
        remainderPurchased = rollW * rollLen;
        remainderHeadSeams = 1;
        planType = 'Two-part remainder (1 head seam)';
        remainderRollDesc = `1 × ${rollW}'×${rollLen}' split → 2 × ${remainder}'×${rollLen}' joined`;
        remainderPieces.push({ w: remainder, l: rollLen });
        remainderPieces.push({ w: remainder, l: stripDim - rollLen });
      } else {
        const totalPiecesNeeded = Math.ceil(stripDim / MAX_ROLL_LENGTH);
        remainderRolls = Math.ceil(totalPiecesNeeded / 2);
        const coveredByFullRolls = (remainderRolls - 1) * 2 * MAX_ROLL_LENGTH;
        const leftover = stripDim - coveredByFullRolls;
        const lastRollPieces = totalPiecesNeeded - (remainderRolls - 1) * 2;
        const lastRollLen = Math.ceil(leftover / lastRollPieces);

        remainderPurchased = (remainderRolls - 1) * rollW * MAX_ROLL_LENGTH + rollW * lastRollLen;
        remainderHeadSeams = totalPiecesNeeded - 1;
        planType = `Split remainder (${totalPiecesNeeded}-part, ${remainderHeadSeams} head seams)`;

        const descs = [];
        if (remainderRolls - 1 > 0) descs.push(`${remainderRolls - 1} × ${rollW}'×${MAX_ROLL_LENGTH}'`);
        descs.push(`1 × ${rollW}'×${lastRollLen}'`);
        remainderRollDesc = `${descs.join(' + ')} split for ${remainder}ft remainder`;

        for (let i = 0; i < totalPiecesNeeded; i++) {
          const fromFullRolls = (remainderRolls - 1) * 2;
          const pl = (i < fromFullRolls) ? MAX_ROLL_LENGTH : lastRollLen;
          remainderPieces.push({ w: remainder, l: pl });
        }
      }
    } else {
      planType = 'No head seam (trim)';
      const remRollsCount = Math.ceil(stripDim / MAX_ROLL_LENGTH);
      remainderRolls = remRollsCount;
      remainderPurchased = rollW * stripDim;
      remainderHeadSeams = remRollsCount - 1;
      if (remRollsCount === 1) {
        remainderRollDesc = `1 × ${rollW}'×${stripDim}' cut to ${remainder}ft`;
      } else {
        const lastLen = stripDim - (remRollsCount - 1) * MAX_ROLL_LENGTH;
        remainderRollDesc = `${remRollsCount} rolls (${rollW}'×${MAX_ROLL_LENGTH}'${lastLen !== MAX_ROLL_LENGTH ? ` + ${rollW}'×${lastLen}'` : ''}) trimmed to ${remainder}ft wide`;
      }
      for (let i = 0; i < remRollsCount; i++) {
        const pl = (i < remRollsCount - 1) ? MAX_ROLL_LENGTH : (stripDim - (remRollsCount - 1) * MAX_ROLL_LENGTH);
        remainderPieces.push({ w: remainder, l: pl });
      }
    }
  }

  const totalPurchased = fullStripPurchased + remainderPurchased;
  const waste = totalPurchased - installedArea;
  const totalStrips = numFullStrips + (remainder > 0 ? 1 : 0);
  const sideSeams = totalStrips > 0 ? totalStrips - 1 : 0;
  const headSeams = fullStripHeadSeams + remainderHeadSeams;
  const totalSeams = sideSeams + headSeams;

  const rollSummary = [];
  if (numFullStrips > 0) {
    if (rollsPerFullStrip === 1) {
      rollSummary.push(`${numFullStrips} × ${rollW}'×${stripDim}' full rolls`);
    } else {
      rollSummary.push(`${numFullStrips} strips × ${rollsPerFullStrip} rolls ea. (${rollW}'×${fullRollLengths.join('\' + ')})`);
    }
  }
  if (remainder > 0) {
    rollSummary.push(remainderRollDesc);
  }

  return {
    orientation,
    orientationLabel: orientation === 'width' ? `Across Width (Strips along length)` : `Across Length (Strips along width)`,
    planType, projW, projL, rollW, coverDim, stripDim,
    numFullStrips, remainder, rollsPerFullStrip, fullRollLengths, totalFullRolls, fullStripPurchased,
    remainderRolls, remainderPurchased, remainderPieces,
    installedArea, totalPurchased, waste,
    sideSeams, headSeams, totalSeams, rollSummary,
    totalRolls: totalFullRolls + remainderRolls,
  };
}

function computeInfill(installedArea, rate) {
  return Math.ceil((installedArea * rate) / BAG_WEIGHT);
}

function calculate() {
  const projW = parseInt(document.getElementById('projectWidth').value) || 0;
  const projL = parseInt(document.getElementById('projectLength').value) || 0;
  const turfKey = '15FT';
  const infillRate = parseFloat(document.getElementById('turfWeight').value) || 2;
  const doVert = document.getElementById('chkVertical').checked;
  const doHoriz = document.getElementById('chkHorizontal').checked;

  if (projW <= 0 || projL <= 0) return;
  const config = TURF_CONFIG[turfKey];
  if (!config) return;

  const layouts = [];
  if (doVert)  layouts.push(computeLayout(projW, projL, config.rollWidth, 'width'));
  if (doHoriz) layouts.push(computeLayout(projW, projL, config.rollWidth, 'length'));

  const container = document.getElementById('results');

  if (layouts.length === 0) {
    container.innerHTML = '<div class="empty-state card"><div class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg></div>Select at least one orientation.</div>';
    return;
  }

  let bestIdx = 0;
  for (let i = 1; i < layouts.length; i++) {
    const curr = layouts[i], best = layouts[bestIdx];
    if (curr.waste < best.waste || (curr.waste === best.waste && curr.totalSeams < best.totalSeams)) {
      bestIdx = i;
    }
  }

  container.innerHTML = '';

  layouts.forEach((layout, idx) => {
    const isBest = idx === bestIdx && layouts.length > 1;
    const infill = computeInfill(layout.installedArea, infillRate);
    const card = buildOptionCard(layout, infill, idx + 1, isBest, config);
    // Add subtle fade up entry animation
    card.style.animation = `fadeUp 0.4s ease forwards ${idx * 0.1}s`;
    card.style.opacity = '0';
    container.appendChild(card);
  });
}

function buildOptionCard(layout, infill, optNum, isBest, config) {
  const card = document.createElement('div');
  card.className = 'option-card card' + (isBest ? ' best-option' : '');

  const header = document.createElement('div');
  header.className = 'option-header';
  header.innerHTML = `
    <h2>Option ${optNum}: ${layout.orientationLabel}</h2>
    ${isBest ? '<span class="best-badge">Lowest Waste</span>' : ''}
  `;
  card.appendChild(header);

  const body = document.createElement('div');
  body.className = 'option-body';

  const stats = document.createElement('div');
  stats.className = 'stats-col';

  const addSection = (title) => {
    const el = document.createElement('div');
    el.className = 'stat-section-title';
    el.textContent = title;
    stats.appendChild(el);
  };

  const addStat = (label, value, cls) => {
    const row = document.createElement('div');
    row.className = 'stat-row';
    row.innerHTML = `<span class="stat-label">${label}</span><span class="stat-value ${cls || ''}">${value}</span>`;
    stats.appendChild(row);
  };

  addSection('Layout Overview');
  addStat('Plan Type', layout.planType);
  addStat('Total Installed Area', `${layout.installedArea.toLocaleString()} sq ft`);
  addStat('Total Material Needed', `${layout.totalPurchased.toLocaleString()} sq ft`);
  addStat('Estimated Waste', `${layout.waste.toLocaleString()} sq ft`, layout.waste === 0 ? 'zero' : 'has-waste');

  addSection('Seaming details');
  addStat('Side Seams', layout.sideSeams);
  addStat('Head Seams', layout.headSeams);
  addStat('Total Seams', layout.totalSeams);

  addSection(`Rolls Needed (${config.rollWidth}ft Wide)`);
  const rollDetail = document.createElement('div');
  rollDetail.className = 'roll-detail';
  rollDetail.innerHTML = layout.rollSummary.join('<br>');
  stats.appendChild(rollDetail);
  addStat('Total Rolls Count', layout.totalRolls);

  addSection('Recommended Infill');
  const row = document.createElement('div');
  row.className = 'infill-row';
  row.innerHTML = `<span class="infill-name">Infill (50lb bags)</span><span class="infill-value">${infill.toLocaleString()} bags</span>`;
  stats.appendChild(row);

  body.appendChild(stats);

  const diagCol = document.createElement('div');
  diagCol.className = 'diagram-col';

  const canvas = document.createElement('canvas');
  diagCol.appendChild(canvas);

  const legend = document.createElement('div');
  legend.className = 'diagram-legend';
  legend.innerHTML = `
    <span class="legend-item"><span class="legend-swatch" style="background:#239B2B;"></span> Turf</span>
    <span class="legend-item"><span class="legend-swatch" style="background:#ef4444;"></span> Waste</span>
    <span class="legend-item"><span class="legend-line" style="background:#1a1a1a;"></span> Seams</span>
    <span class="legend-item"><span style="font-size:14px; color:var(--dark);">↕</span> Grain Direction</span>
  `;
  diagCol.appendChild(legend);

  body.appendChild(diagCol);
  card.appendChild(body);

  requestAnimationFrame(() => drawDiagram(canvas, layout));

  return card;
}

function drawDiagram(canvas, layout) {
  const dpr = window.devicePixelRatio || 1;
  const maxW = canvas.parentElement.clientWidth - 40;
  const maxH = 400;
  const padding = 40;
  const labelSpace = 24;

  const projW = layout.projW;
  const projL = layout.projL;

  const availW = maxW - padding * 2 - labelSpace;
  const availH = maxH - padding * 2 - labelSpace;
  const scale = Math.min(availW / projW, availH / projL);

  const drawW = projW * scale;
  const drawH = projL * scale;

  const cw = drawW + padding * 2 + labelSpace;
  const ch = drawH + padding * 2 + labelSpace;

  canvas.width = cw * dpr;
  canvas.height = ch * dpr;
  canvas.style.width = cw + 'px';
  canvas.style.height = ch + 'px';

  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);

  ctx.fillStyle = '#fbfbfb';
  ctx.fillRect(0, 0, cw, ch);

  const ox = padding + labelSpace;
  const oy = padding;

  ctx.strokeStyle = '#1a1a1a';
  ctx.lineWidth = 1.5;
  ctx.strokeRect(ox, oy, drawW, drawH);

  ctx.fillStyle = '#1a1a1a';
  ctx.font = '600 12px "Montserrat", sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText(`${projW} ft`, ox + drawW / 2, oy - 12);

  ctx.save();
  ctx.translate(ox - 14, oy + drawH / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText(`${projL} ft`, 0, 0);
  ctx.restore();

  const rollW = layout.rollW;
  const coverDim = layout.coverDim;
  const stripDim = layout.stripDim;
  const numFull = layout.numFullStrips;
  const rem = layout.remainder;
  const isVert = layout.orientation === 'width';

  const mapX = (px) => ox + px * scale;
  const mapY = (py) => oy + py * scale;

  // AZ Turf Colors
  const turfColors = ['#239B2B', '#1a7d22']; // Green 700 and darker shade
  const wasteColor = '#ef4444'; // Red for waste visibility
  const seamColor = '#1a1a1a'; // Dark for contrast against green turf fill

  for (let i = 0; i < numFull; i++) {
    const colorIdx = i % 2;
    if (isVert) {
      const x = i * rollW;
      ctx.fillStyle = turfColors[colorIdx];
      ctx.fillRect(mapX(x), mapY(0), rollW * scale, stripDim * scale);
      ctx.strokeStyle = 'rgba(0,0,0,0.1)';
      ctx.lineWidth = 1;
      ctx.strokeRect(mapX(x), mapY(0), rollW * scale, stripDim * scale);
    } else {
      const y = i * rollW;
      ctx.fillStyle = turfColors[colorIdx];
      ctx.fillRect(mapX(0), mapY(y), stripDim * scale, rollW * scale);
      ctx.strokeStyle = 'rgba(0,0,0,0.1)';
      ctx.lineWidth = 1;
      ctx.strokeRect(mapX(0), mapY(y), stripDim * scale, rollW * scale);
    }
  }

  if (rem > 0) {
    const remColorIdx = numFull % 2;
    if (isVert) {
      const x = numFull * rollW;
      ctx.fillStyle = turfColors[remColorIdx];
      ctx.fillRect(mapX(x), mapY(0), rem * scale, stripDim * scale);
      if (layout.planType.includes('trim')) {
        ctx.fillStyle = wasteColor;
        ctx.globalAlpha = 0.4;
        ctx.fillRect(mapX(x + rem), mapY(0), (rollW - rem) * scale, stripDim * scale);
        ctx.globalAlpha = 1;
      }
    } else {
      const y = numFull * rollW;
      ctx.fillStyle = turfColors[remColorIdx];
      ctx.fillRect(mapX(0), mapY(y), stripDim * scale, rem * scale);
      if (layout.planType.includes('trim')) {
        ctx.fillStyle = wasteColor;
        ctx.globalAlpha = 0.4;
        ctx.fillRect(mapX(0), mapY(y + rem), stripDim * scale, (rollW - rem) * scale);
        ctx.globalAlpha = 1;
      }
    }
  }

  ctx.strokeStyle = seamColor;
  ctx.lineWidth = 2;
  for (let i = 1; i <= numFull + (rem > 0 ? 0 : -1); i++) {
    if (i > numFull) break;
    if (isVert) {
      const x = mapX(i * rollW);
      ctx.beginPath();
      ctx.moveTo(x, mapY(0));
      ctx.lineTo(x, mapY(stripDim));
      ctx.stroke();
    } else {
      const y = mapY(i * rollW);
      ctx.beginPath();
      ctx.moveTo(mapX(0), y);
      ctx.lineTo(mapX(stripDim), y);
      ctx.stroke();
    }
  }

  if (layout.rollsPerFullStrip > 1) {
    ctx.strokeStyle = seamColor;
    ctx.lineWidth = 2;
    ctx.setLineDash([6, 4]);
    for (let r = 1; r < layout.rollsPerFullStrip; r++) {
      const seamPos = r * MAX_ROLL_LENGTH;
      if (seamPos >= stripDim) break;
      if (isVert) {
        const y = mapY(seamPos);
        ctx.beginPath();
        ctx.moveTo(mapX(0), y);
        ctx.lineTo(mapX(numFull * rollW), y);
        ctx.stroke();
      } else {
        const x = mapX(seamPos);
        ctx.beginPath();
        ctx.moveTo(x, mapY(0));
        ctx.lineTo(x, mapY(numFull * rollW));
        ctx.stroke();
      }
    }
    ctx.setLineDash([]);
  }

  if (rem > 0 && layout.remainderPieces.length > 1) {
    ctx.strokeStyle = seamColor;
    ctx.lineWidth = 2;
    ctx.setLineDash([6, 4]);
    let pos = 0;
    for (let i = 0; i < layout.remainderPieces.length - 1; i++) {
      pos += layout.remainderPieces[i].l;
      if (isVert) {
        const y = mapY(pos);
        ctx.beginPath();
        ctx.moveTo(mapX(numFull * rollW), y);
        ctx.lineTo(mapX(numFull * rollW + rem), y);
        ctx.stroke();
      } else {
        const x = mapX(pos);
        ctx.beginPath();
        ctx.moveTo(x, mapY(numFull * rollW));
        ctx.lineTo(x, mapY(numFull * rollW + rem));
        ctx.stroke();
      }
    }
    ctx.setLineDash([]);
  }

  ctx.fillStyle = 'rgba(255,255,255,0.7)';
  ctx.font = '600 14px "Montserrat", sans-serif';
  ctx.textAlign = 'center';

  const stripPixW = rollW * scale;
  if (stripPixW > 28) {
    for (let i = 0; i < numFull; i++) {
      if (isVert) {
        const cx = mapX(i * rollW + rollW / 2);
        const cy = mapY(stripDim / 2);
        ctx.fillText('↕', cx, cy);
      } else {
        const cx = mapX(stripDim / 2);
        const cy = mapY(i * rollW + rollW / 2);
        ctx.fillText('↔', cx, cy);
      }
    }
  }

  ctx.strokeStyle = '#1a1a1a';
  ctx.lineWidth = 2;
  ctx.setLineDash([]);
  ctx.strokeRect(ox, oy, drawW, drawH);

  if (stripPixW > 40 && numFull <= 20) {
    ctx.fillStyle = 'rgba(255,255,255,0.9)';
    ctx.font = '600 10px "Montserrat", sans-serif';
    for (let i = 0; i < Math.min(numFull, 20); i++) {
      if (isVert) {
        const cx = mapX(i * rollW + rollW / 2);
        const cy = mapY(stripDim / 2) - 14;
        ctx.fillText(`${rollW}×${stripDim}`, cx, cy);
      } else {
        const cx = mapX(stripDim / 2);
        const cy = mapY(i * rollW + rollW / 2) - 14;
        ctx.fillText(`${stripDim}×${rollW}`, cx, cy);
      }
    }
    if (rem > 0) {
      const remPixW = rem * scale;
      if (remPixW > 30) {
        if (isVert) {
          ctx.fillText(`${rem}×${stripDim}`, mapX(numFull * rollW + rem / 2), mapY(stripDim / 2) - 14);
        } else {
          ctx.fillText(`${stripDim}×${rem}`, mapX(stripDim / 2), mapY(numFull * rollW + rem / 2) - 14);
        }
      }
    }
  }
}

// Event Listeners for auto calculation
document.querySelectorAll('.input-panel input, .input-panel select').forEach(el => {
  el.addEventListener('input', () => calculate());
  el.addEventListener('change', () => calculate());
});

// Run initially
calculate();
</script>
</Layout>
