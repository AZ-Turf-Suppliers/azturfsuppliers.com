---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import '../styles/header.css';
import '../styles/footer.css';
import '../styles/shared.css';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  // Optional extra JSON-LD blocks (Product, Article, FAQPage, etc.) the
  // page wants to emit. Each will be serialized into its own script tag.
  schema?: object | object[];
  // Trail used to build a BreadcrumbList. Leave undefined on the home page
  // and any page where breadcrumbs are not appropriate (404, thank-you).
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = 'Premium artificial turf and landscaping supplies based in Queen Creek and serving all of Arizona.',
  ogImage = '/media/logo.png',
  ogType = 'website',
  noindex = false,
  schema,
  breadcrumbs,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://azturfsuppliers.com';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageAbsolute = new URL(ogImage, siteUrl).toString();
const isHome = Astro.url.pathname === '/';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#localbusiness`,
  name: site.name,
  image: new URL('/media/logo.png', siteUrl).toString(),
  logo: new URL('/media/logo.png', siteUrl).toString(),
  url: siteUrl,
  telephone: `+1-${site.phone_tel}`,
  email: site.email,
  priceRange: '$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address_street,
    addressLocality: site.address_city,
    addressRegion: site.address_region,
    postalCode: site.address_postal,
    addressCountry: site.address_country,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: site.hours_opens,
    closes: site.hours_closes,
  }],
  sameAs: [site.social_facebook, site.social_instagram],
  areaServed: { '@type': 'State', name: 'Arizona' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: site.name,
  publisher: { '@id': `${siteUrl}/#localbusiness` },
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.url, siteUrl).toString(),
  })),
} : null;

const extraSchemas: object[] = schema
  ? (Array.isArray(schema) ? schema : [schema])
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-595K6QJW');</script>
    <!-- End Google Tag Manager -->

    <!-- Lead attribution capture — records how each visitor reached the site and
         stamps it onto any form they submit (hidden utmcsr/utmcmd/utmccn/utmctr/
         utmgclid inputs).

         Three tiers, best first:
           1. Tagged link  — utm_* / utmcsr-style params on the landing URL.
           2. Ad click ID  — gclid, or gbraid/wbraid (what Google sends instead
              of gclid on iOS when ATT blocks it). A click ID with no explicit
              source/medium is a Google Ads click, so we fill in google / cpc
              rather than leaving the columns blank.
           3. Referrer     — organic search, social, or referral, and (direct)
              when there is no referrer at all.

         First-touch is preserved within a 90-day window, with one exception: a
         tagged visit always upgrades a referrer-inferred record, so an organic
         first visit can never mask a later ad click. -->
    <script is:inline>(function () {
      var KEY = 'az_attribution';
      var MAX_AGE_MS = 90 * 24 * 60 * 60 * 1000; // first-touch window
      var MAP = {
        utmcsr:   ['utmcsr',   'utm_source'],
        utmcmd:   ['utmcmd',   'utm_medium'],
        utmccn:   ['utmccn',   'utm_campaign'],
        utmctr:   ['utmctr',   'utm_term'],
        utmgclid: ['utmgclid', 'gclid'],
      };
      // Google's iOS-privacy click IDs. Prefixed when stored so nobody tries to
      // look one up as a gclid — they are not interchangeable.
      var ALT_CLICK_IDS = ['gbraid', 'wbraid'];

      var SEARCH_ENGINES = {
        'google': 'google', 'bing': 'bing', 'duckduckgo': 'duckduckgo',
        'yahoo': 'yahoo', 'ecosia': 'ecosia', 'brave': 'brave',
        'yandex': 'yandex', 'baidu': 'baidu', 'search.marginalia': 'marginalia',
      };
      var SOCIAL = {
        'facebook': 'facebook', 'instagram': 'instagram', 'linkedin': 'linkedin',
        'pinterest': 'pinterest', 'nextdoor': 'nextdoor', 'youtube': 'youtube',
        'reddit': 'reddit', 'tiktok': 'tiktok', 'twitter': 'twitter',
        'x': 'twitter', 't': 'twitter',
      };

      function readParam(qs, names) {
        for (var i = 0; i < names.length; i++) {
          var v = qs.get(names[i]);
          if (v) return v;
        }
        return '';
      }

      // Tier 1 + 2 — anything on the URL itself.
      function fromUrl(qs) {
        var found = {};
        var any = false;
        Object.keys(MAP).forEach(function (k) {
          var v = readParam(qs, MAP[k]);
          if (v) { found[k] = v; any = true; }
        });
        if (!found.utmgclid) {
          for (var i = 0; i < ALT_CLICK_IDS.length; i++) {
            var v = qs.get(ALT_CLICK_IDS[i]);
            if (v) { found.utmgclid = ALT_CLICK_IDS[i] + ':' + v; any = true; break; }
          }
        }
        if (!any) return null;
        // A click ID is by definition a paid Google click.
        if (found.utmgclid && !found.utmcsr) found.utmcsr = 'google';
        if (found.utmgclid && !found.utmcmd) found.utmcmd = 'cpc';
        found.t = 'tagged';
        return found;
      }

      // Tier 3 — where the browser says they came from.
      function fromReferrer() {
        var ref = document.referrer || '';
        if (!ref) return { utmcsr: '(direct)', utmcmd: '(none)', t: 'inferred' };

        var host = '';
        try { host = new URL(ref).hostname.replace(/^www\./, '').toLowerCase(); } catch (e) {}
        if (!host) return { utmcsr: '(direct)', utmcmd: '(none)', t: 'inferred' };
        // Our own pages — an internal click, not an arrival. Leave the record be.
        if (host === window.location.hostname.replace(/^www\./, '').toLowerCase()) return null;

        var root = host.split('.')[0];
        if (SEARCH_ENGINES[root]) return { utmcsr: SEARCH_ENGINES[root], utmcmd: 'organic', t: 'inferred' };
        if (SOCIAL[root])         return { utmcsr: SOCIAL[root],         utmcmd: 'social',  t: 'inferred' };
        return { utmcsr: host, utmcmd: 'referral', t: 'inferred' };
      }

      function stored() {
        try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; }
      }

      function capture() {
        try {
          var rec = fromUrl(new URLSearchParams(window.location.search)) || fromReferrer();
          if (!rec) return;

          var existing = stored();
          if (existing) {
            var fresh = existing.capturedAt && (Date.now() - existing.capturedAt) < MAX_AGE_MS;
            // Records written before this script gained tiers have no `t` and
            // were always tagged.
            var existingTagged = existing.t !== 'inferred';
            // Keep the first touch, unless a tagged visit is upgrading a guess.
            if (fresh && (existingTagged || rec.t === 'inferred')) return;
          }

          rec.capturedAt = Date.now();
          localStorage.setItem(KEY, JSON.stringify(rec));
        } catch (e) {}
      }

      function fillForms() {
        var data = stored();
        if (!data) return;
        // Never stamp a record that has aged out of the window.
        if (data.capturedAt && (Date.now() - data.capturedAt) >= MAX_AGE_MS) return;
        var names = Object.keys(MAP);
        document.querySelectorAll('form').forEach(function (form) {
          names.forEach(function (n) {
            var input = form.querySelector('input[name="' + n + '"]');
            if (input && !input.value && data[n]) input.value = data[n];
          });
        });
      }

      function run() { capture(); fillForms(); }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
      document.addEventListener('astro:page-load', run);
    })();</script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="msvalidate.01" content="1351D07E955C5D02C038BDC19066EBCA" />
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'}>
    <meta name="theme-color" content="#239B2B">
    <link rel="canonical" href={canonical}>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}>
    <meta property="og:site_name" content="AZ Turf Suppliers">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImageAbsolute}>
    <meta property="og:image:alt" content={title}>
    <meta property="og:locale" content="en_US">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageAbsolute}>
    <meta name="twitter:image:alt" content={title}>

    <!-- DNS prefetch for third-party origins -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com">
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {!isHome && (
      <link rel="preload" as="image" href="/media/natural-series-turf-1.jpg" />
    )}

    {isHome && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
      </>
    )}

    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    {extraSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-595K6QJW"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      function initReveal() {
        const observer = new IntersectionObserver(
          (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('revealed'); observer.unobserve(e.target); } }),
          { threshold: 0.12 }
        );
        document.querySelectorAll('[data-reveal]:not(.revealed)').forEach(el => observer.observe(el));
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
