---
import Icon from './Icon.astro';
import site from '../data/site.json';
const year = new Date().getFullYear();
const mapUrl = `https://maps.google.com/?q=${site.map_query}`;
---

<footer id="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <img src="/media/logo.png" alt={site.name} width="200" height="60" loading="lazy" decoding="async">
        </a>
        <p>Premium artificial turf and landscaping supplies based in {site.address_city} and serving all of Arizona. Your trusted partner for outdoor living.</p>
        <div class="footer-socials">
          <a href={site.social_facebook} target="_blank" rel="noopener" aria-label={`Follow ${site.name} on Facebook`}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href={site.social_instagram} target="_blank" rel="noopener" aria-label={`Follow ${site.name} on Instagram`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h5>Products</h5>
        <a href="/artificial-turf/">Artificial Turf</a>
        <a href="/pavers/">Pavers</a>
        <a href="/natural-stone/">Natural Stone</a>
        <a href="/landscape-lighting/">Landscape Lighting</a>
        <a href="/accessories/">Accessories</a>
      </div>
      <div class="footer-col">
        <h5>Turf Series</h5>
        <a href="/natural-series/">Natural Blend Series</a>
        <a href="/winter-series/">Winter Blend Series</a>
        <a href="/spring-blend/">Spring Blend Series</a>
        <a href="/bermuda-blend/">Bermuda Blend Series</a>
        <a href="/putting-green/">Putting Green</a>
      </div>
      <div class="footer-col">
        <h5>Resources</h5>
        <a href="/turf-calculator/">Turf Calculator</a>
        <a href="/reviews/">Customer Reviews</a>
        <a href="/blog/">Blog</a>
        <a href="/faq/">FAQs</a>
        <a href="/warranty/">Warranty</a>
        <a href="/lead-free/">Lead Free Guarantee</a>
      </div>
      <div class="footer-col">
        <h5>Company</h5>
        <a href="/about/">About Us</a>
        <a href="/contractors/">Contractors</a>
        <a href="/homeowners/">DIY Homeowners</a>
        <a href="/gallery/">Gallery</a>
        <a href="/contact/">Contact</a>
      </div>
      <div class="footer-col footer-col-visit">
        <h5>Visit Us</h5>
        <p class="footer-address">{site.address_street}<br>{site.address_city}, {site.address_region} {site.address_postal}</p>
        <p class="footer-hours">{site.hours_weekday}<br>{site.hours_weekend}</p>
        <a href={`tel:${site.phone_tel}`} class="footer-phone">{site.phone}</a>
        <a href={mapUrl} target="_blank" rel="noopener" class="footer-directions">Get Directions →</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} AZ Turf Suppliers. All Rights Reserved.</span>
      <span>Queen Creek, Arizona</span>
    </div>
  </div>
</footer>

<!-- Mobile-only sticky action bar -->
<div class="mobile-action-bar" aria-label="Quick contact">
  <a href={`sms:${site.phone_sms}`} class="mobile-action-bar-btn mobile-action-bar-btn--text">
    <Icon name="chat" size={20} />
    <span>Text Us</span>
  </a>
  <a href={`tel:${site.phone_tel}`} class="mobile-action-bar-btn mobile-action-bar-btn--call">
    <Icon name="phone" size={20} />
    <span>Call Us</span>
  </a>
</div>
