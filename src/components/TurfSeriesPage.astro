---
import Icon from './Icon.astro';
import Pic from './Pic.astro';
import { renderInline } from '../utils/inline-markdown';

interface Props {
  page: any;
  hydratedCards: any[];
}

const { page, hydratedCards } = Astro.props;

const btnClass = (style: string) => {
  if (style === 'primary') return 'btn btn-primary';
  if (style === 'dark') return 'btn btn-dark';
  return 'btn btn-outline';
};
---

<style is:global set:html={`.page-hero::before { background-image: url("${page.heroImage}") !important; }`} />
<style is:global>
/* ─── SERIES PAGE: INTRO ─── */
.ts-intro { padding: 88px 0 32px; background: var(--white); }
.ts-intro-inner { max-width: 820px; margin: 0 auto; text-align: center; }
.ts-intro h2 { font-size: clamp(1.9rem, 3vw, 2.6rem); margin-bottom: 18px; }
.ts-intro p { font-size: 1rem; color: var(--gray-600); line-height: 1.8; font-weight: 400; text-transform: none; letter-spacing: 0; margin-bottom: 18px; }
.ts-intro p:last-child { margin-bottom: 0; }
.ts-intro a { color: var(--green-700); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--green-700); }
.ts-intro a:hover { color: var(--green-900); border-bottom-color: var(--green-900); }

/* ─── SERIES PAGE: PRODUCTS ─── */
.ts-products { padding: 48px 0 88px; background: var(--white); }
.ts-products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
  max-width: 820px;
  margin: 0 auto;
}
.ts-products-grid--single {
  grid-template-columns: minmax(280px, 420px);
  justify-content: center;
  max-width: 460px;
}

/* ─── KEY FEATURES STRIP ─── */
.ts-features { padding: 64px 0; background: var(--gray-100); }
.ts-features-header { text-align: center; margin-bottom: 40px; }
.ts-features-header .section-label { justify-content: center; }
.ts-features-header h2 { font-size: clamp(1.7rem, 2.5vw, 2.2rem); }
.ts-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; max-width: 1100px; margin: 0 auto; }
.ts-feature { text-align: center; padding: 24px 18px; background: var(--white); border-radius: var(--radius-lg); border: 1px solid var(--gray-200); }
.ts-feature-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; background: var(--green-700); border-radius: 50%; }
.ts-feature-icon svg { width: 26px; height: 26px; color: var(--white); }
.ts-feature h4 { font-size: 0.85rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dark); margin-bottom: 8px; }
.ts-feature p { font-size: 0.82rem; color: var(--gray-600); line-height: 1.6; font-weight: 400; text-transform: none; letter-spacing: 0; }

/* ─── AZ DIFFERENCE (reused from artificial-turf style) ─── */
.ts-difference { padding: 88px 0; position: relative; overflow: hidden; }
.ts-difference::before { content: ''; position: absolute; inset: 0; background: url('/media/winter-blend-2.jpg') center / cover no-repeat; z-index: 0; }
.ts-difference::after  { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.7); z-index: 1; }
.ts-diff-header { text-align: center; margin-bottom: 40px; position: relative; z-index: 2; }
.ts-diff-header .section-label { justify-content: center; color: var(--green-700); }
.ts-diff-header .section-label::before { background: var(--green-700); }
.ts-diff-header h2 { color: var(--white); font-size: clamp(1.9rem, 3vw, 2.6rem); }
.ts-diff-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; position: relative; z-index: 2; max-width: 1100px; margin: 0 auto; }
.ts-diff-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); padding: 28px 24px; transition: all 0.3s; }
.ts-diff-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-3px); }
.ts-diff-icon { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
.ts-diff-icon svg { width: 26px; height: 26px; color: var(--green-700); }
.ts-diff-card h4 { font-size: 0.92rem; color: var(--white); margin-bottom: 8px; letter-spacing: 0.04em; }
.ts-diff-card p  { font-size: 0.85rem; color: rgba(255,255,255,0.62); line-height: 1.65; font-weight: 400; text-transform: none; letter-spacing: 0; }

/* ─── TURF CARDS (mirror of /artificial-turf) ─── */
.turf-cards-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.turf-card {
  background: var(--white); border-radius: var(--radius-lg); overflow: hidden;
  box-shadow: var(--shadow-sm); border: 1px solid rgba(0,0,0,0.05);
  transition: transform 0.3s, box-shadow 0.3s;
  display: flex; flex-direction: column;
}
.turf-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.turf-card-img {
  position: relative; background: var(--white);
  aspect-ratio: 4/3; overflow: hidden;
  display: flex; align-items: center; justify-content: center; cursor: zoom-in;
}
.turf-card-img img {
  width: 100%; height: 100%; object-fit: contain; padding: 16px;
  transition: transform 0.4s ease;
}
.turf-card:hover .turf-card-img img { transform: scale(1.04); }
.turf-card-mag {
  position: absolute; bottom: 12px; right: 12px;
  width: 36px; height: 36px; background: rgba(0,0,0,0.5); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  z-index: 3; opacity: 0; transition: opacity 0.3s; pointer-events: none;
}
.turf-card:hover .turf-card-mag { opacity: 1; }
.turf-card-mag svg { width: 16px; height: 16px; color: var(--white); }
.turf-card-badge {
  position: absolute; top: 12px; right: 12px;
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--white);
  padding: 4px 10px; border-radius: 20px; white-space: nowrap; z-index: 2;
}
.turf-card-badge--green { background: var(--green-700); }
.turf-card-name {
  background: var(--dark); color: var(--white);
  font-size: 0.9rem; font-weight: 800; letter-spacing: 0.06em;
  text-transform: uppercase; padding: 14px 20px; line-height: 1.2;
}
.turf-card-body { padding: 20px; display: flex; flex-direction: column; flex: 1; gap: 16px; }
.turf-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; }
.turf-spec { display: flex; flex-direction: column; gap: 2px; }
.turf-spec span {
  font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--gray-400);
}
.turf-spec strong { font-size: 0.82rem; font-weight: 700; color: var(--dark); text-transform: none; letter-spacing: 0; }
.turf-card-footer {
  display: flex; flex-direction: column; gap: 10px;
  padding-top: 16px; border-top: 1px solid var(--gray-100); margin-top: auto;
}
.turf-card-footer-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.turf-price { font-size: 1.4rem; font-weight: 900; color: var(--green-700); letter-spacing: -0.02em; line-height: 1; }
.turf-price span {
  font-size: 0.75rem; font-weight: 500; color: var(--gray-400);
  text-transform: uppercase; letter-spacing: 0.06em;
}
.turf-price-roll { margin-top: 4px; font-size: 0.78rem; font-weight: 700; color: var(--gray-600); }
.turf-price-roll span { font-weight: 400; color: var(--gray-400); font-size: 0.72rem; }
.turf-card-btns { display: flex; gap: 8px; }
.turf-card-btns .btn { flex: 1; padding: 10px 16px; font-size: 0.78rem; border-radius: 50px; white-space: nowrap; text-align: center; justify-content: center; }

@media (max-width: 640px) {
  .turf-card-name { font-size: 0.75rem; padding: 10px 14px; }
  .turf-card-body { padding: 14px; gap: 12px; }
  .turf-specs { gap: 6px 10px; }
  .turf-spec span { font-size: 0.58rem; }
  .turf-spec strong { font-size: 0.75rem; }
  .turf-price { font-size: 1.1rem; }
  .turf-card-btns { flex-direction: column; gap: 8px; }
  .turf-card-btns .btn { width: 100%; padding: 10px 14px; font-size: 0.78rem; }
  .turf-card-footer { padding-top: 12px; }
}

/* ─── TURF LIGHTBOX ─── */
.turf-lightbox {
  position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.92);
  display: none; align-items: center; justify-content: center; padding: 40px; cursor: zoom-out;
}
.turf-lightbox.open { display: flex; }
.turf-lightbox img { max-width: 90%; max-height: 85vh; border-radius: var(--radius-lg); object-fit: contain; }
.turf-lightbox-close {
  position: absolute; top: 24px; right: 24px;
  width: 44px; height: 44px; background: rgba(255,255,255,0.1);
  border: none; border-radius: 50%; cursor: pointer;
  display: flex; align-items: center; justify-content: center; transition: background 0.2s;
}
.turf-lightbox-close:hover { background: rgba(255,255,255,0.2); }
.turf-lightbox-close svg { width: 20px; height: 20px; color: var(--white); }

/* ─── BACK LINK ─── */
.ts-back-section { padding: 56px 0; background: var(--white); text-align: center; }
.ts-back-section h3 { font-size: 1.2rem; margin-bottom: 16px; font-weight: 700; }
.ts-back-section p { font-size: 0.92rem; color: var(--gray-600); max-width: 560px; margin: 0 auto 22px; line-height: 1.7; font-weight: 400; text-transform: none; letter-spacing: 0; }
.ts-back-section a { color: var(--green-700); font-weight: 600; }

@media (max-width: 1024px) {
  .ts-features-grid { grid-template-columns: repeat(2, 1fr); }
  .ts-diff-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .ts-intro { padding: 30px 0 16px; }
  .ts-products { padding: 24px 0 30px; }
  .ts-features { padding: 30px 0; }
  .ts-difference { padding: 30px 0; }
  .ts-features-grid { grid-template-columns: 1fr 1fr; gap: 14px; }
  .ts-diff-grid { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .ts-products-grid { grid-template-columns: 1fr; }
  .ts-features-grid { grid-template-columns: 1fr; }
}
</style>

<!-- ═══ PAGE HERO ═══ -->
<section class="page-hero">
  <div class="container">
    <div class="page-hero-content">
      <div class="page-hero-eyebrow">{page.hero.eyebrow}</div>
      <h1 set:html={renderInline(page.hero.heading)} />
      <p>{page.hero.body}</p>
      <div class="page-hero-btns">
        <a href={page.hero.ctaPrimary.link} class="btn btn-primary">{page.hero.ctaPrimary.text} <Icon name="arrow-right" size={16} /></a>
        <a href={page.hero.ctaSecondary.link} class="btn btn-outline">{page.hero.ctaSecondary.text}</a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ STAT BAR ═══ -->
<div class="stat-bar">
  <div class="container stat-bar-inner">
    {page.statBar.map((item: any) => (
      <div class="stat-item">
        <div class="stat-num">{item.value}</div>
        <div class="stat-label">{item.label}</div>
      </div>
    ))}
  </div>
</div>

<!-- ═══ SERIES INTRO ═══ -->
<section class="ts-intro">
  <div class="container">
    <div class="ts-intro-inner" data-reveal>
      <div class="section-label centered">{page.intro.label}</div>
      <h2 set:html={renderInline(page.intro.heading)} />
      {page.intro.body.map((para: string) => (
        <p set:html={renderInline(para)} />
      ))}
    </div>
  </div>
</section>

<!-- ═══ PRODUCT CARDS ═══ -->
<section class="ts-products" id="products">
  <div class="container">
    <div class={`ts-products-grid${hydratedCards.length === 1 ? ' ts-products-grid--single' : ''}`}>
      {hydratedCards.map((card: any) => (
        <div class="turf-card">
          <div class="turf-card-img">
            <div class="turf-card-mag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></div>
            <Pic name={card.image} alt={card.alt} />
            {card.badge && (
              <span class={`turf-card-badge${card.badge.style ? ` turf-card-badge--${card.badge.style}` : ''}`}>{card.badge.text}</span>
            )}
          </div>
          <div class="turf-card-name">{card.name}</div>
          <div class="turf-card-body">
            <div class="turf-specs">
              <div class="turf-spec"><span>Total Weight</span><strong>{card.totalWeight}</strong></div>
              <div class="turf-spec"><span>Pile Height</span><strong>{card.pileHeight}</strong></div>
              <div class="turf-spec"><span>Color</span><strong>{card.color}</strong></div>
              <div class="turf-spec"><span>Roll Width</span><strong>{card.rollWidth}</strong></div>
            </div>
            <div class="turf-card-footer">
              <div class="turf-card-footer-top">
                <div class="turf-price">{card.price} <span>{card.priceUnit}</span></div>
                {card.fullRollPrice && (
                  <div class="turf-price-roll">{card.fullRollPrice} <span>full roll (15' × 100')</span></div>
                )}
              </div>
              <div class="turf-card-btns">
                <a href={card.detailsLink} class="btn btn-dark">More Details</a>
                <a href="/contact/" class="btn btn-primary">Get a Quote</a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ KEY FEATURES ═══ -->
<section class="ts-features">
  <div class="container">
    <div class="ts-features-header" data-reveal>
      <div class="section-label centered">{page.features.label}</div>
      <h2 set:html={renderInline(page.features.heading)} />
    </div>
    <div class="ts-features-grid">
      {page.features.items.map((item: any) => (
        <div class="ts-feature" data-reveal>
          <div class="ts-feature-icon"><Icon name={item.icon as any} size={26} /></div>
          <h4>{item.heading}</h4>
          <p set:html={renderInline(item.body)} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ AZ DIFFERENCE ═══ -->
<section class="ts-difference">
  <div class="container">
    <div class="ts-diff-header" data-reveal>
      <div class="section-label">{page.azDifference.label}</div>
      <h2 set:html={renderInline(page.azDifference.heading)} />
    </div>
    <div class="ts-diff-grid">
      {page.azDifference.items.map((item: any) => (
        <div class="ts-diff-card" data-reveal>
          <div class="ts-diff-icon"><Icon name={item.icon as any} size={26} /></div>
          <h4 set:html={renderInline(item.heading)} />
          <p set:html={renderInline(item.body)} />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ BACK / EXPLORE ═══ -->
<section class="ts-back-section">
  <div class="container">
    <h3 set:html={renderInline(page.crossSell.heading)} />
    <p set:html={renderInline(page.crossSell.body)} />
    <a href="/artificial-turf/" class="btn btn-outline">View All Turf Series <Icon name="arrow-right" size={16} /></a>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="section-label centered inverted">{page.cta.label}</div>
    <h2 set:html={renderInline(page.cta.heading)} />
    <p set:html={renderInline(page.cta.body)} />
    <div class="cta-btns">
      {page.cta.buttons.map((btn: any) => (
        <a href={btn.link} class={btnClass(btn.style)}>
          {btn.text}
          {btn.style === 'primary' && <Icon name="phone" size={16} />}
        </a>
      ))}
    </div>
    <p style="margin-top:24px; font-size:0.8rem; color:rgba(255,255,255,0.45);">{page.cta.footnote}</p>
  </div>
</section>

<script>
// Click-to-zoom for product cards on series pages, matching /artificial-turf behavior.
function initTurfSeriesLightbox() {
  document.querySelectorAll('.turf-card-img').forEach(function(cardImg) {
    if ((cardImg as any).__lbBound) return;
    (cardImg as any).__lbBound = true;
    cardImg.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var img = (this as HTMLElement).querySelector('img') as HTMLImageElement | null;
      if (!img) return;
      var lb = document.createElement('div');
      lb.className = 'turf-lightbox open';
      lb.innerHTML = '<button class="turf-lightbox-close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button><img src="' + img.src + '" alt="' + (img.alt || '') + '" loading="lazy" decoding="async">';
      lb.addEventListener('click', function(ev) { if (ev.target === lb || (ev.target as HTMLElement).closest('.turf-lightbox-close')) lb.remove(); });
      document.body.appendChild(lb);
      document.addEventListener('keydown', function handler(ev) { if (ev.key === 'Escape') { lb.remove(); document.removeEventListener('keydown', handler); } });
    });
  });
}
initTurfSeriesLightbox();
document.addEventListener('astro:page-load', initTurfSeriesLightbox);
</script>
