---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import sharp from 'sharp';
import { mediaSrcset } from '../utils/media';

interface Props {
  name: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
  class?: string;
  style?: string;
  id?: string;
  // Display width hint for the generated srcset on public/media images.
  sizes?: string;
}

const {
  name,
  alt,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  width,
  height,
  class: className,
  style,
  id,
  sizes = '(max-width: 800px) 100vw, 50vw',
} = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/media/*.{jpg,jpeg,png}',
  { eager: true }
);

const isExternal = /^https?:\/\//.test(name);
const mod = isExternal ? null : imageModules[`../assets/media/${name}`];
const useFallback = !isExternal && !mod;

const img = mod?.default;

// Images that only exist in public/media (e.g. CMS uploads) skip astro:assets.
// Read their real size so the <img> reserves space, and point srcset at the
// WebP copies integrations/media-variants.mjs generates.
let fallbackWidth = width;
let fallbackHeight = height;
let fallbackSrcset: string | undefined;
if (useFallback) {
  const meta = await sharp(`public/media/${name}`).metadata().catch(() => null);
  if (meta?.width && meta?.height) {
    fallbackWidth ??= meta.width;
    fallbackHeight ??= Math.round(meta.height * (fallbackWidth / meta.width));
  }
  fallbackSrcset = mediaSrcset(`/media/${name}`, meta?.width);
}
const inferredWidth = width ?? img?.width;
const inferredHeight = height ?? (img ? Math.round(img.height * (inferredWidth! / img.width)) : undefined);
---

{isExternal ? (
  <img
    src={name}
    alt={alt}
    loading={loading}
    decoding={decoding}
    class={className}
    style={style}
    id={id}
  />
) : useFallback ? (
  <img
    src={`/media/${name}`}
    srcset={fallbackSrcset}
    sizes={fallbackSrcset ? sizes : undefined}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    width={fallbackWidth}
    height={fallbackHeight}
    class={className}
    style={style}
    id={id}
  />
) : (
  <Image
    src={img!}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    width={inferredWidth}
    height={inferredHeight}
    class={className}
    style={style}
    id={id}
  />
)}
