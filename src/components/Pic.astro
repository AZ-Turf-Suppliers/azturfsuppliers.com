---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  height?: number;
  class?: string;
  style?: string;
  id?: string;
}

const {
  name,
  alt,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  width,
  height,
  class: className,
  style,
  id,
} = Astro.props;

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/media/*.{jpg,jpeg,png}',
  { eager: true }
);

const isExternal = /^https?:\/\//.test(name);
const mod = isExternal ? null : imageModules[`../assets/media/${name}`];

if (!isExternal && !mod) {
  throw new Error(`Pic: image "${name}" not found in src/assets/media/`);
}

const img = mod?.default;
const inferredWidth = width ?? img?.width;
const inferredHeight = height ?? (img ? Math.round(img.height * (inferredWidth! / img.width)) : undefined);
---

{isExternal ? (
  <img
    src={name}
    alt={alt}
    loading={loading}
    decoding={decoding}
    class={className}
    style={style}
    id={id}
  />
) : (
  <Image
    src={img!}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    width={inferredWidth}
    height={inferredHeight}
    class={className}
    style={style}
    id={id}
  />
)}
