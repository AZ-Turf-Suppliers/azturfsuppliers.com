---
interface Props {
  showAllOnReviewsPage?: boolean;
}
const { showAllOnReviewsPage = false } = Astro.props;

const reviews = [
  { initials: 'MS', name: 'Michael S.', text: 'Treated me like family. Very easy to work with and did a great job.' },
  { initials: 'NL', name: 'Nick L.',    text: 'Fast delivery, great prices and customer service. Have been a repeat customer and have never been disappointed!' },
  { initials: 'CS', name: 'Cooper S.',  text: 'The quality of the turf is outstanding — looks and feels just like real grass, but without the maintenance! Great work!' },
  { initials: 'HN', name: 'Heidi N.',   text: "BEST company to work with — SO helpful, very knowledgeable and such high quality turf! Don't waste your time looking anywhere else." },
  { initials: 'CC', name: 'Carlos C.',  text: 'I received amazing service as soon as I stepped in to the office. I felt very welcomed and was met with excellent customer service.' },
  { initials: 'NN', name: 'Nagendra N.',text: 'Great turf at very good price. Kyle is wonderful and gave a nice demo of all the products. Will definitely suggest to friends and family.' },
  { initials: 'JT', name: 'Jen T.',     text: 'Easy to work with, quick turnaround, and the team made sure everything was right before we left. Highly recommend.' },
  { initials: 'RD', name: 'Ryan D.',    text: 'Solid wholesale pricing and the turf has held up perfectly through an Arizona summer. Will order again.' },
  { initials: 'BM', name: 'Brittany M.',text: "We're a DIY family and the team walked us through every step. Felt like a small-town hardware store with pro-grade product." },
];

const list = showAllOnReviewsPage ? reviews : reviews.slice(0, 6);
---

<div class="reviews-summary">
  <div class="reviews-summary-stars">
    {Array.from({ length: 5 }).map(() => (
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z"/></svg>
    ))}
  </div>
  <div class="reviews-summary-text">5.0 <span>· Google Reviews</span></div>
</div>

<div class="reviews-grid">
  {list.map((r) => (
    <article class="review-card">
      <div class="review-stars" aria-label="5 out of 5 stars">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 17.27 6.18 3.73-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z"/></svg>
        ))}
      </div>
      <p class="review-text">{r.text}</p>
      <div class="review-meta">
        <div class="review-avatar" aria-hidden="true">{r.initials}</div>
        <div>
          <div class="review-name">{r.name}</div>
          <div class="review-source">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            Google Review
          </div>
        </div>
      </div>
    </article>
  ))}
</div>
